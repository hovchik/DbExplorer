<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pinned so every SDK (8, 9, 10…) compiles the code the same way. -->
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The installer build passes -p:Version (from the v1.2.0 tag); local builds get this one. -->
    <Version>1.0.0</Version>
    <Product>DB Explorer</Product>
    <Company>DB Explorer</Company>
    <Authors>DB Explorer contributors</Authors>
    <Copyright>Copyright © 2026 Hovhannes</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Desktop app for exploring SQL Server, PostgreSQL and MySQL / MariaDB databases without disturbing them.</Description>
    <RepositoryUrl>https://github.com/hovchik/DbExplorer</RepositoryUrl>
    <!-- The UI is English only: don't ship the other languages' resource folders of the packages. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
