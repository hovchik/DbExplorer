<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:DbExplorer.Desktop.Services"
             x:Class="DbExplorer.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBorderBrush">#33000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentForegroundBrush">#FFFFFFFF</SolidColorBrush>
          <!-- The grip drawn in the middle of every grid splitter, so panes look resizable before hovering -->
          <SolidColorBrush x:Key="AppSplitterGripBrush">#40000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppSubtleBackgroundBrush">#0A000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppPopupBackgroundBrush">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppPopupBorderBrush">#33000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppCodeBackgroundBrush">#F5F5F5</SolidColorBrush>
          <SolidColorBrush x:Key="AppForegroundBrush">#FF000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppHintForegroundBrush">#99000000</SolidColorBrush>
          <!-- Result grid: value colours by type, zebra rows and header shading -->
          <SolidColorBrush x:Key="AppCellTextBrush">#FF1F1F1F</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellNumberBrush">#FF1750EB</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellDateBrush">#FF871094</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellBooleanBrush">#FFB35A00</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellGuidBrush">#FF00796B</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellBinaryBrush">#FF8C6C3E</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellNullBrush">#FF9A9A9A</SolidColorBrush>
          <SolidColorBrush x:Key="AppGridAltRowBrush">#07000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppGridHeaderBrush">#0D000000</SolidColorBrush>
          <!-- An edited, not yet committed value in a result grid -->
          <SolidColorBrush x:Key="AppCellEditedBrush">#40F5A623</SolidColorBrush>
          <!-- A row added in a result grid, and one marked for deletion, not committed yet -->
          <SolidColorBrush x:Key="AppCellNewBrush">#332E7D32</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellDeletedBrush">#33D13438</SolidColorBrush>
          <!-- Objects tab: one colour per object type (ObjectTypeColors) -->
          <SolidColorBrush x:Key="AppObjectTableBrush">#FFC25100</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectViewBrush">#FF2E7D32</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectMaterializedViewBrush">#FF00838F</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectForeignTableBrush">#FF8D6E63</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectProcedureBrush">#FF1565C0</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectFunctionBrush">#FF7B1FA2</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectTriggerBrush">#FFC62828</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectSequenceBrush">#FF8A6800</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectSynonymBrush">#FFAD1457</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectOtherBrush">#FF757575</SolidColorBrush>
          <!-- Execution plan: share of the work (hot ≥ 30%, warm ≥ 10%) and warnings -->
          <SolidColorBrush x:Key="AppPlanHotBrush">#FFD32F2F</SolidColorBrush>
          <SolidColorBrush x:Key="AppPlanWarmBrush">#FFEF6C00</SolidColorBrush>
          <SolidColorBrush x:Key="AppPlanCoolBrush">#FF78909C</SolidColorBrush>
          <SolidColorBrush x:Key="AppPlanWarningBrush">#FFB26A00</SolidColorBrush>
          <!-- App bar (main window toolbar) -->
          <SolidColorBrush x:Key="AppBarBackgroundBrush">#FFF7F8FA</SolidColorBrush>
          <SolidColorBrush x:Key="AppBarGroupBrush">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppBarGroupBorderBrush">#1F000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppToolHoverBrush">#12000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppToolPressedBrush">#21000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppKeycapBrush">#0F000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppStatusConnectedBrush">#FF1F9D55</SolidColorBrush>
          <SolidColorBrush x:Key="AppStatusBusyBrush">#FFD98E04</SolidColorBrush>
          <SolidColorBrush x:Key="AppStatusIdleBrush">#FF9AA0A6</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerBrush">#FFC62828</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerHoverBrush">#1AC62828</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBorderBrush">#22808080</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentForegroundBrush">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppSplitterGripBrush">#55FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppSubtleBackgroundBrush">#14FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppPopupBackgroundBrush">#FF1E1E1E</SolidColorBrush>
          <SolidColorBrush x:Key="AppPopupBorderBrush">#3A3A3A</SolidColorBrush>
          <SolidColorBrush x:Key="AppCodeBackgroundBrush">#FF1E1E1E</SolidColorBrush>
          <SolidColorBrush x:Key="AppForegroundBrush">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppHintForegroundBrush">#B3FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellTextBrush">#FFDCDCDC</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellNumberBrush">#FF2AACB8</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellDateBrush">#FFC77DBB</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellBooleanBrush">#FFCF8E6D</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellGuidBrush">#FF6AAB73</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellBinaryBrush">#FFBBA07A</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellNullBrush">#FF7A7E85</SolidColorBrush>
          <SolidColorBrush x:Key="AppGridAltRowBrush">#08FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppGridHeaderBrush">#12FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellEditedBrush">#4DB8860B</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellNewBrush">#407BC67E</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellDeletedBrush">#40F1707A</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectTableBrush">#FFF5A55A</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectViewBrush">#FF7BC67E</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectMaterializedViewBrush">#FF4DD0E1</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectForeignTableBrush">#FFC4A99C</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectProcedureBrush">#FF6EB0F7</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectFunctionBrush">#FFC792EA</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectTriggerBrush">#FFF27878</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectSequenceBrush">#FFE2C35C</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectSynonymBrush">#FFF48FB1</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectOtherBrush">#FFA0A0A0</SolidColorBrush>
          <SolidColorBrush x:Key="AppPlanHotBrush">#FFF27878</SolidColorBrush>
          <SolidColorBrush x:Key="AppPlanWarmBrush">#FFF5A55A</SolidColorBrush>
          <SolidColorBrush x:Key="AppPlanCoolBrush">#FF8FA4AE</SolidColorBrush>
          <SolidColorBrush x:Key="AppPlanWarningBrush">#FFE2C35C</SolidColorBrush>
          <SolidColorBrush x:Key="AppBarBackgroundBrush">#FF17181B</SolidColorBrush>
          <SolidColorBrush x:Key="AppBarGroupBrush">#FF222327</SolidColorBrush>
          <SolidColorBrush x:Key="AppBarGroupBorderBrush">#1FFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppToolHoverBrush">#1AFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppToolPressedBrush">#2BFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppKeycapBrush">#17FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppStatusConnectedBrush">#FF3FCB74</SolidColorBrush>
          <SolidColorBrush x:Key="AppStatusBusyBrush">#FFF2B33D</SolidColorBrush>
          <SolidColorBrush x:Key="AppStatusIdleBrush">#FF80868B</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerBrush">#FFF27878</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerHoverBrush">#26F27878</SolidColorBrush>
        </ResourceDictionary>
        <!-- High contrast (Preferences, or Windows' contrast themes with the System theme): black, white and bright
             colours, yellow accent with black text. Keys not listed here fall back to Dark. -->
        <ResourceDictionary x:Key="{x:Static services:AppThemes.HighContrast}">
          <SolidColorBrush x:Key="AppBorderBrush">#FFC8C8C8</SolidColorBrush>
          <SolidColorBrush x:Key="AppSplitterGripBrush">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppSubtleBackgroundBrush">#FF101010</SolidColorBrush>
          <SolidColorBrush x:Key="AppPopupBackgroundBrush">#FF000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppPopupBorderBrush">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppCodeBackgroundBrush">#FF000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppForegroundBrush">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppHintForegroundBrush">#FFE6E6E6</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellTextBrush">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellNumberBrush">#FF00FFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellDateBrush">#FFFF8CFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellBooleanBrush">#FFFFD700</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellGuidBrush">#FF7CFC00</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellBinaryBrush">#FFFFC080</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellNullBrush">#FFC8C8C8</SolidColorBrush>
          <SolidColorBrush x:Key="AppGridAltRowBrush">#1FFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppGridHeaderBrush">#33FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellEditedBrush">#80705A00</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellNewBrush">#80005A00</SolidColorBrush>
          <SolidColorBrush x:Key="AppCellDeletedBrush">#80800000</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectTableBrush">#FFFFA040</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectViewBrush">#FF60FF60</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectMaterializedViewBrush">#FF40FFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectForeignTableBrush">#FFE0C0A8</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectProcedureBrush">#FF80C8FF</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectFunctionBrush">#FFE88CFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectTriggerBrush">#FFFF6E6E</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectSequenceBrush">#FFFFE040</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectSynonymBrush">#FFFF8CC8</SolidColorBrush>
          <SolidColorBrush x:Key="AppObjectOtherBrush">#FFE6E6E6</SolidColorBrush>
          <SolidColorBrush x:Key="AppPlanHotBrush">#FFFF6E6E</SolidColorBrush>
          <SolidColorBrush x:Key="AppPlanWarmBrush">#FFFFB040</SolidColorBrush>
          <SolidColorBrush x:Key="AppPlanCoolBrush">#FFC8D8E8</SolidColorBrush>
          <SolidColorBrush x:Key="AppPlanWarningBrush">#FFFFD700</SolidColorBrush>
          <SolidColorBrush x:Key="AppBarBackgroundBrush">#FF000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppBarGroupBrush">#FF000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppBarGroupBorderBrush">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppToolHoverBrush">#4DFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppToolPressedBrush">#80FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppKeycapBrush">#FF000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppStatusConnectedBrush">#FF00FF7F</SolidColorBrush>
          <SolidColorBrush x:Key="AppStatusBusyBrush">#FFFFD700</SolidColorBrush>
          <SolidColorBrush x:Key="AppStatusIdleBrush">#FFC8C8C8</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerBrush">#FFFF6E6E</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerHoverBrush">#40FF6E6E</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentForegroundBrush">#FF000000</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonBackground">#FFFFD700</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver">#FFFFE34D</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed">#FFE6C200</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonBackgroundDisabled">#FF3A3A3A</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonForeground">#FF000000</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver">#FF000000</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonForegroundPressed">#FF000000</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonForegroundDisabled">#FFC8C8C8</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonBorderBrush">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="ButtonBorderBrush">#FFC8C8C8</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBorderBrush">#FFC8C8C8</SolidColorBrush>
          <SolidColorBrush x:Key="ComboBoxBorderBrush">#FFC8C8C8</SolidColorBrush>
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked">#FFFFD700</SolidColorBrush>
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked">#FF000000</SolidColorBrush>
          <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill">#FFFFD700</SolidColorBrush>
          <Color x:Key="SystemAccentColor">#FFFFD700</Color>
          <Color x:Key="SystemAccentColorDark1">#FFFFD700</Color>
          <Color x:Key="SystemAccentColorLight1">#FFFFE34D</Color>
          <Color x:Key="SystemAccentColorLight2">#FFFFEC80</Color>
          <Color x:Key="SystemAccentColorLight3">#FFFFF4B3</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <Style Selector="Window">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style Selector="UserControl">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <!-- FluentTheme's default control templates don't always inherit Window.Foreground, which left
         some text (grid cells, dropdown items) rendering with the theme's lower-contrast default
         instead of our app foreground; pin it explicitly so it stays legible in both themes. -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style Selector="DataGridCell TextBlock, DataGridColumnHeader TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style Selector="ComboBoxItem, ListBoxItem, TabItem">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource AppCodeBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Compact, consistent control sizing so views spend less space on inputs -->
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Small secondary buttons (grid toolbars, inline actions) -->
    <Style Selector="Button.compact">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinWidth" Value="32" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- One-row toolbars: inputs, actions and the status text share a line and wrap only when narrow -->
    <!-- Fluent caps flyouts at 456 px; a flyout with wider content (History ▾) opts out with this class -->
    <Style Selector="FlyoutPresenter.wide">
      <Setter Property="MaxWidth" Value="900" />
    </Style>
    <Style Selector="WrapPanel.toolbar">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="WrapPanel.toolbar > :is(Control)">
      <Setter Property="Margin" Value="0,0,8,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Grid splitters: a short rounded grip in the middle shows where panes can be resized (Fluent's splitter is
         invisible until hovered); hovering or dragging turns it into the accent colour along the whole edge. -->
    <Style Selector="GridSplitter">
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="{TemplateBinding Background}">
            <Border Name="PART_Grip" Background="{DynamicResource AppSplitterGripBrush}" CornerRadius="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter[ResizeDirection=Columns] /template/ Border#PART_Grip">
      <Setter Property="Width" Value="3" />
      <Setter Property="Height" Value="36" />
    </Style>
    <Style Selector="GridSplitter[ResizeDirection=Rows] /template/ Border#PART_Grip">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="3" />
    </Style>
    <Style Selector="GridSplitter:pointerover /template/ Border#PART_Grip, GridSplitter:pressed /template/ Border#PART_Grip">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="GridSplitter[ResizeDirection=Columns]:pointerover /template/ Border#PART_Grip, GridSplitter[ResizeDirection=Columns]:pressed /template/ Border#PART_Grip">
      <Setter Property="Width" Value="2" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="GridSplitter[ResizeDirection=Rows]:pointerover /template/ Border#PART_Grip, GridSplitter[ResizeDirection=Rows]:pressed /template/ Border#PART_Grip">
      <Setter Property="Height" Value="2" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Tab headers: Fluent's default is display-sized; keep them readable but short -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- Collapsible option panels: compact header -->
    <Style Selector="Expander.options">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="RowHeight" Value="28" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="MinHeight" Value="28" />
    </Style>
  </Application.Styles>
</Application>
