<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DbExplorer.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBorderBrush">#33000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppSubtleBackgroundBrush">#0A000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppPopupBackgroundBrush">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppPopupBorderBrush">#33000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppCodeBackgroundBrush">#F5F5F5</SolidColorBrush>
          <SolidColorBrush x:Key="AppForegroundBrush">#FF000000</SolidColorBrush>
          <SolidColorBrush x:Key="AppHintForegroundBrush">#99000000</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBorderBrush">#22808080</SolidColorBrush>
          <SolidColorBrush x:Key="AppSubtleBackgroundBrush">#14FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppPopupBackgroundBrush">#FF1E1E1E</SolidColorBrush>
          <SolidColorBrush x:Key="AppPopupBorderBrush">#3A3A3A</SolidColorBrush>
          <SolidColorBrush x:Key="AppCodeBackgroundBrush">#FF1E1E1E</SolidColorBrush>
          <SolidColorBrush x:Key="AppForegroundBrush">#FFFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppHintForegroundBrush">#B3FFFFFF</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style Selector="UserControl">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <!-- FluentTheme's default control templates don't always inherit Window.Foreground, which left
         some text (grid cells, dropdown items) rendering with the theme's lower-contrast default
         instead of our app foreground; pin it explicitly so it stays legible in both themes. -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style Selector="DataGridCell TextBlock, DataGridColumnHeader TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style Selector="ComboBoxItem, ListBoxItem, TabItem">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource AppCodeBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Compact, consistent control sizing so views spend less space on inputs -->
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Small secondary buttons (grid toolbars, inline actions) -->
    <Style Selector="Button.compact">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinWidth" Value="32" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- One-row toolbars: inputs, actions and the status text share a line and wrap only when narrow -->
    <Style Selector="WrapPanel.toolbar">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="WrapPanel.toolbar > :is(Control)">
      <Setter Property="Margin" Value="0,0,8,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Tab headers: Fluent's default is display-sized; keep them readable but short -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- Collapsible option panels: compact header -->
    <Style Selector="Expander.options">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="RowHeight" Value="28" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="MinHeight" Value="28" />
    </Style>
  </Application.Styles>
</Application>
