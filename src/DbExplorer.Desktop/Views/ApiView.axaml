<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbExplorer.Desktop.ViewModels"
             x:Class="DbExplorer.Desktop.Views.ApiView">
  <UserControl.Styles>
    <Style Selector="TextBlock.collection">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="320,4,*" Margin="4">
    <DockPanel Grid.Column="0">
      <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
        <Button Content="Import…" Classes="accent" Click="OnImport"
                ToolTip.Tip="Import a Postman collection or environment (v2.0 / v2.1) or an Insomnia export (v4 JSON)" />
        <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding HasUnsavedChanges}"
                ToolTip.Tip="Save edits to the requests" />
        <Button Content="Remove" Command="{Binding DeleteCollectionCommand}"
                ToolTip.Tip="Remove the selected collection" />
      </WrapPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
        <TextBlock DockPanel.Dock="Left" Text="Environment" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name, FallbackValue='No environment', TargetNullValue='No environment'}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </DockPanel>
      <TreeView ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedNode}">
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="vm:ApiTreeNode" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Badge}" Classes="hint" FontSize="11" MinWidth="44" VerticalAlignment="Center"
                         IsVisible="{Binding Request, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{Binding Name}" Classes.collection="{Binding IsRoot}" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </DockPanel>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

    <DockPanel Grid.Column="2" Margin="4,0,0,0">
      <Border DockPanel.Dock="Bottom" Padding="0,4,0,0">
        <StackPanel Spacing="2">
          <TextBlock Classes="hint" Text="{Binding Status}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}" MaxHeight="120">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Classes="hint" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,8" IsVisible="{Binding !HasRequest}"
                 Text="Select a request on the left. Variables such as {{baseUrl}} come from the collection, overridden by the selected environment." TextWrapping="Wrap" />

      <Grid RowDefinitions="Auto,Auto,*,4,*" IsVisible="{Binding HasRequest}">
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
          <ComboBox DockPanel.Dock="Left" Width="110" ItemsSource="{x:Static vm:ApiViewModel.Methods}"
                    SelectedItem="{Binding SelectedRequest.Method}" SelectionChanged="OnEdited" />
          <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsSending}" Margin="4,0,0,0" />
          <Button DockPanel.Dock="Right" Content="Send" Classes="accent" Command="{Binding SendCommand}" Margin="4,0,0,0"
                  HotKey="Ctrl+Enter" ToolTip.Tip="Send the request (Ctrl+Enter)" />
          <TextBox Text="{Binding SelectedRequest.Url}" Margin="4,0,0,0" TextChanged="OnEdited" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" />
        </DockPanel>
        <TextBlock Grid.Row="1" Classes="hint" Text="{Binding ResolvedUrl}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                   ToolTip.Tip="{Binding ResolvedUrl}" />

        <TabControl Grid.Row="2" Padding="0">
          <TabItem Header="Params">
            <DockPanel>
              <Button DockPanel.Dock="Top" Content="Add parameter" Command="{Binding AddQueryParamCommand}" HorizontalAlignment="Left" Margin="0,4" />
              <DataGrid ItemsSource="{Binding QueryParams}" AutoGenerateColumns="False" CanUserResizeColumns="True"
                        GridLinesVisibility="Horizontal" CellEditEnded="OnCellEdited">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="Auto" />
                  <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="220" />
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="Headers">
            <DockPanel>
              <Button DockPanel.Dock="Top" Content="Add header" Command="{Binding AddHeaderCommand}" HorizontalAlignment="Left" Margin="0,4" />
              <DataGrid ItemsSource="{Binding Headers}" AutoGenerateColumns="False" CanUserResizeColumns="True"
                        GridLinesVisibility="Horizontal" CellEditEnded="OnCellEdited">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="Auto" />
                  <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="220" />
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="Body">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,4">
                <TextBlock Text="Mode" VerticalAlignment="Center" />
                <ComboBox Width="140" ItemsSource="{x:Static vm:ApiViewModel.BodyModes}" SelectedItem="{Binding SelectedRequest.Body.Mode}"
                          SelectionChanged="OnEdited" />
                <TextBlock Text="Content-Type" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBox Width="220" Text="{Binding SelectedRequest.Body.ContentType}" Watermark="from the Content-Type header" TextChanged="OnEdited" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,4"
                         Text="Raw and GraphQL bodies are edited here; form fields are kept as imported." />
              <TextBox Text="{Binding SelectedRequest.Body.Raw}" AcceptsReturn="True" VerticalContentAlignment="Top" AcceptsTab="True" TextWrapping="NoWrap"
                       FontFamily="Cascadia Mono, Consolas, Menlo, monospace" TextChanged="OnEdited" />
            </DockPanel>
          </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="3" ResizeDirection="Rows" />

        <DockPanel Grid.Row="4">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,4">
            <TextBlock Text="Response" FontWeight="Bold" VerticalAlignment="Center" />
            <ProgressBar Width="80" MinWidth="80" IsIndeterminate="True" IsVisible="{Binding IsSending}" />
            <TextBlock Text="{Binding ResponseStatus}" VerticalAlignment="Center" />
          </StackPanel>
          <TabControl Padding="0">
            <TabItem Header="Body">
              <TextBox Text="{Binding ResponseBody}" IsReadOnly="True" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="NoWrap"
                       FontFamily="Cascadia Mono, Consolas, Menlo, monospace" />
            </TabItem>
            <TabItem Header="Headers">
              <DataGrid ItemsSource="{Binding ResponseHeaders}" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Key}" Width="220" />
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
