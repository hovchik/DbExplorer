<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controls="using:DbExplorer.Desktop.Controls"
			 xmlns:vm="using:DbExplorer.Desktop.ViewModels"
			 xmlns:conv="using:DbExplorer.Desktop.Converters"
			 xmlns:models="using:DbExplorer.Core.Models"
			 xmlns:compare="using:DbExplorer.Application.Compare"
			 xmlns:views="using:DbExplorer.Desktop.Views"
			 x:Class="DbExplorer.Desktop.Views.ComparerView"
			 x:Name="root"
			 x:DataType="vm:ComparerViewModel">
  <UserControl.Resources>
	<conv:DiffKindToBrushConverter x:Key="DiffKindBrush" />
	<conv:DataRowStatusToBrushConverter x:Key="RowStatusBrush" />
	<conv:CompareStatusToBrushConverter x:Key="CompareStatusBrush" />
  </UserControl.Resources>


  <UserControl.Styles>
	<Style Selector="Border.card">
	  <Setter Property="BorderThickness" Value="1" />
	  <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
	  <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
	  <Setter Property="Padding" Value="6" />
	  <Setter Property="CornerRadius" Value="6" />
	</Style>
	<Style Selector="TabControl.compact TabItem">
	  <Setter Property="FontSize" Value="14" />
	  <Setter Property="MinHeight" Value="30" />
	  <Setter Property="Padding" Value="10,0" />
	</Style>
	<Style Selector="Border.env">
	  <Setter Property="CornerRadius" Value="4" />
	  <Setter Property="Padding" Value="6,1" />
	  <Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="Border.env TextBlock">
	  <Setter Property="Foreground" Value="White" />
	  <Setter Property="FontSize" Value="11" />
	  <Setter Property="FontWeight" Value="Bold" />
	</Style>
	<Style Selector="Button.chip">
	  <Setter Property="MinHeight" Value="26" />
	  <Setter Property="Padding" Value="10,2" />
	  <Setter Property="Margin" Value="0,0,6,4" />
	  <Setter Property="CornerRadius" Value="13" />
	  <Setter Property="FontSize" Value="12" />
	</Style>
	<!-- Section bar: underlined toggles grouped under DATABASE and OBJECT -->
	<Style Selector="TabControl.sections /template/ ItemsPresenter#PART_ItemsPresenter">
	  <Setter Property="IsVisible" Value="False" />
	</Style>
	<Style Selector="TextBlock.group">
	  <Setter Property="FontSize" Value="10" />
	  <Setter Property="FontWeight" Value="Bold" />
	  <Setter Property="LetterSpacing" Value="0.6" />
	  <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
	  <Setter Property="VerticalAlignment" Value="Center" />
	  <Setter Property="Margin" Value="10,0,4,6" />
	</Style>
	<Style Selector="ToggleButton.section">
	  <Setter Property="Background" Value="Transparent" />
	  <Setter Property="BorderThickness" Value="0,0,0,2" />
	  <Setter Property="BorderBrush" Value="Transparent" />
	  <Setter Property="CornerRadius" Value="0" />
	  <Setter Property="Padding" Value="9,4" />
	  <Setter Property="MinHeight" Value="32" />
	  <Setter Property="FontSize" Value="14" />
	  <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
	</Style>
	<Style Selector="ToggleButton.section /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Background" Value="Transparent" />
	  <Setter Property="BorderBrush" Value="Transparent" />
	  <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
	</Style>
	<Style Selector="ToggleButton.section:pointerover /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
	  <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
	  <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
	</Style>
	<Style Selector="ToggleButton.section:checked /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Background" Value="Transparent" />
	  <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
	  <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
	  <Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<!-- Side cards -->
	<Style Selector="TextBlock.side">
	  <Setter Property="FontSize" Value="11" />
	  <Setter Property="FontWeight" Value="Bold" />
	  <Setter Property="LetterSpacing" Value="0.6" />
	  <Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="TextBlock.sideRole">
	  <Setter Property="FontSize" Value="11" />
	  <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
	  <Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="Ellipse.state">
	  <Setter Property="Width" Value="8" />
	  <Setter Property="Height" Value="8" />
	  <Setter Property="VerticalAlignment" Value="Center" />
	  <Setter Property="Fill" Value="{DynamicResource AppStatusIdleBrush}" />
	</Style>
	<Style Selector="Ellipse.state.on">
	  <Setter Property="Fill" Value="{DynamicResource AppStatusConnectedBrush}" />
	</Style>

	<!-- Setup steps -->
	<Style Selector="Border.step">
	  <Setter Property="Width" Value="22" />
	  <Setter Property="Height" Value="22" />
	  <Setter Property="CornerRadius" Value="11" />
	  <Setter Property="Margin" Value="0,0,10,10" />
	  <Setter Property="VerticalAlignment" Value="Top" />
	  <Setter Property="BorderThickness" Value="1.5" />
	  <Setter Property="BorderBrush" Value="{DynamicResource AppHintForegroundBrush}" />
	</Style>
	<Style Selector="Border.step TextBlock">
	  <Setter Property="FontSize" Value="12" />
	  <Setter Property="FontWeight" Value="Bold" />
	  <Setter Property="HorizontalAlignment" Value="Center" />
	  <Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="Border.step.done">
	  <Setter Property="Background" Value="{DynamicResource AppStatusConnectedBrush}" />
	  <Setter Property="BorderBrush" Value="{DynamicResource AppStatusConnectedBrush}" />
	</Style>
	<Style Selector="Border.step.done TextBlock">
	  <Setter Property="Foreground" Value="White" />
	</Style>
	<Style Selector="TextBlock.step">
	  <Setter Property="TextWrapping" Value="Wrap" />
	  <Setter Property="Margin" Value="0,2,0,10" />
	  <Setter Property="FontSize" Value="13" />
	</Style>

	<!-- Overview status tiles: a count per status that also shows or hides that status -->
	<Style Selector="ToggleButton.tile">
	  <Setter Property="MinWidth" Value="118" />
	  <Setter Property="Margin" Value="0,0,8,6" />
	  <Setter Property="Padding" Value="12,6,14,6" />
	  <Setter Property="CornerRadius" Value="8" />
	  <Setter Property="BorderThickness" Value="1,1,1,1" />
	  <Setter Property="HorizontalContentAlignment" Value="Left" />
	</Style>
	<Style Selector="ToggleButton.tile /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Background" Value="Transparent" />
	  <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
	  <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
	  <Setter Property="Opacity" Value="0.75" />
	</Style>
	<Style Selector="ToggleButton.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
	  <Setter Property="Opacity" Value="1" />
	</Style>
	<Style Selector="ToggleButton.tile:checked /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
	  <Setter Property="BorderThickness" Value="1,1,1,3" />
	  <Setter Property="Opacity" Value="1" />
	</Style>
	<Style Selector="ToggleButton.tile.different:checked /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Background" Value="#3CDBAA3D" />
	  <Setter Property="BorderBrush" Value="#FFDBAA3D" />
	</Style>
	<Style Selector="ToggleButton.tile.onlyLeft:checked /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Background" Value="#3CDB6E3D" />
	  <Setter Property="BorderBrush" Value="#FFDB6E3D" />
	</Style>
	<Style Selector="ToggleButton.tile.onlyRight:checked /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Background" Value="#3C3D82DB" />
	  <Setter Property="BorderBrush" Value="#FF3D82DB" />
	</Style>
	<Style Selector="ToggleButton.tile.identical:checked /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Background" Value="#262E9E4F" />
	  <Setter Property="BorderBrush" Value="#FF2E9E4F" />
	</Style>
	<Style Selector="ToggleButton.tile.notCompared:checked /template/ ContentPresenter#PART_ContentPresenter">
	  <Setter Property="Background" Value="#26909090" />
	  <Setter Property="BorderBrush" Value="#FF909090" />
	</Style>
	<Style Selector="ToggleButton.tile TextBlock.count">
	  <Setter Property="FontSize" Value="20" />
	  <Setter Property="FontWeight" Value="SemiBold" />
	</Style>
	<Style Selector="ToggleButton.tile TextBlock.label">
	  <Setter Property="FontSize" Value="12" />
	</Style>

	<!-- Overview status pill -->
	<Style Selector="Border.status">
	  <Setter Property="CornerRadius" Value="9" />
	  <Setter Property="Padding" Value="8,1" />
	  <Setter Property="Margin" Value="8,0" />
	  <Setter Property="HorizontalAlignment" Value="Left" />
	  <Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="Border.status TextBlock">
	  <Setter Property="FontSize" Value="12" />
	  <Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<!-- Narrow window (set from code): the group captions give their room to the sections -->
	<Style Selector=".narrow TextBlock.group">
	  <Setter Property="IsVisible" Value="False" />
	</Style>
	<Style Selector=".narrow ToggleButton.section">
	  <Setter Property="Padding" Value="7,4" />
	</Style>

	<Style Selector="TextBlock.next">
	  <Setter Property="FontSize" Value="12" />
	  <Setter Property="FontWeight" Value="SemiBold" />
	  <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
	</Style>
	<Style Selector="TextBlock.empty">
	  <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
	  <Setter Property="TextWrapping" Value="Wrap" />
	  <Setter Property="HorizontalAlignment" Value="Center" />
	  <Setter Property="VerticalAlignment" Value="Center" />
	  <Setter Property="TextAlignment" Value="Center" />
	  <Setter Property="MaxWidth" Value="520" />
	</Style>
  </UserControl.Styles>

  <Grid Margin="4,4,4,0" RowDefinitions="Auto,Auto,Auto,*,Auto">
	<!-- Who is compared with whom: the left side is the source, the right side the target that scripts and copies change -->
	<Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Margin="0,0,0,4" IsVisible="{Binding IsConnectionsExpanded}">
		<Border Grid.Column="0" Classes="card side" IsVisible="{Binding IsLeftPanelVisible}">
		  <Grid RowDefinitions="Auto,Auto,Auto">
			<DockPanel Grid.Row="0">
			  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
				<Button Classes="compact" Content="Connect" Command="{Binding ConnectLeftCommand}" IsVisible="{Binding !IsLeftConnected}" />
				<Button Classes="compact" Content="Disconnect" Command="{Binding DisconnectLeftCommand}" IsVisible="{Binding IsLeftConnected}" />
				<Button Classes="compact" Content="Use current" Command="{Binding UseCurrentAsLeftCommand}"
						ToolTip.Tip="Use the connection already open in the main window" />
			  </StackPanel>
			  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" ToolTip.Tip="The source side: what the right side is compared with, and what scripts and copies take as the model">
				<Ellipse Classes="state" Classes.on="{Binding IsLeftConnected}" />
				<TextBlock Classes="side" Text="LEFT" />
				<TextBlock Classes="sideRole" Text="source" />
				<Border Classes="env" Margin="2,0,0,0" IsVisible="{Binding LeftEnvironmentTag, Converter={x:Static ObjectConverters.IsNotNull}}"
						Background="{Binding LeftEnvironment, Converter={x:Static conv:EnvironmentToBrushConverter.Instance}}">
				  <TextBlock Text="{Binding LeftEnvironmentTag}" />
				</Border>
			  </StackPanel>
			</DockPanel>

			<Grid Grid.Row="1" ColumnDefinitions="3*,2*" Margin="0,4,0,0">
			  <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Profiles}" SelectedItem="{Binding LeftProfile}"
						AutomationProperties.Name="Left connection" Margin="0,0,4,0"
						PlaceholderText="Select a connection..." IsEnabled="{Binding !IsLeftConnected}" />
			  <controls:DatabasePicker Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LeftDatabases}" SelectedItem="{Binding SelectedLeftDatabase}"
						PlaceholderText="(database)" IsEnabled="{Binding IsLeftConnected}" ToolTip.Tip="Database of the left server" />
			</Grid>

			<Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0" IsVisible="{Binding IsObjectTab}">
			  <AutoCompleteBox AutomationProperties.Name="Left object" Grid.Column="0" x:Name="LeftObjectPicker" ItemsSource="{Binding LeftObjects}" SelectedItem="{Binding SelectedLeftObject}"
							   ValueMemberBinding="{Binding FullName}" FilterMode="Contains" MinimumPrefixLength="0"
							   IsTextCompletionEnabled="False" GotFocus="OnObjectPickerGotFocus" IsEnabled="{Binding IsLeftConnected}"
							   Watermark="Click to browse or type to filter objects...">
				<AutoCompleteBox.ItemTemplate>
				  <DataTemplate x:DataType="models:DbObject">
					<Grid ColumnDefinitions="Auto,*,Auto">
					  <controls:ObjectTypeBadge Type="{Binding Type}" ShowText="False" Margin="0,0,8,0" />
					  <TextBlock Grid.Column="1" Text="{Binding FullName}" TextTrimming="CharacterEllipsis" />
					  <TextBlock Grid.Column="2" Classes="hint" Margin="12,0,0,0" VerticalAlignment="Center"
								 Text="{Binding Type, Converter={x:Static conv:HumanizeConverter.Instance}}" />
					</Grid>
				  </DataTemplate>
				</AutoCompleteBox.ItemTemplate>
			  </AutoCompleteBox>
			  <TextBlock Grid.Column="1" Classes="hint" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="200"
						 TextTrimming="CharacterEllipsis" Text="{Binding LeftObjectInfo}" ToolTip.Tip="{Binding LeftObjectInfo}" />
			</Grid>
		  </Grid>
		</Border>

		<!-- Direction, swap and what is shown -->
		<StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Spacing="4">
		  <TextBlock Classes="hint" Text="→" FontSize="16" HorizontalAlignment="Center"
					 ToolTip.Tip="Scripts and copies make the right side match the left" />
		  <Button Content="⇄" Classes="icon" FontSize="14" HorizontalAlignment="Center"
				  Command="{Binding SwapSidesCommand}" ToolTip.Tip="Swap sides: the right becomes the source" />
		</StackPanel>

		<Border Grid.Column="2" Classes="card side" IsVisible="{Binding IsRightPanelVisible}">
		  <Grid RowDefinitions="Auto,Auto,Auto,Auto">
			<DockPanel Grid.Row="0">
			  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
				<Button Classes="compact" Content="Connect" Command="{Binding ConnectRightCommand}" IsVisible="{Binding !IsRightConnected}" />
				<Button Classes="compact" Content="Disconnect" Command="{Binding DisconnectRightCommand}" IsVisible="{Binding IsRightConnected}" />
				<Button Classes="compact" Content="Use current" Command="{Binding UseCurrentAsRightCommand}"
						ToolTip.Tip="Use the connection already open in the main window" />
			  </StackPanel>
			  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" ToolTip.Tip="The target side: what migration scripts and copies change">
				<Ellipse Classes="state" Classes.on="{Binding IsRightConnected}" />
				<TextBlock Classes="side" Text="RIGHT" />
				<TextBlock Classes="sideRole" Text="target" />
				<Border Classes="env" Margin="2,0,0,0" IsVisible="{Binding RightEnvironmentTag, Converter={x:Static ObjectConverters.IsNotNull}}"
						Background="{Binding RightEnvironment, Converter={x:Static conv:EnvironmentToBrushConverter.Instance}}">
				  <TextBlock Text="{Binding RightEnvironmentTag}" />
				</Border>
			  </StackPanel>
			</DockPanel>

			<Grid Grid.Row="1" ColumnDefinitions="3*,2*" Margin="0,4,0,0">
			  <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Profiles}" SelectedItem="{Binding RightProfile}"
						AutomationProperties.Name="Right connection" Margin="0,0,4,0"
						PlaceholderText="Select a connection..." IsEnabled="{Binding !IsRightConnected}" />
			  <controls:DatabasePicker Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding RightDatabases}" SelectedItem="{Binding SelectedRightDatabase}"
						PlaceholderText="(database)" IsEnabled="{Binding IsRightConnected}" ToolTip.Tip="Database of the right server: any database on it can be the target, or create the left one when it is missing" />
			</Grid>

			<Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0" IsVisible="{Binding IsObjectTab}">
			  <AutoCompleteBox AutomationProperties.Name="Right object" Grid.Column="0" x:Name="RightObjectPicker" ItemsSource="{Binding RightObjects}" SelectedItem="{Binding SelectedRightObject}"
							   ValueMemberBinding="{Binding FullName}" FilterMode="Contains" MinimumPrefixLength="0"
							   IsTextCompletionEnabled="False" GotFocus="OnObjectPickerGotFocus" IsEnabled="{Binding IsRightConnected}"
							   Watermark="Picked automatically when the same name exists; or browse...">
				<AutoCompleteBox.ItemTemplate>
				  <DataTemplate x:DataType="models:DbObject">
					<Grid ColumnDefinitions="Auto,*,Auto">
					  <controls:ObjectTypeBadge Type="{Binding Type}" ShowText="False" Margin="0,0,8,0" />
					  <TextBlock Grid.Column="1" Text="{Binding FullName}" TextTrimming="CharacterEllipsis" />
					  <TextBlock Grid.Column="2" Classes="hint" Margin="12,0,0,0" VerticalAlignment="Center"
								 Text="{Binding Type, Converter={x:Static conv:HumanizeConverter.Instance}}" />
					</Grid>
				  </DataTemplate>
				</AutoCompleteBox.ItemTemplate>
			  </AutoCompleteBox>
			  <TextBlock Grid.Column="1" Classes="hint" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="200"
						 TextTrimming="CharacterEllipsis" Text="{Binding RightObjectInfo}" ToolTip.Tip="{Binding RightObjectInfo}" />
			</Grid>

			<!-- The left database is missing on the right server: offer to create it before copying into it -->
			<WrapPanel Grid.Row="3" Margin="0,4,0,0" IsVisible="{Binding HasMissingRightDatabase}">
			  <TextBlock Classes="hint" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding MissingRightDatabaseHint}" />
			  <Button Classes="accent compact" Content="{Binding CreateRightDatabaseLabel}" Command="{Binding CreateRightDatabaseCommand}"
					  ToolTip.Tip="Create an empty database with this name on the right server (server defaults), then switch the right side to it so objects can be copied into it" />
			</WrapPanel>
		  </Grid>
		</Border>
	</Grid>

	<!-- Collapsed connections: one summary line -->
	<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4" IsVisible="{Binding !IsConnectionsExpanded}">
	  <TextBlock Classes="side" Text="LEFT" />
	  <Border Classes="env" IsVisible="{Binding LeftEnvironmentTag, Converter={x:Static ObjectConverters.IsNotNull}}"
			  Background="{Binding LeftEnvironment, Converter={x:Static conv:EnvironmentToBrushConverter.Instance}}">
		<TextBlock Text="{Binding LeftEnvironmentTag}" />
	  </Border>
	  <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding LeftSummary}" />
	  <Button Classes="compact" Content="⇄" Command="{Binding SwapSidesCommand}" ToolTip.Tip="Swap sides" />
	  <TextBlock Classes="side" Text="RIGHT" />
	  <Border Classes="env" IsVisible="{Binding RightEnvironmentTag, Converter={x:Static ObjectConverters.IsNotNull}}"
			  Background="{Binding RightEnvironment, Converter={x:Static conv:EnvironmentToBrushConverter.Instance}}">
		<TextBlock Text="{Binding RightEnvironmentTag}" />
	  </Border>
	  <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding RightSummary}" />
	</StackPanel>

	<!-- Sections: the whole database, or one pair of objects. The section's main action sits on the right (F5). -->
	<Border Grid.Row="2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}" Margin="0,0,0,6">
	  <DockPanel LastChildFill="True">
		<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,4">
		  <Button Classes="accent" Content="Compare all objects" Command="{Binding CompareOverviewCommand}" IsVisible="{Binding IsOverviewTab}"
				  ToolTip.Tip="Compare every table, view, routine and trigger of the two databases (F5). Runs by itself when a side changes; it reads cached metadata, so it is instant and puts no load on the servers" />
		  <Button Classes="accent" Content="Generate script" Command="{Binding GenerateMigrationCommand}" IsVisible="{Binding IsMigrationTab}"
				  ToolTip.Tip="Build the script that makes the right database match the left (F5): creates missing tables, views and routines, alters tables that differ, replaces changed views and routines. Nothing is changed" />
		  <Button Classes="accent" Content="Compare definitions" Command="{Binding CompareSchemaCommand}" IsVisible="{Binding IsSchemaTab}"
				  ToolTip.Tip="Compare the definition text of the two objects (F5)" />
		  <Button Classes="accent" Content="Compare structure" Command="{Binding CompareSchemaCommand}" IsVisible="{Binding IsStructureTab}"
				  ToolTip.Tip="Compare columns (type, nullability, key, position), indexes and foreign keys from cached metadata (F5)" />
		  <Button Classes="accent" Content="Compare data" Command="{Binding CompareDataCommand}" IsVisible="{Binding ShowCompareDataAction}"
				  ToolTip.Tip="Read the rows of both tables in key order and match them (F5)" />
		  <Button Classes="accent" Content="Load both" Command="{Binding LoadBothDataCommand}" IsVisible="{Binding ShowLoadBothAction}"
				  ToolTip.Tip="Load the rows of both tables, up to the row limit (F5)" />
		  <Button Classes="accent" Content="Preview copy" Command="{Binding PreviewCopyCommand}" IsVisible="{Binding ShowPreviewCopyAction}"
				  ToolTip.Tip="Read what is needed and build the exact script and row counts; nothing is changed (F5)" />
		  <Button Classes="icon" Content="⋯" ToolTip.Tip="Layout: which sides and panels are shown">
			<Button.Flyout>
			  <Flyout Placement="BottomEdgeAlignedRight">
				<StackPanel Spacing="6" Width="240">
				  <TextBlock Classes="section" Text="Show" Margin="0" />
				  <CheckBox Content="Connection panels" IsChecked="{Binding IsConnectionsExpanded}"
							ToolTip.Tip="Hide them to give the results more room; a one-line summary stays" />
				  <CheckBox Content="Left side" IsChecked="{Binding IsLeftPanelVisible}"
							ToolTip.Tip="Show the left side (panel and result columns)" />
				  <CheckBox Content="Right side" IsChecked="{Binding IsRightPanelVisible}"
							ToolTip.Tip="Show the right side (panel and result columns)" />
				</StackPanel>
			  </Flyout>
			</Button.Flyout>
		  </Button>
		</StackPanel>

		<StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
		  <TextBlock Classes="group" Text="DATABASE" />
		  <ToggleButton Classes="section" Content="Overview" IsChecked="{Binding IsOverviewTab}"
						ToolTip.Tip="Every object of both databases: what differs and what exists on one side only" />
		  <ToggleButton Classes="section" Content="Migration" IsChecked="{Binding IsMigrationTab}"
						ToolTip.Tip="One reviewed script that makes the right database's schema match the left's" />
		  <Border Width="1" Height="18" Margin="10,0,0,8" Background="{DynamicResource AppBorderBrush}" VerticalAlignment="Center" />
		  <TextBlock Classes="group" Text="OBJECT" />
		  <ToggleButton Classes="section" Content="Definition" IsChecked="{Binding IsSchemaTab}"
						ToolTip.Tip="The definition text of two objects, side by side" />
		  <ToggleButton Classes="section" Content="Structure" IsChecked="{Binding IsStructureTab}"
						ToolTip.Tip="Columns, indexes and foreign keys of two tables" />
		  <ToggleButton Classes="section" Content="Data" IsChecked="{Binding IsDataTab}"
						ToolTip.Tip="The rows of two tables or views" />
		  <ToggleButton Classes="section" Content="Copy &amp; sync" IsChecked="{Binding IsCopyTab}"
						ToolTip.Tip="Create the left object on the right, or merge / replace its data" />
		</StackPanel>
	  </DockPanel>
	</Border>

	<TabControl Grid.Row="3" Classes="sections" Padding="0" SelectedIndex="{Binding SelectedTabIndex}">
	  <!-- Every object of both databases -->
	  <TabItem Header="Overview">
		<Panel>
		<!-- Until both sides are connected: what to do, in order -->
		<Border Classes="card" IsVisible="{Binding !IsSetupComplete}" HorizontalAlignment="Center" VerticalAlignment="Center"
				Padding="24,20" MaxWidth="560">
		  <StackPanel Spacing="12">
			<TextBlock Text="Compare two databases" FontSize="18" FontWeight="SemiBold" />
			<TextBlock Classes="hint" TextWrapping="Wrap" FontSize="13"
					   Text="See what differs between two databases (for example development and production), then open an object's diff, generate a migration script, or copy objects and rows to the right." />
			<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
			  <Border Grid.Row="0" Classes="step" Classes.done="{Binding IsLeftConnected}"><TextBlock Text="1" /></Border>
			  <TextBlock Grid.Row="0" Grid.Column="1" Classes="step" Text="{Binding LeftStepText}" />
			  <Border Grid.Row="1" Classes="step" Classes.done="{Binding IsRightConnected}"><TextBlock Text="2" /></Border>
			  <TextBlock Grid.Row="1" Grid.Column="1" Classes="step" Text="{Binding RightStepText}" />
			  <Border Grid.Row="2" Classes="step"><TextBlock Text="3" /></Border>
			  <TextBlock Grid.Row="2" Grid.Column="1" Classes="step"
						 Text="Every object is compared as soon as both sides are connected. Double-click one to see its diff." />
			</Grid>
		  </StackPanel>
		</Border>

		<Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsSetupComplete}">
		  <!-- Status tiles: counts that double as filters -->
		  <WrapPanel Grid.Row="0" Margin="0,0,0,2">
			<ToggleButton Classes="tile different" IsChecked="{Binding ShowOverviewDifferent}" AutomationProperties.Name="{Binding OverviewDifferentLabel}"
						  ToolTip.Tip="Objects on both sides whose structure or definition differs. Click to show or hide them">
			  <StackPanel>
				<TextBlock Classes="count" Text="{Binding OverviewDifferentCount, StringFormat='{}{0:N0}'}" />
				<TextBlock Classes="label" Text="Different" />
			  </StackPanel>
			</ToggleButton>
			<ToggleButton Classes="tile onlyLeft" IsChecked="{Binding ShowOverviewOnlyLeft}" AutomationProperties.Name="{Binding OverviewOnlyLeftLabel}"
						  ToolTip.Tip="Objects missing on the right: a migration script or a copy creates them. Click to show or hide them">
			  <StackPanel>
				<TextBlock Classes="count" Text="{Binding OverviewOnlyLeftCount, StringFormat='{}{0:N0}'}" />
				<TextBlock Classes="label" Text="Only in left" />
			  </StackPanel>
			</ToggleButton>
			<ToggleButton Classes="tile onlyRight" IsChecked="{Binding ShowOverviewOnlyRight}" AutomationProperties.Name="{Binding OverviewOnlyRightLabel}"
						  ToolTip.Tip="Objects only the right has. Click to show or hide them">
			  <StackPanel>
				<TextBlock Classes="count" Text="{Binding OverviewOnlyRightCount, StringFormat='{}{0:N0}'}" />
				<TextBlock Classes="label" Text="Only in right" />
			  </StackPanel>
			</ToggleButton>
			<ToggleButton Classes="tile identical" IsChecked="{Binding ShowOverviewIdentical}" AutomationProperties.Name="{Binding OverviewIdenticalLabel}"
						  ToolTip.Tip="Objects that are the same on both sides. Click to show or hide them">
			  <StackPanel>
				<TextBlock Classes="count" Text="{Binding OverviewIdenticalCount, StringFormat='{}{0:N0}'}" />
				<TextBlock Classes="label" Text="Identical" />
			  </StackPanel>
			</ToggleButton>
			<ToggleButton Classes="tile notCompared" IsChecked="{Binding ShowOverviewNotCompared}" AutomationProperties.Name="{Binding OverviewNotComparedLabel}"
						  ToolTip.Tip="Objects present on both sides whose content is not in the metadata cache (e.g. sequences, synonyms, encrypted modules)">
			  <StackPanel>
				<TextBlock Classes="count" Text="{Binding OverviewNotComparedCount, StringFormat='{}{0:N0}'}" />
				<TextBlock Classes="label" Text="Not compared" />
			  </StackPanel>
			</ToggleButton>
		  </WrapPanel>

		  <WrapPanel Grid.Row="1" Classes="toolbar">
			<TextBox Width="220" Text="{Binding OverviewFilterText}" Watermark="Filter by name..." AutomationProperties.Name="Filter objects by name" />
			<ComboBox Width="140" ItemsSource="{Binding OverviewTypes}" SelectedItem="{Binding SelectedOverviewType}"
					  AutomationProperties.Name="Object type" ToolTip.Tip="Show one kind of object only">
			  <ComboBox.ItemTemplate>
				<DataTemplate>
				  <TextBlock Text="{Binding Converter={x:Static conv:HumanizeConverter.Instance}}" />
				</DataTemplate>
			  </ComboBox.ItemTemplate>
			</ComboBox>
			<TextBlock Classes="hint" Text="{Binding OverviewStatus}" TextWrapping="Wrap" />
		  </WrapPanel>

		  <DataGrid Grid.Row="2" x:Name="OverviewGrid" ItemsSource="{Binding OverviewEntries}" SelectedItem="{Binding SelectedOverviewEntry}"
					IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
					GridLinesVisibility="Horizontal" DoubleTapped="OnOverviewDoubleTapped"
					SelectionMode="Extended" SelectionChanged="OnOverviewSelectionChanged">
			<DataGrid.Columns>
			  <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="130">
				<DataGridTemplateColumn.CellTemplate>
				  <DataTemplate x:DataType="compare:ObjectComparisonEntry">
					<Border Classes="status" Background="{Binding Status, Converter={StaticResource CompareStatusBrush}}">
					  <TextBlock Text="{Binding Status, Converter={x:Static conv:HumanizeConverter.Instance}}" />
					</Border>
				  </DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			  </DataGridTemplateColumn>
			  <DataGridTemplateColumn Header="Type" SortMemberPath="Type" Width="140">
				<DataGridTemplateColumn.CellTemplate>
				  <DataTemplate x:DataType="compare:ObjectComparisonEntry">
					<controls:ObjectTypeBadge Type="{Binding Type}" Margin="10,0" />
				  </DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			  </DataGridTemplateColumn>
			  <DataGridTextColumn Header="Object" Binding="{Binding FullName}" Width="280" />
			  <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
			</DataGrid.Columns>
		  </DataGrid>
		  <TextBlock Grid.Row="2" Classes="empty" IsVisible="{Binding IsOverviewFilteredEmpty}" Text="{Binding OverviewFilteredEmptyText}" />
		  <TextBlock Grid.Row="2" Classes="empty" IsVisible="{Binding !HasOverview}"
					 Text="Nothing to compare yet: pick a database on each side. The comparison uses the cached metadata, so it is instant and puts no load on the servers." />

		  <!-- What can be done with the selection -->
		  <Border Grid.Row="3" Classes="card" Margin="0,6,0,0" Padding="8,4">
			<DockPanel>
			  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
				<Button Content="Open diff" Command="{Binding OpenOverviewEntryCommand}"
						ToolTip.Tip="Show the detailed diff of the selected object (or double-click a row, or press Enter)" />
				<Button Content="Migration script…" Command="{Binding MigrationFromOverviewCommand}"
						ToolTip.Tip="Build one script that makes the right database match the left (for the selected objects when several are selected) on the Migration section" />
				<Button Content="{Binding CopyOverviewLabel}" Command="{Binding CopyOverviewEntryCommand}"
						ToolTip.Tip="Open the selected left object(s) on the Copy &amp; sync section: create them on the right, or merge / replace their data. Ctrl/Shift-click to select several for a batch copy" />
			  </StackPanel>
			  <TextBlock VerticalAlignment="Center" Text="{Binding OverviewSelectionText}" TextTrimming="CharacterEllipsis"
						 Classes.hint="{Binding !HasOverviewSelection}" FontWeight="SemiBold" />
			</DockPanel>
		  </Border>
		</Grid>
		</Panel>
	  </TabItem>

	  <!-- Definition text of one object -->
	  <TabItem Header="Definition">
		<Grid RowDefinitions="Auto,Auto,*">
		  <WrapPanel Grid.Row="0" Classes="toolbar">
			<TextBlock Text="Comparison type:" />
			<ComboBox Width="140" ItemsSource="{Binding SchemaCompareModes}" SelectedItem="{Binding SelectedSchemaCompareMode}"
					  ToolTip.Tip="Line by line: aligns whole lines. Content: aligns words and symbols, ignoring all formatting.">
			  <ComboBox.ItemTemplate>
				<DataTemplate>
				  <TextBlock Text="{Binding Converter={x:Static conv:HumanizeConverter.Instance}}" />
				</DataTemplate>
			  </ComboBox.ItemTemplate>
			</ComboBox>
			<CheckBox Content="Ignore case" IsChecked="{Binding SchemaIgnoreCase}"
					  ToolTip.Tip="SELECT and select count as the same (keywords and identifiers are case-insensitive on most servers)" />
			<CheckBox Content="Ignore whitespace" IsChecked="{Binding SchemaIgnoreWhitespace}" IsVisible="{Binding IsSchemaLineView}"
					  ToolTip.Tip="Re-indented lines and extra spaces are not reported as changes" />
			<CheckBox Content="Only changes" IsChecked="{Binding ShowOnlySchemaChanges}" IsVisible="{Binding IsSchemaLineView}"
					  ToolTip.Tip="Hide unchanged lines, keeping 3 lines of context around each change" />
			<Button Content="▲" Classes="icon" Command="{Binding PreviousDifferenceCommand}" IsVisible="{Binding IsSchemaLineView}"
					ToolTip.Tip="Previous change (Shift+F8)" />
			<Button Content="▼" Classes="icon" Command="{Binding NextDifferenceCommand}" IsVisible="{Binding IsSchemaLineView}"
					ToolTip.Tip="Next change (F8)" />
			<TextBlock Classes="hint" Text="{Binding ChangePosition}" IsVisible="{Binding IsSchemaLineView}" />
			<Button Content="Export report ▾" IsEnabled="{Binding CanExportSchemaReport}">
			  <Button.Flyout>
				<MenuFlyout>
				  <MenuItem Header="HTML report (.html)…" Click="OnExportSchemaHtml" />
				  <MenuItem Header="Markdown report (.md)…" Click="OnExportSchemaMarkdown" />
				</MenuFlyout>
			  </Button.Flyout>
			</Button>
			<TextBlock Classes="hint" Text="{Binding SchemaStatus}" TextWrapping="Wrap" />
		  </WrapPanel>
		  <DataGrid Grid.Row="2" x:Name="SchemaGrid" ItemsSource="{Binding SchemaDiffView}" SelectedItem="{Binding SelectedSchemaLine}"
					IsReadOnly="True" AutoGenerateColumns="False" IsVisible="{Binding IsSchemaLineView}"
					SelectionChanged="OnSchemaSelectionChanged"
					CanUserResizeColumns="True" CanUserSortColumns="False" GridLinesVisibility="Horizontal"
					FontFamily="Cascadia Mono, Consolas, Menlo, monospace">
			<DataGrid.Styles>
			  <Style Selector="DataGridRow">
				<Setter Property="Background" Value="{Binding Kind, Converter={StaticResource DiffKindBrush}}" />
			  </Style>
			</DataGrid.Styles>
			<DataGrid.Columns>
			  <DataGridTextColumn Header="L#" Binding="{Binding LeftLineNumber}" Width="60"
								  IsVisible="{Binding #root.DataContext.IsLeftPanelVisible}" />
			  <DataGridTextColumn Header="Left" Binding="{Binding LeftText}" Width="*"
								  IsVisible="{Binding #root.DataContext.IsLeftPanelVisible}" />
			  <DataGridTextColumn Header="R#" Binding="{Binding RightLineNumber}" Width="60"
								  IsVisible="{Binding #root.DataContext.IsRightPanelVisible}" />
			  <DataGridTextColumn Header="Right" Binding="{Binding RightText}" Width="*"
								  IsVisible="{Binding #root.DataContext.IsRightPanelVisible}" />
			</DataGrid.Columns>
		  </DataGrid>

		  <Grid Grid.Row="2" ColumnDefinitions="*,*" IsVisible="{Binding IsSchemaContentView}">
			<ScrollViewer Grid.Column="0" IsVisible="{Binding IsLeftPanelVisible}">
			  <ItemsControl ItemsSource="{Binding SchemaDiffLeft}">
				<ItemsControl.ItemTemplate>
				  <DataTemplate x:DataType="models:DiffLineGroup">
					<ItemsControl ItemsSource="{Binding Tokens}">
					  <ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
						  <WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					  </ItemsControl.ItemsPanel>
					  <ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="models:DiffLine">
						  <Border Background="{Binding Kind, Converter={StaticResource DiffKindBrush}}" CornerRadius="2" Padding="3,1" Margin="1,1">
							<TextBlock Text="{Binding LeftText}" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="13" />
						  </Border>
						</DataTemplate>
					  </ItemsControl.ItemTemplate>
					</ItemsControl>
				  </DataTemplate>
				</ItemsControl.ItemTemplate>
			  </ItemsControl>
			</ScrollViewer>
			<GridSplitter Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="{DynamicResource AppBorderBrush}" />
			<ScrollViewer Grid.Column="1" IsVisible="{Binding IsRightPanelVisible}">
			  <ItemsControl ItemsSource="{Binding SchemaDiffRight}">
				<ItemsControl.ItemTemplate>
				  <DataTemplate x:DataType="models:DiffLineGroup">
					<ItemsControl ItemsSource="{Binding Tokens}">
					  <ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
						  <WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					  </ItemsControl.ItemsPanel>
					  <ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="models:DiffLine">
						  <Border Background="{Binding Kind, Converter={StaticResource DiffKindBrush}}" CornerRadius="2" Padding="3,1" Margin="1,1">
							<TextBlock Text="{Binding RightText}" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="13" />
						  </Border>
						</DataTemplate>
					  </ItemsControl.ItemTemplate>
					</ItemsControl>
				  </DataTemplate>
				</ItemsControl.ItemTemplate>
			  </ItemsControl>
			</ScrollViewer>
		  </Grid>
		</Grid>
	  </TabItem>

	  <!-- Columns, indexes and foreign keys of two tables -->
	  <TabItem Header="Structure">
		<Grid RowDefinitions="Auto,Auto,*">
		  <WrapPanel Grid.Row="0" Classes="toolbar">
			<CheckBox Content="Only differences" IsChecked="{Binding ShowOnlyStructureChanges}" />
			<TextBlock Classes="hint" Text="{Binding StructureStatus}" TextWrapping="Wrap" />
		  </WrapPanel>
		  <DataGrid Grid.Row="2" ItemsSource="{Binding StructureDiff}" IsReadOnly="True" AutoGenerateColumns="False"
					CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
			<DataGrid.Styles>
			  <Style Selector="DataGridRow">
				<Setter Property="Background" Value="{Binding Change, Converter={StaticResource CompareStatusBrush}}" />
			  </Style>
			</DataGrid.Styles>
			<DataGrid.Columns>
			  <DataGridTextColumn Header="Kind" Binding="{Binding Category}" Width="100" />
			  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
			  <DataGridTemplateColumn Header="Change" SortMemberPath="Change" Width="110">
				<DataGridTemplateColumn.CellTemplate>
				  <DataTemplate x:DataType="compare:StructureDiffRow">
					<TextBlock Margin="12,0" VerticalAlignment="Center" Text="{Binding Change, Converter={x:Static conv:HumanizeConverter.Instance}}" />
				  </DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			  </DataGridTemplateColumn>
			  <DataGridTextColumn Header="Left" Binding="{Binding Left}" Width="*"
								  IsVisible="{Binding #root.DataContext.IsLeftPanelVisible}" />
			  <DataGridTextColumn Header="Right" Binding="{Binding Right}" Width="*"
								  IsVisible="{Binding #root.DataContext.IsRightPanelVisible}" />
			  <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
			</DataGrid.Columns>
		  </DataGrid>
		</Grid>
	  </TabItem>

	  <!-- Rows of two tables/views -->
	  <TabItem Header="Data">
		<Grid RowDefinitions="Auto,*">
		  <StackPanel Grid.Row="0">
			<WrapPanel Classes="toolbar">
			  <TextBlock Text="Max rows:" />
			  <NumericUpDown Value="{Binding RowLimit}" Minimum="1" Maximum="20000" Increment="1000" FormatString="N0" Width="140"
							 ToolTip.Tip="Rows read per side, in key order; capped at 20,000 to protect the servers" />
			  <ComboBox ItemsSource="{Binding DataViewModes}" SelectedItem="{Binding SelectedDataViewMode}" Width="160" ToolTip.Tip="View">
				<ComboBox.ItemTemplate>
				  <DataTemplate>
					<TextBlock Text="{Binding Converter={x:Static conv:HumanizeConverter.Instance}}" />
				  </DataTemplate>
				</ComboBox.ItemTemplate>
			  </ComboBox>
			  <Button Content="{Binding DataOptionsLabel}" IsVisible="{Binding !IsFullDataSetsView}"
					  ToolTip.Tip="Ignored columns, case and whitespace handling">
				<Button.Flyout>
				  <Flyout Placement="BottomEdgeAlignedLeft">
					<StackPanel Spacing="8" Width="340">
					  <TextBlock Text="Ignore columns" Classes="section" Margin="0" />
					  <TextBox Text="{Binding IgnoredColumnsText}" Watermark="e.g. ModifiedAt, RowVersion"
							   ToolTip.Tip="Comma-separated column names left out of the comparison (key columns are still used to match rows)" />
					  <CheckBox Content="Ignore case in text" IsChecked="{Binding DataIgnoreCase}" />
					  <CheckBox Content="Trim whitespace in text" IsChecked="{Binding DataTrimWhitespace}"
								ToolTip.Tip="Treat 'abc' and 'abc   ' as equal (e.g. CHAR padding)" />
					  <TextBlock Classes="hint" TextWrapping="Wrap" Text="Applied on the next Compare data." />
					</StackPanel>
				  </Flyout>
				</Button.Flyout>
			  </Button>
			  <Button Content="Export ▾" IsEnabled="{Binding CanExportDataReport}" IsVisible="{Binding !IsFullDataSetsView}">
				<Button.Flyout>
				  <MenuFlyout>
					<MenuItem Header="HTML report (.html)…" Click="OnExportDataHtml" />
					<MenuItem Header="Markdown report (.md)…" Click="OnExportDataMarkdown" />
				  </MenuFlyout>
				</Button.Flyout>
			  </Button>
			  <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowDataFilters}">
				<CheckBox Content="{Binding DifferentRowsLabel}" IsChecked="{Binding ShowDifferentRows}" Margin="0,0,10,0" />
				<CheckBox Content="{Binding OnlyLeftRowsLabel}" IsChecked="{Binding ShowOnlyLeftRows}" Margin="0,0,10,0" />
				<CheckBox Content="{Binding OnlyRightRowsLabel}" IsChecked="{Binding ShowOnlyRightRows}" Margin="0,0,10,0" />
				<CheckBox Content="{Binding SameRowsLabel}" IsChecked="{Binding ShowSameRows}" Margin="0,0,10,0" />
				<TextBox Width="160" Text="{Binding DataKeyFilter}" Watermark="Find key..." />
			  </StackPanel>
			</WrapPanel>

			<WrapPanel IsVisible="{Binding !IsFullDataSetsView}" Margin="0,0,0,4">
			  <WrapPanel IsVisible="{Binding ShowDataFilters}" Margin="0,0,12,0">
			  <WrapPanel IsVisible="{Binding HasColumnDifferences}">
				<TextBlock Classes="hint" Text="Differing columns:" VerticalAlignment="Center" Margin="0,0,6,4" />
				<ItemsControl ItemsSource="{Binding ColumnDifferences}">
				  <ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
					  <WrapPanel />
					</ItemsPanelTemplate>
				  </ItemsControl.ItemsPanel>
				  <ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="models:ColumnDifferenceCount">
					  <Button Classes="chip" Command="{Binding #root.DataContext.FilterByColumnCommand}" CommandParameter="{Binding Column}"
							  ToolTip.Tip="Show only rows where this column differs (click again to clear)">
						<TextBlock>
						  <Run Text="{Binding Column}" FontWeight="SemiBold" />
						  <Run Text="{Binding Count, StringFormat=' {0:N0}'}" />
						</TextBlock>
					  </Button>
					</DataTemplate>
				  </ItemsControl.ItemTemplate>
				</ItemsControl>
				<Button Classes="chip" Content="✕ Clear" IsVisible="{Binding HasDataColumnFilter}" Command="{Binding FilterByColumnCommand}" />
			  </WrapPanel>
			  </WrapPanel>
			  <TextBlock Classes="hint" VerticalAlignment="Center" Margin="0,0,0,4" Text="{Binding DataInfo}" TextWrapping="Wrap" />
			</WrapPanel>
		  </StackPanel>

		  <DataGrid Grid.Row="1" ItemsSource="{Binding DataDiff}" IsReadOnly="True" AutoGenerateColumns="False"
					CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
					IsVisible="{Binding IsSummaryView}">
			<DataGrid.Styles>
			  <Style Selector="DataGridRow">
				<Setter Property="Background" Value="{Binding Status, Converter={StaticResource RowStatusBrush}}" />
			  </Style>
			</DataGrid.Styles>
			<DataGrid.Columns>
			  <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="220" />
			  <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" SortMemberPath="Status" Width="Auto" />
			  <DataGridTextColumn Header="# cols" Binding="{Binding DifferentColumnCount}" Width="Auto" />
			  <DataGridTextColumn Header="Differences" Binding="{Binding Summary}" Width="*" />
			</DataGrid.Columns>
		  </DataGrid>

		  <views:DataComparisonGridView Grid.Row="1" Rows="{Binding DataDiff}"
										ShowLeft="{Binding IsLeftPanelVisible}" ShowRight="{Binding IsRightPanelVisible}"
										IsVisible="{Binding IsSideBySideView}" />

		  <Grid Grid.Row="1" ColumnDefinitions="*,*" IsVisible="{Binding IsFullDataSetsView}">
			<Grid Grid.Column="0" RowDefinitions="Auto,*" IsVisible="{Binding IsLeftPanelVisible}" Margin="0,0,4,0">
			  <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,2">
				<TextBlock Text="Left" FontWeight="SemiBold" VerticalAlignment="Center" />
				<Button Classes="compact" Content="Load" Command="{Binding LoadLeftDataCommand}" />
				<TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding LeftDataStatus}" />
			  </StackPanel>
			  <views:ResultGridView Grid.Row="1" ResultSet="{Binding LeftDataResult}" />
			</Grid>

			<Grid Grid.Column="1" RowDefinitions="Auto,*" IsVisible="{Binding IsRightPanelVisible}" Margin="4,0,0,0">
			  <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,2">
				<TextBlock Text="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
				<Button Classes="compact" Content="Load" Command="{Binding LoadRightDataCommand}" />
				<TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding RightDataStatus}" />
			  </StackPanel>
			  <views:ResultGridView Grid.Row="1" ResultSet="{Binding RightDataResult}" />
			</Grid>
		  </Grid>
		</Grid>
	  </TabItem>
	  <!-- Create the left object on the right, or synchronize its data / definition -->
	  <TabItem Header="Copy &amp; sync">
		<Panel>
		<Grid RowDefinitions="Auto,Auto,Auto,Auto,*" IsVisible="{Binding !IsCopyBatchMode}">
		  <!-- Where the copy goes -->
		  <WrapPanel Grid.Row="0" Classes="toolbar">
			<TextBlock Text="Copy the left object to" FontWeight="SemiBold" />
			<TextBox Width="140" Text="{Binding CopyTargetSchema}" Watermark="schema"
					 ToolTip.Tip="Schema on the right; created when missing" />
			<TextBlock Text="." />
			<TextBox Width="260" Text="{Binding CopyTargetName}" Watermark="name"
					 ToolTip.Tip="Name on the right. Defaults to the left name; change it to copy a table under another name (e.g. a backup copy)" />
			<TextBlock Classes="hint" Text="{Binding CopyTargetInfo}" TextWrapping="Wrap" />
			<Button Content="{Binding CreateRightDatabaseLabel}" Command="{Binding CreateRightDatabaseCommand}"
					IsVisible="{Binding HasMissingRightDatabase}"
					ToolTip.Tip="The left database does not exist on the right server: create it (empty) first, then copy into it" />
		  </WrapPanel>

		  <!-- What was found and what is suggested -->
		  <Border Grid.Row="1" Classes="card" Margin="0,0,0,6">
			<StackPanel Spacing="4">
			  <TextBlock Text="{Binding CopySummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
			  <TextBlock Classes="hint" Text="{Binding CopyColumnInfo}" TextWrapping="Wrap" IsVisible="{Binding HasCopyColumnInfo}" />
			  <TextBlock Classes="hint" Text="{Binding CopyWarningsText}" TextWrapping="Wrap" IsVisible="{Binding HasCopyWarnings}" />
			</StackPanel>
		  </Border>

		  <!-- Action and its options -->
		  <StackPanel Grid.Row="2" IsVisible="{Binding HasCopyActions}">
			<WrapPanel Classes="toolbar">
			  <TextBlock Text="Action:" />
			  <ComboBox Width="260" ItemsSource="{Binding CopyActions}" SelectedItem="{Binding SelectedCopyAction}">
				<ComboBox.ItemTemplate>
				  <DataTemplate x:DataType="vm:CopyActionOption">
					<TextBlock Text="{Binding Label}" />
				  </DataTemplate>
				</ComboBox.ItemTemplate>
			  </ComboBox>
			  <TextBlock Classes="hint" Text="{Binding SelectedCopyActionDescription}" TextWrapping="Wrap" MaxWidth="820" />
			</WrapPanel>

			<WrapPanel Classes="toolbar">
			  <CheckBox Content="Copy data" IsChecked="{Binding CopyIncludeData}" IsVisible="{Binding ShowCreateTableOptions}"
						ToolTip.Tip="Copy the rows too, not only the structure" />
			  <CheckBox Content="Indexes" IsChecked="{Binding CopyIndexes}" IsVisible="{Binding ShowCreateTableOptions}"
						ToolTip.Tip="Create the left table's indexes (after the data, which is faster)" />
			  <CheckBox Content="Foreign keys" IsChecked="{Binding CopyForeignKeys}" IsVisible="{Binding ShowCreateTableOptions}"
						ToolTip.Tip="Create the foreign keys whose referenced table exists on the right (or is created by this copy)" />
			  <CheckBox Content="Defaults &amp; checks" IsChecked="{Binding CopyDefaultsAndChecks}" IsVisible="{Binding ShowCreateTableOptions}"
						ToolTip.Tip="Copy column defaults and check constraints. Across engines only literals, current time and new-uuid defaults are translated; check constraints need the same engine" />
			  <CheckBox Content="Include missing parent tables" IsChecked="{Binding CopyIncludeParents}" IsVisible="{Binding ShowParentsOption}"
						ToolTip.Tip="Also create the referenced tables that are missing on the right (with their rows), parents first, so every foreign key can be created" />
			  <CheckBox Content="Update changed rows" IsChecked="{Binding CopyUpdateChanged}" IsVisible="{Binding ShowMergeOptions}"
						ToolTip.Tip="Rows present on both sides with different values are overwritten with the left values" />
			  <CheckBox Content="Delete rows only on the right" IsChecked="{Binding CopyDeleteExtra}" IsVisible="{Binding ShowMergeOptions}"
						ToolTip.Tip="Makes the right an exact copy of the left (within the row filter)" />
			  <CheckBox Content="Add missing columns" IsChecked="{Binding CopyAddMissingColumns}" IsVisible="{Binding ShowAddColumnsOption}"
						ToolTip.Tip="Columns that exist only on the left are added to the right table (nullable) before the data is copied" />
			  <CheckBox Content="Back up right table first" IsChecked="{Binding CopyBackupTarget}" IsVisible="{Binding ShowBackupOption}"
						ToolTip.Tip="Copies the current right table to NAME_backup_yyyyMMdd_HHmmss before changing it (on by default for production)" />
			</WrapPanel>

			<WrapPanel Classes="toolbar">
			  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowRowFilter}">
				<TextBlock Text="Rows where" VerticalAlignment="Center" />
				<TextBox Width="280" Text="{Binding CopyRowFilter}" Watermark="e.g. CreatedAt &gt;= '2024-01-01'"
						 ToolTip.Tip="Optional SQL condition (without WHERE). Only matching rows are read, compared, replaced or deleted, on both sides" />
			  </StackPanel>
			  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowDataOptions}">
				<TextBlock Text="Batch:" VerticalAlignment="Center" />
				<NumericUpDown Value="{Binding CopyBatchSize}" Minimum="1" Maximum="1000" Increment="100" FormatString="N0" Width="120"
							   ToolTip.Tip="Rows per INSERT statement / statements per batch" />
				<TextBlock Text="Max rows:" VerticalAlignment="Center" />
				<NumericUpDown Value="{Binding CopyMaxRows}" Minimum="1" Maximum="5000000" Increment="10000" FormatString="N0" Width="150"
							   ToolTip.Tip="Safety limit on the rows read per side; the copy stops with a message when a table has more" />
			  </StackPanel>
			  <CheckBox Content="Stream rows" IsChecked="{Binding CopyStreamRows}" IsVisible="{Binding ShowStreamOption}"
						ToolTip.Tip="Read the left rows page by page while running instead of loading them all first: no row limit and flat memory. Needs a primary key; the saved script then holds only the structure" />
			  <CheckBox Content="One transaction" IsChecked="{Binding CopySingleTransaction}"
						ToolTip.Tip="All or nothing: any error rolls everything back (MySQL commits schema changes as it goes, so those stay). Off: steps run one by one with progress, and completed steps stay applied" />
			  <CheckBox Content="Verify row counts" IsChecked="{Binding CopyVerifyAfter}" IsVisible="{Binding ShowDataOptions}"
						ToolTip.Tip="Count the rows on both sides after the copy" />
			  <CheckBox Content="Refresh right metadata" IsChecked="{Binding CopyRefreshAfter}"
						ToolTip.Tip="Re-read the right catalog after the copy so the new object and columns show up everywhere" />
			</WrapPanel>
		  </StackPanel>

		  <!-- Preview / run -->
		  <WrapPanel Grid.Row="3" Classes="toolbar" IsVisible="{Binding HasCopyActions}">
			<Button Content="Run on the right" Classes="accent" Command="{Binding RunCopyCommand}"
					ToolTip.Tip="Run the script on the right side after a confirmation (builds it first if needed)" />
			<Button Content="Copy script" Click="OnCopyScriptToClipboard" IsEnabled="{Binding HasCopySteps}"
					ToolTip.Tip="Copy the full script to the clipboard, e.g. to run it through a deployment tool" />
			<Button Content="Save script…" Click="OnSaveCopyScript" IsEnabled="{Binding HasCopySteps}" />
			<TextBlock FontWeight="SemiBold" Text="{Binding CopyPlanSummary}" TextWrapping="Wrap" />
			<TextBlock Classes="hint" Text="{Binding CopyStatus}" TextWrapping="Wrap" />
		  </WrapPanel>

		  <!-- Steps and script -->
		  <Grid Grid.Row="4" ColumnDefinitions="560,Auto,*" IsVisible="{Binding HasCopySteps}">
			<Grid Grid.Column="0" RowDefinitions="*,Auto">
			  <DataGrid ItemsSource="{Binding CopySteps}" IsReadOnly="True" AutoGenerateColumns="False"
						CanUserResizeColumns="True" CanUserSortColumns="False" GridLinesVisibility="Horizontal">
				<DataGrid.Styles>
				  <Style Selector="TextBlock.state">
					<Setter Property="Margin" Value="12,0" />
					<Setter Property="VerticalAlignment" Value="Center" />
					<Setter Property="FontWeight" Value="SemiBold" />
				  </Style>
				  <Style Selector="TextBlock.state.running">
					<Setter Property="Foreground" Value="#FF3B82F6" />
				  </Style>
				  <Style Selector="TextBlock.state.done">
					<Setter Property="Foreground" Value="#FF2E9E4F" />
				  </Style>
				  <Style Selector="TextBlock.state.failed">
					<Setter Property="Foreground" Value="#FFD9453B" />
				  </Style>
				  <Style Selector="TextBlock.state.undone">
					<Setter Property="Foreground" Value="#FFD08A00" />
				  </Style>
				</DataGrid.Styles>
				<DataGrid.Columns>
				  <DataGridTemplateColumn Header="Status" Width="120">
					<DataGridTemplateColumn.CellTemplate>
					  <DataTemplate x:DataType="vm:CopyStepItem">
						<TextBlock Classes="state" Text="{Binding StateText}"
								   Classes.running="{Binding IsRunning}" Classes.done="{Binding IsDone}"
								   Classes.failed="{Binding IsFailed}" Classes.undone="{Binding IsUndone}" />
					  </DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				  </DataGridTemplateColumn>
				  <DataGridTextColumn Header="Step" Binding="{Binding Title}" Width="2*" />
				  <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="Auto" />
				  <DataGridTemplateColumn Header="Result" Width="*">
					<DataGridTemplateColumn.CellTemplate>
					  <DataTemplate x:DataType="vm:CopyStepItem">
						<TextBlock Margin="12,0" VerticalAlignment="Center" Text="{Binding Details}" TextTrimming="CharacterEllipsis"
								   ToolTip.Tip="{Binding Details}" />
					  </DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				  </DataGridTemplateColumn>
				</DataGrid.Columns>
			  </DataGrid>
			  <TextBlock Grid.Row="1" Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
						 Text="{Binding CopyNotesText}" IsVisible="{Binding HasCopyNotes}" />
			</Grid>
			<GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" Background="Transparent" />
			<TextBox AutomationProperties.Name="Copy script" Grid.Column="2" Classes="code" Text="{Binding CopyScriptPreview}" IsReadOnly="True"
					 AcceptsReturn="True" TextWrapping="NoWrap"
					 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
		  </Grid>
		  <TextBlock Grid.Row="4" Classes="empty" IsVisible="{Binding !HasCopySteps}"
					 Text="Pick an object on the left and the target database on the right. When the object is missing on the right you can create it (with its data); when it exists you can merge the data, replace it, or drop and re-create the table. Preview shows the exact script and row counts before anything runs." />
		</Grid>

		<!-- Batch mode: several objects from the Overview tab -->
		<Grid RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding IsCopyBatchMode}">
		  <WrapPanel Grid.Row="0" Classes="toolbar">
			<TextBlock Text="{Binding BatchHeader}" FontWeight="SemiBold" TextWrapping="Wrap" />
		  </WrapPanel>
		  <WrapPanel Grid.Row="1" Classes="toolbar">
			<CheckBox Content="Copy data" IsChecked="{Binding CopyIncludeData}" ToolTip.Tip="Created tables get their rows too" />
			<CheckBox Content="Indexes" IsChecked="{Binding CopyIndexes}" />
			<CheckBox Content="Foreign keys" IsChecked="{Binding CopyForeignKeys}"
					  ToolTip.Tip="Created only when the referenced table exists on the right or is created earlier in the batch" />
			<CheckBox Content="Defaults &amp; checks" IsChecked="{Binding CopyDefaultsAndChecks}" />
			<CheckBox Content="Update changed rows" IsChecked="{Binding CopyUpdateChanged}" ToolTip.Tip="For tables that are merged" />
			<CheckBox Content="Delete rows only on the right" IsChecked="{Binding CopyDeleteExtra}" ToolTip.Tip="For tables that are merged" />
			<CheckBox Content="Add missing columns" IsChecked="{Binding CopyAddMissingColumns}" />
			<CheckBox Content="Back up right tables first" IsChecked="{Binding CopyBackupTarget}" />
			<CheckBox Content="Stream rows" IsChecked="{Binding CopyStreamRows}" />
			<CheckBox Content="One transaction per object" IsChecked="{Binding CopySingleTransaction}" />
			<CheckBox Content="Verify row counts" IsChecked="{Binding CopyVerifyAfter}" />
			<CheckBox Content="Continue after a failure" IsChecked="{Binding BatchContinueOnError}" />
			<CheckBox Content="Refresh right metadata" IsChecked="{Binding CopyRefreshAfter}" />
		  </WrapPanel>
		  <WrapPanel Grid.Row="2" Classes="toolbar">
			<Button Content="Run batch" Classes="accent" Command="{Binding RunBatchCommand}"
					ToolTip.Tip="Copy the ticked objects in the order shown, after one confirmation" />
			<Button Content="Back to single object" Command="{Binding ExitBatchCommand}" />
			<TextBlock Classes="hint" Text="{Binding CopyStatus}" TextWrapping="Wrap" />
		  </WrapPanel>
		  <DataGrid Grid.Row="3" ItemsSource="{Binding BatchItems}" AutoGenerateColumns="False" CanUserSortColumns="False"
					CanUserResizeColumns="True" GridLinesVisibility="Horizontal">
			<DataGrid.Columns>
			  <DataGridTemplateColumn Header="" Width="40">
				<DataGridTemplateColumn.CellTemplate>
				  <DataTemplate x:DataType="vm:BatchCopyItem">
					<CheckBox AutomationProperties.Name="Include" IsChecked="{Binding Include}" IsEnabled="{Binding CanCopy}" HorizontalAlignment="Center" Margin="8,0,0,0" />
				  </DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			  </DataGridTemplateColumn>
			  <DataGridTextColumn Header="Object" Binding="{Binding FullName}" Width="240" IsReadOnly="True" />
			  <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="110" IsReadOnly="True" />
			  <DataGridTemplateColumn Header="Action" Width="230">
				<DataGridTemplateColumn.CellTemplate>
				  <DataTemplate x:DataType="vm:BatchCopyItem">
					<ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" IsEnabled="{Binding CanCopy}"
							  HorizontalAlignment="Stretch" Margin="2">
					  <ComboBox.ItemTemplate>
						<DataTemplate x:DataType="vm:CopyActionOption">
						  <TextBlock Text="{Binding Label}" />
						</DataTemplate>
					  </ComboBox.ItemTemplate>
					</ComboBox>
				  </DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			  </DataGridTemplateColumn>
			  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" IsReadOnly="True" />
			  <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" IsReadOnly="True" />
			</DataGrid.Columns>
		  </DataGrid>
		</Grid>
		</Panel>
	  </TabItem>

	  <!-- One reviewed script that makes the right database's schema match the left's -->
	  <TabItem Header="Migration">
		<Grid RowDefinitions="Auto,Auto,Auto,*">
		  <WrapPanel Grid.Row="0" Classes="toolbar">
			<CheckBox Content="Drop what only the right has" IsChecked="{Binding MigrationDropExtras}"
					  ToolTip.Tip="Also drop tables, columns, keys, indexes, views and routines that exist only on the right. Off: they are left alone and listed at the end of the script as comments" />
			<CheckBox Content="{Binding MigrationOnlySelectedLabel}" IsChecked="{Binding MigrationOnlySelected}"
					  ToolTip.Tip="Script only the objects selected on the Overview tab (Ctrl/Shift-click there)" />
			<Button Content="Copy" Command="{Binding CopyMigrationCommand}" ToolTip.Tip="Copy the script to the clipboard" />
			<Button Content="Save .sql…" Click="OnSaveMigrationScript" IsEnabled="{Binding HasMigration}"
					ToolTip.Tip="Save the script as a .sql file, e.g. for a deployment pipeline or a review" />
			<Panel ToolTip.Tip="{Binding OpenMigrationTip}">
			  <Button Content="Open in Query tab" Command="{Binding OpenMigrationInQueryCommand}" />
			</Panel>
		  </WrapPanel>
		  <TextBlock Grid.Row="1" Classes="hint" Margin="4,0,4,4" TextWrapping="Wrap" Text="{Binding MigrationDirection}" FontWeight="SemiBold" />
		  <TextBlock Grid.Row="2" Classes="hint" Margin="4,0,4,4" TextWrapping="Wrap" Text="{Binding MigrationStatus}"
					 IsVisible="{Binding MigrationStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

		  <Grid Grid.Row="3" ColumnDefinitions="11*,Auto,10*" IsVisible="{Binding HasMigration}">
			<Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
			  <CheckBox Grid.Row="0" Content="Show objects that already match" IsChecked="{Binding ShowUnchangedMigrationItems}" Margin="0,0,0,4" />
			  <DataGrid Grid.Row="1" ItemsSource="{Binding MigrationItems}" IsReadOnly="True" AutoGenerateColumns="False"
						CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
				<DataGrid.Styles>
				  <Style Selector="TextBlock.action">
					<Setter Property="Margin" Value="12,0" />
					<Setter Property="VerticalAlignment" Value="Center" />
					<Setter Property="FontWeight" Value="SemiBold" />
				  </Style>
				  <Style Selector="TextBlock.action.create">
					<Setter Property="Foreground" Value="#FF2E9E4F" />
				  </Style>
				  <Style Selector="TextBlock.action.change">
					<Setter Property="Foreground" Value="#FF3B82F6" />
				  </Style>
				  <Style Selector="TextBlock.action.drop">
					<Setter Property="Foreground" Value="#FFD9453B" />
				  </Style>
				  <Style Selector="TextBlock.action.manual">
					<Setter Property="Foreground" Value="#FFD08A00" />
				  </Style>
				</DataGrid.Styles>
				<DataGrid.Columns>
				  <DataGridTemplateColumn Header="Action" SortMemberPath="Action" Width="90">
					<DataGridTemplateColumn.CellTemplate>
					  <DataTemplate x:DataType="compare:MigrationItem">
						<TextBlock Classes="action" Text="{Binding Action, Converter={x:Static conv:HumanizeConverter.Instance}}"
								   Classes.create="{Binding IsCreate}" Classes.change="{Binding IsChange}"
								   Classes.drop="{Binding IsDrop}" Classes.manual="{Binding IsManual}" />
					  </DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				  </DataGridTemplateColumn>
				  <DataGridTemplateColumn Header="Type" SortMemberPath="Type" Width="120">
					<DataGridTemplateColumn.CellTemplate>
					  <DataTemplate x:DataType="compare:MigrationItem">
						<controls:ObjectTypeBadge Type="{Binding Type}" Margin="10,0" />
					  </DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				  </DataGridTemplateColumn>
				  <DataGridTextColumn Header="Object" Binding="{Binding FullName}" Width="180" />
				  <DataGridTemplateColumn Header="Details" Width="*">
					<DataGridTemplateColumn.CellTemplate>
					  <DataTemplate x:DataType="compare:MigrationItem">
						<TextBlock Margin="12,0" VerticalAlignment="Center" Text="{Binding Details}" TextTrimming="CharacterEllipsis"
								   ToolTip.Tip="{Binding Details}" />
					  </DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				  </DataGridTemplateColumn>
				</DataGrid.Columns>
			  </DataGrid>
			  <ScrollViewer Grid.Row="2" MaxHeight="140" Margin="0,4,0,0" IsVisible="{Binding HasMigrationWarnings}">
				<ItemsControl ItemsSource="{Binding MigrationWarnings}">
				  <ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="x:String">
					  <TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Foreground="#FFD08A00" Margin="0,0,0,2" />
					</DataTemplate>
				  </ItemsControl.ItemTemplate>
				</ItemsControl>
			  </ScrollViewer>
			</Grid>
			<GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" Background="Transparent" />
			<TextBox AutomationProperties.Name="Migration script" Grid.Column="2" Classes="code" Text="{Binding MigrationScript}" IsReadOnly="True"
					 AcceptsReturn="True" TextWrapping="NoWrap"
					 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
		  </Grid>
		  <TextBlock Grid.Row="3" Classes="empty" IsVisible="{Binding !HasMigration}"
					 Text="Connect both sides and pick their databases, then Generate script. The script makes the right database's schema match the left's: it creates missing tables, views and routines, alters tables that differ, and replaces changed views and routines, in an order that runs. Nothing runs here: review it, then save it, copy it, or open it in a Query tab." />
		</Grid>
	  </TabItem>
	</TabControl>

	<!-- Status bar: progress, the last message, and what to do next -->
	<Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}" Margin="0,4,0,0" Padding="0,3">
	  <DockPanel Height="26">
		<ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" MinWidth="80" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
		<Button DockPanel.Dock="Left" Classes="compact" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"
				VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="Stop the running comparison or copy (Esc)" />
		<TextBlock DockPanel.Dock="Right" Classes="next" VerticalAlignment="Center" IsVisible="{Binding HasNextStepHint}"
				   TextTrimming="CharacterEllipsis" MaxWidth="560" Margin="12,0,0,0" ToolTip.Tip="{Binding NextStepHint}"
				   Text="{Binding NextStepHint, StringFormat='→ {0}'}" />
		<TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
				   Margin="8,0,0,0" ToolTip.Tip="{Binding Status}" />
	  </DockPanel>
	</Border>
  </Grid>
</UserControl>
