<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="DbExplorer.Desktop.Views.ConfirmWindow"
		Title="Confirm"
		Width="440" SizeToContent="Height"
		WindowStartupLocation="CenterOwner"
		CanResize="False">
  <StackPanel Margin="16" Spacing="14">
	<TextBlock x:Name="MessageText" TextWrapping="Wrap" />
	<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
	  <Button Content="Cancel" Click="OnCancel" />
	  <Button x:Name="ConfirmButton" Content="Run" Classes="accent" Click="OnConfirm" />
	</StackPanel>
  </StackPanel>
</Window>
