<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DbExplorer.Desktop.Controls"
        xmlns:conv="using:DbExplorer.Desktop.Converters"
        x:Class="DbExplorer.Desktop.Views.ConnectionDialog"
        Title="Connection"
        Width="560" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <!-- Small caption above each field: labels stay readable without a wide label column -->
    <Style Selector="TextBlock.field">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="StackPanel.form > TextBlock.section:nth-child(1)">
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Environment color strip, same colors as the main window banner -->
    <Border DockPanel.Dock="Top" Height="4"
            Background="{Binding Environment, Converter={x:Static conv:EnvironmentToBrushConverter.Instance}}" />

    <!-- Footer: status on the left, actions on the right -->
    <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource AppHintForegroundBrush}" Background="{DynamicResource AppCodeBackgroundBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Content="Test connection" Command="{Binding TestCommand}" />
        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="4">
          <TextBlock Classes="hint" Text="{Binding Message}" TextWrapping="Wrap" MaxLines="2"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" MinHeight="3" Height="3" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
          <Button Content="Save" Classes="accent" MinWidth="72" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="Tabs" Margin="12,6,12,0" Padding="0">
    <TabItem Header="General">
    <StackPanel Classes="form" Margin="8,10,8,18">
      <!-- General -->
      <TextBlock Classes="section" Text="General" />
      <Grid ColumnDefinitions="*,12,150">
        <StackPanel Grid.Column="0">
          <TextBlock Classes="field" Text="Name" />
          <TextBox Text="{Binding Name}" Watermark="host/database if empty" />
          <TextBlock Classes="field" Text="Folder" />
          <AutoCompleteBox Text="{Binding Folder}" ItemsSource="{Binding Folders}" FilterMode="ContainsOrdinal"
                           MinimumPrefixLength="0" Watermark="none (e.g. Shop or Clients/Acme)"
                           ToolTip.Tip="Groups connections in the list; use / for a folder inside a folder" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Classes="field" Text="Environment" />
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Environments}" SelectedItem="{Binding Environment}"
                    ToolTip.Tip="Tags the connection with a colored banner; Production also asks you to type a confirmation before running write scripts">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{Binding Converter={x:Static conv:EnvironmentToBrushConverter.Instance}}" />
                  <TextBlock Text="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>

      <!-- Server -->
      <TextBlock Classes="section" Text="Server" />
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="195,12,*,12,112">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="field" Text="Engine" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Providers}"
                      SelectedItem="{Binding SelectedProvider}" DisplayMemberBinding="{Binding DisplayName}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="field" Text="Host" />
            <TextBox Text="{Binding Host}" Watermark="{Binding HostHint}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Classes="field" Text="Port" />
            <TextBox Text="{Binding Port}" Watermark="{Binding PortHint}" />
          </StackPanel>
        </Grid>
        <StackPanel>
          <TextBlock Classes="field" Text="Database" />
          <TextBox x:Name="DatabaseBox" Text="{Binding Database}" Watermark="server default if empty">
            <TextBox.InnerRightContent>
              <Button x:Name="BrowseDatabases" Content="Browse ▾" Padding="8,0" MinHeight="0" Margin="0,0,2,0"
                      VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                      Background="Transparent" BorderThickness="0"
                      Command="{Binding LoadDatabasesCommand}"
                      ToolTip.Tip="List the databases on the server">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <Panel Width="280">
                      <controls:NameFilterList x:Name="DatabaseList" MaxListHeight="280"
                                               ItemsSource="{Binding Databases}" IsVisible="{Binding !!Databases.Count}" />
                      <TextBlock Classes="hint" Margin="8" Text="{Binding Message}" TextWrapping="Wrap"
                                 IsVisible="{Binding !Databases.Count}" />
                    </Panel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
        </StackPanel>
      </StackPanel>

      <!-- Sign-in -->
      <TextBlock Classes="section" Text="Sign-in" />
      <StackPanel Spacing="8">
        <CheckBox Content="Integrated security (Windows / Kerberos)"
                  IsChecked="{Binding IntegratedSecurity}" IsEnabled="{Binding CanUseIntegratedSecurity}" />
        <Grid ColumnDefinitions="*,12,*" IsEnabled="{Binding !IntegratedSecurity}">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="field" Text="User" />
            <TextBox Text="{Binding UserName}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="field" Text="Password" />
            <TextBox Text="{Binding Password}" PasswordChar="•" RevealPassword="{Binding #RevealPassword.IsChecked}">
              <TextBox.InnerRightContent>
                <ToggleButton x:Name="RevealPassword" Content="👁" Padding="6,0" MinHeight="0" Margin="0,0,2,0"
                              Background="Transparent" BorderThickness="0" Focusable="False"
                              ToolTip.Tip="Show password" />
              </TextBox.InnerRightContent>
            </TextBox>
          </StackPanel>
        </Grid>
        <CheckBox Content="Save password" IsChecked="{Binding SavePassword}" IsEnabled="{Binding !IntegratedSecurity}"
                  ToolTip.Tip="Encrypted for the current Windows user (DPAPI). Not saved on macOS/Linux: the app asks on connect." />
      </StackPanel>

      <!-- Options -->
      <TextBlock Classes="section" Text="Options" />
      <WrapPanel>
        <CheckBox Content="Encrypt (TLS)" IsChecked="{Binding Encrypt}" Margin="0,0,14,4"
                  ToolTip.Tip="Require an encrypted SSL/TLS connection" />
        <CheckBox Content="Trust certificate" IsChecked="{Binding TrustServerCertificate}" Margin="0,0,14,4"
                  ToolTip.Tip="Accept the server's certificate without validating its chain (self-signed certificates)" />
        <CheckBox Content="Read-only intent" IsChecked="{Binding ReadOnlyIntent}" IsEnabled="{Binding CanUseReadOnlyIntent}"
                  Margin="0,0,14,4"
                  ToolTip.Tip="ApplicationIntent=ReadOnly: Availability Group listeners route the app to a readable secondary" />
        <CheckBox Content="Read-only (block writes)" IsChecked="{Binding ReadOnly}" Margin="0,0,14,4"
                  ToolTip.Tip="Nothing that changes data or schema runs on this connection: write scripts, result edits, table creation, copies and procedures are refused. PostgreSQL also opens its sessions read-only." />
      </WrapPanel>
    </StackPanel>
    </TabItem>

    <TabItem>
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="SSH" />
          <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource SystemAccentColor}"
                   IsVisible="{Binding UseSsh}" ToolTip.Tip="This connection goes through an SSH tunnel" />
        </StackPanel>
      </TabItem.Header>
      <StackPanel Classes="form" Margin="8,10,8,18">
        <TextBlock Classes="section" Text="Tunnel" />
        <CheckBox Content="Connect through an SSH tunnel" IsChecked="{Binding UseSsh}" />
        <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="The app signs in to the SSH server and forwards a local port to the database. Host and Port on the General tab are then the database as the SSH server sees it, often localhost." />

        <StackPanel IsEnabled="{Binding UseSsh}">
          <TextBlock Classes="section" Text="SSH server" />
          <Grid ColumnDefinitions="*,12,112">
            <StackPanel Grid.Column="0">
              <TextBlock Classes="field" Text="Host" />
              <TextBox Text="{Binding SshHost}" Watermark="bastion.example.com" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="field" Text="Port" />
              <TextBox Text="{Binding SshPort}" Watermark="default 22" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="field" Text="User" Margin="0,10,0,3" />
          <TextBox Text="{Binding SshUserName}" />

          <TextBlock Classes="section" Text="Sign-in" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton GroupName="SshAuth" Content="Password" IsChecked="{Binding SshUsePassword}" />
            <RadioButton GroupName="SshAuth" Content="Private key" IsChecked="{Binding SshUseKey}" />
          </StackPanel>

          <StackPanel Margin="0,8,0,0" IsVisible="{Binding SshUsePassword}">
            <TextBlock Classes="field" Text="Password" />
            <TextBox Text="{Binding SshPassword}" PasswordChar="•" RevealPassword="{Binding #RevealSshPassword.IsChecked}">
              <TextBox.InnerRightContent>
                <ToggleButton x:Name="RevealSshPassword" Content="👁" Padding="6,0" MinHeight="0" Margin="0,0,2,0"
                              Background="Transparent" BorderThickness="0" Focusable="False"
                              ToolTip.Tip="Show password" />
              </TextBox.InnerRightContent>
            </TextBox>
          </StackPanel>

          <StackPanel Margin="0,8,0,0" Spacing="10" IsVisible="{Binding SshUseKey}">
            <StackPanel>
              <TextBlock Classes="field" Text="Private key file" />
              <TextBox Text="{Binding SshKeyPath}" Watermark="e.g. ~/.ssh/id_ed25519 (OpenSSH, PEM or PuTTY .ppk)">
                <TextBox.InnerRightContent>
                  <Button Content="Browse…" Padding="8,0" MinHeight="0" Margin="0,0,2,0"
                          VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                          Background="Transparent" BorderThickness="0" Click="OnBrowseKey"
                          ToolTip.Tip="Choose the private key file" />
                </TextBox.InnerRightContent>
              </TextBox>
            </StackPanel>
            <StackPanel>
              <TextBlock Classes="field" Text="Passphrase" />
              <TextBox Text="{Binding SshPassphrase}" PasswordChar="•" Watermark="empty if the key has none"
                       RevealPassword="{Binding #RevealPassphrase.IsChecked}">
                <TextBox.InnerRightContent>
                  <ToggleButton x:Name="RevealPassphrase" Content="👁" Padding="6,0" MinHeight="0" Margin="0,0,2,0"
                                Background="Transparent" BorderThickness="0" Focusable="False"
                                ToolTip.Tip="Show passphrase" />
                </TextBox.InnerRightContent>
              </TextBox>
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="Save password on the General tab also saves the SSH password and passphrase, encrypted the same way. The server's host key is shown for you to accept the first time and remembered after that." />
        </StackPanel>
      </StackPanel>
    </TabItem>
    </TabControl>
  </DockPanel>
</Window>
