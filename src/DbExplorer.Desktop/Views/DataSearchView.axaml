<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DbExplorer.Desktop.Views.DataSearchView">
  <Grid Margin="4" RowDefinitions="Auto,Auto,*,6,Auto">
    <WrapPanel Grid.Row="0" Classes="toolbar">
      <TextBox x:Name="TermBox" Width="340" Text="{Binding Term}" Watermark="Value to find in any column…" />
      <ComboBox Width="130" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" ToolTip.Tip="Match mode" />
      <Button Content="Search" Classes="accent" Command="{Binding StartCommand}" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Content="Options ▾" ToolTip.Tip="Schemas, table filter, limits, timeouts and column kinds">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
      <WrapPanel Margin="0,4,0,0" MaxWidth="560">
        <WrapPanel.Styles>
          <Style Selector="StackPanel.field">
            <Setter Property="Margin" Value="0,0,14,6" />
            <Setter Property="Spacing" Value="2" />
          </Style>
        </WrapPanel.Styles>
        <StackPanel Classes="field">
          <TextBlock Classes="hint" Text="Schemas (comma-separated)" />
          <TextBox Width="180" Text="{Binding Schemas}" Watermark="all" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="hint" Text="Table name contains" />
          <TextBox Width="160" Text="{Binding TableFilter}" Watermark="all" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="hint" Text="Max rows / table" />
          <NumericUpDown Width="120" Value="{Binding MaxMatchesPerTable}" Minimum="1" Maximum="10000" Increment="10" FormatString="0" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="hint" Text="Parallel queries" />
          <NumericUpDown Width="110" Value="{Binding Parallelism}" Minimum="1" Maximum="16" Increment="1" FormatString="0" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="hint" Text="Query timeout (s)" />
          <NumericUpDown Width="110" Value="{Binding QueryTimeoutSeconds}" Minimum="1" Maximum="3600" Increment="5" FormatString="0" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="hint" Text="Lock timeout (ms)" />
          <NumericUpDown Width="120" Value="{Binding LockTimeoutMs}" Minimum="0" Maximum="60000" Increment="250" FormatString="0" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="hint" Text="Skip tables above (rows)" />
          <NumericUpDown Width="150" Value="{Binding MaxTableRows}" Minimum="0" Increment="100000" FormatString="N0" Watermark="no limit" />
        </StackPanel>
        <StackPanel Classes="field" VerticalAlignment="Bottom">
          <CheckBox Content="Views too" IsChecked="{Binding IncludeViews}" />
        </StackPanel>
        <StackPanel Classes="field" VerticalAlignment="Bottom">
          <CheckBox Content="Numeric columns (exact)" IsChecked="{Binding IncludeNumeric}" />
        </StackPanel>
        <StackPanel Classes="field" VerticalAlignment="Bottom">
          <CheckBox Content="GUID/UUID columns" IsChecked="{Binding IncludeGuid}" />
        </StackPanel>
      </WrapPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <ProgressBar Width="140" MinWidth="140" Value="{Binding Progress}" Maximum="100" />
      <TextBlock Classes="hint" Text="{Binding Status}" TextWrapping="Wrap" />
    </WrapPanel>

    <WrapPanel Grid.Row="1" Classes="toolbar">
      <Button Content="Open record" Command="{Binding OpenRecordCommand}"
              ToolTip.Tip="Show the whole found row (located by its primary key) · double-click a result" />
      <Button Content="Go to table" Command="{Binding GoToTableCommand}"
              ToolTip.Tip="Show the table in the Objects tab (columns, keys, indexes, definition)" />
      <Button Content="Record SQL" Command="{Binding OpenRecordSqlCommand}"
              ToolTip.Tip="Open a SELECT of the found row in a new Query tab" />
      <Button Content="Relations &amp; combined data" Classes="accent" Command="{Binding ShowRelationsCommand}"
              ToolTip.Tip="Diagram of the tables the value was found in and how they relate, with their rows joined along foreign keys. Uses the selected results when several are selected, otherwise all." />
      <TextBlock Classes="hint" Text="{Binding FoundInSummary}" />
    </WrapPanel>

    <DataGrid x:Name="ResultsGrid" Grid.Row="2" ItemsSource="{Binding Matches}"
              SelectedItem="{Binding SelectedMatch}" SelectionMode="Extended"
              IsReadOnly="True" AutoGenerateColumns="False"
              CanUserResizeColumns="True" CanUserSortColumns="True"
              GridLinesVisibility="Horizontal">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Open record" Command="{Binding OpenRecordCommand}" />
          <MenuItem Header="Go to table" Command="{Binding GoToTableCommand}" />
          <MenuItem Header="Open record SQL in Query tab" Command="{Binding OpenRecordSqlCommand}" />
          <Separator />
          <MenuItem Header="Relations &amp; combined data" Command="{Binding ShowRelationsCommand}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="Auto" />
        <DataGridTextColumn Header="Schema" Binding="{Binding Schema}" Width="Auto" />
        <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="200" />
        <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="160" />
        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
        <DataGridTextColumn Header="Row key" Binding="{Binding RowKey}" Width="200" />
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="3" ResizeDirection="Rows" Background="Transparent" />

    <Expander Grid.Row="4" Header="{Binding Skipped.Count, StringFormat='Skipped tables: {0} (timeouts, locks, errors)'}" HorizontalAlignment="Stretch" MinHeight="0" Padding="4">
      <DataGrid ItemsSource="{Binding Skipped}" MaxHeight="220"
                IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Schema" Binding="{Binding Schema}" Width="Auto" />
          <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="220" />
          <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Expander>
  </Grid>
</UserControl>
