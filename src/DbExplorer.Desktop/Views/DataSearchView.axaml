<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DbExplorer.Desktop.Controls"
             xmlns:conv="using:DbExplorer.Desktop.Converters"
             x:Class="DbExplorer.Desktop.Views.DataSearchView">
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The scope pickers look like the inputs next to them, not like buttons -->
    <Style Selector="controls|MultiNamePicker > Button">
      <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.field">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="MaxWidth" Value="320" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
    </Style>
    <Style Selector="Border.field.match">
      <Setter Property="Background" Value="{DynamicResource AppSearchHitBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource AppKeycapBrush}" />
    </Style>
    <Style Selector="ListBox.tables ListBoxItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="0,0,0,1" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="Button.warning">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppPlanWarningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppPlanWarningBrush}" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="8,6,8,4" RowDefinitions="Auto,Auto,Auto,*">

    <!-- 1. What to find -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,0.3*" Margin="0,0,0,6">
      <TextBox x:Name="TermBox" Grid.Column="0" MinWidth="240" MinHeight="34" FontSize="14"
               VerticalContentAlignment="Center"
               Text="{Binding Term}" Watermark="Value to find in any column: an email, an order number, a name, a GUID…"
               AutomationProperties.Name="Value to find">
        <TextBox.InnerLeftContent>
          <controls:StrokeIcon Data="{x:Static controls:Icons.Search}" Width="16" Height="16" Margin="10,0,2,0"
                               Foreground="{DynamicResource AppHintForegroundBrush}" />
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
          <Button x:Name="RecentButton" Classes="icon" Background="Transparent" BorderThickness="0" Margin="0,0,2,0"
                  IsVisible="{Binding RecentTerms.Count}"
                  ToolTip.Tip="Recent searches" AutomationProperties.Name="Recent searches">
            <controls:StrokeIcon Data="{x:Static controls:Icons.ChevronDown}" Width="14" Height="14" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel MinWidth="260" Spacing="4">
                  <TextBlock Classes="caption" Text="Recent searches" Margin="4,0,0,2" />
                  <ListBox x:Name="RecentList" ItemsSource="{Binding RecentTerms}" SelectedItem="{Binding SelectedRecentTerm}"
                           MaxHeight="300" AutomationProperties.Name="Recent searches" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </TextBox.InnerRightContent>
      </TextBox>
      <ComboBox Grid.Column="1" Width="140" MinHeight="34" Margin="8,0,0,0" VerticalContentAlignment="Center"
                ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                ToolTip.Tip="How the value has to match: anywhere in the text, at its start or end, or the whole value. Numbers and GUIDs always match exactly."
                AutomationProperties.Name="Match mode">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static conv:SearchModeConverter.Instance}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Panel Grid.Column="2" Margin="8,0,0,0">
        <Button Content="Search" Classes="accent" Height="34" MinWidth="96" Padding="16,0" HorizontalContentAlignment="Center"
                Command="{Binding StartCommand}" IsVisible="{Binding !IsRunning}"
                ToolTip.Tip="Search every table (Enter)" />
        <Button Content="Stop" Height="34" MinWidth="96" Padding="16,0" HorizontalContentAlignment="Center"
                Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}"
                ToolTip.Tip="Stop searching and keep what was found (Esc)" />
      </Panel>
    </Grid>

    <!-- 2. Where to look, and the safety limits -->
    <WrapPanel Grid.Row="1" Classes="toolbar" Margin="0,0,0,4">
      <TextBlock Classes="caption" Text="Look in" Margin="0,0,8,4" />
      <controls:MultiNamePicker x:Name="SchemaPicker" Width="170" ItemsSource="{Binding SchemaChoices}" Summary="{Binding SchemaSummary}"
                                AllText="All schemas" Caption="Schemas" Watermark="Type to filter schemas…"
                                EmptyText="This connection has no schemas to pick."
                                ToolTip.Tip="Schemas to search: tick one or more. All schemas when none is ticked." />
      <controls:MultiNamePicker x:Name="TablePicker" Width="190" ItemsSource="{Binding TableChoices}" Summary="{Binding TableSummary}"
                                AllText="All tables" Caption="Tables" Watermark="Type to filter tables…"
                                EmptyText="No tables in the chosen schemas."
                                ToolTip.Tip="Tables to search, from the chosen schemas: tick one or more. All of them when none is ticked." />
      <CheckBox Content="Views" IsChecked="{Binding IncludeViews}" Margin="2,0,10,4"
                ToolTip.Tip="Search views and materialized views too (slower: they run their query)" />
      <CheckBox Content="Number columns" IsChecked="{Binding IncludeNumeric}" Margin="0,0,10,4"
                ToolTip.Tip="When the value is a number, also compare number columns (exact match)" />
      <CheckBox Content="GUID columns" IsChecked="{Binding IncludeGuid}" Margin="0,0,10,4"
                ToolTip.Tip="When the value is a GUID/UUID, also compare GUID columns (exact match)" />
      <Button Content="Reset" Classes="link" Command="{Binding ResetScopeCommand}" IsVisible="{Binding ScopeChanged}"
              ToolTip.Tip="Search every schema and table again, tables only, all column kinds" />
      <Border Width="1" Height="18" Margin="4,0,12,4" Background="{DynamicResource AppBorderBrush}" />
      <Button ToolTip.Tip="Rows per table, parallel queries, timeouts and the table size limit"
              Padding="10,0" AutomationProperties.Name="Limits">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <controls:StrokeIcon Data="{x:Static controls:Icons.Settings}" Width="13" Height="13" />
          <TextBlock Text="Limits" />
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <StackPanel Width="400" Spacing="8" Margin="2">
              <TextBlock Classes="section" Text="Safety limits" Margin="0" />
              <TextBlock Classes="hint" TextWrapping="Wrap"
                         Text="Each table is read with dirty or snapshot reads, a lock timeout and a query timeout. A table that is locked or slow is skipped, never waited on, and can be retried afterwards." />
              <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                <Grid.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                  <Style Selector="NumericUpDown">
                    <Setter Property="Margin" Value="0,0,0,6" />
                  </Style>
                </Grid.Styles>
                <TextBlock Grid.Row="0" Text="Results per table" />
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding MaxMatchesPerTable}" Minimum="1" Maximum="10000" Increment="10" FormatString="0"
                               AutomationProperties.Name="Results per table" />
                <TextBlock Grid.Row="1" Text="Tables searched at a time" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Parallelism}" Minimum="1" Maximum="16" Increment="1" FormatString="0"
                               AutomationProperties.Name="Tables searched at a time" />
                <TextBlock Grid.Row="2" Text="Query timeout (seconds)" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding QueryTimeoutSeconds}" Minimum="1" Maximum="3600" Increment="5" FormatString="0"
                               AutomationProperties.Name="Query timeout in seconds" />
                <TextBlock Grid.Row="3" Text="Lock timeout (milliseconds)" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding LockTimeoutMs}" Minimum="0" Maximum="60000" Increment="250" FormatString="0"
                               AutomationProperties.Name="Lock timeout in milliseconds" />
                <TextBlock Grid.Row="4" Text="Skip tables with more rows than" />
                <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding MaxTableRows}" Minimum="0" Increment="100000" FormatString="N0" Watermark="no limit"
                               AutomationProperties.Name="Skip tables with more rows than" />
              </Grid>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <TextBlock Classes="caption" Text="{Binding LimitsSummary}" Margin="2,0,0,4" />
    </WrapPanel>

    <!-- 3. Progress -->
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" IsVisible="{Binding HasSearched}" Margin="0,0,0,6">
      <Panel Grid.ColumnSpan="2" Height="3" Margin="0,0,0,4">
        <ProgressBar Height="3" MinHeight="3" Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsRunning}"
                     AutomationProperties.Name="Search progress" />
      </Panel>
      <TextBlock Grid.Row="1" Classes="caption" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      <Button Grid.Row="1" Grid.Column="1" Classes="warning" IsVisible="{Binding HasSkipped}"
              Command="{Binding ShowSkippedCommand}" ToolTip.Tip="Tables that timed out, were locked or failed: see why and retry them">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <controls:StrokeIcon Data="{x:Static controls:Icons.Alert}" Width="12" Height="12" Foreground="{DynamicResource AppPlanWarningBrush}" />
          <TextBlock Text="{Binding SkippedBadge}" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- 4a. Before the first search -->
    <ScrollViewer Grid.Row="3" IsVisible="{Binding ShowWelcome}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="16,40,16,16" Spacing="6">
        <controls:StrokeIcon Data="{x:Static controls:Icons.Search}" Width="36" Height="36" HorizontalAlignment="Left"
                             Foreground="{DynamicResource SystemAccentColor}" Margin="0,0,0,6" />
        <TextBlock Text="Find a value anywhere in this database" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="Type a value you know, like a customer's email or an order number, and every table is searched for it. Results show up as each table finishes, smallest tables first." />
        <Border Classes="field" MaxWidth="560" Margin="0,12,0,0" Padding="12,10">
          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="Tips" Margin="0" />
            <TextBlock TextWrapping="Wrap" Text="• Pick a result to see its whole row below the list, then open it, its SELECT, or its table." />
            <TextBlock TextWrapping="Wrap" Text="• Found it in several tables? Relations &amp; combined data joins those rows along their foreign keys." />
            <TextBlock TextWrapping="Wrap" Text="• Numbers and GUIDs are compared exactly, text by the match mode next to the search box." />
            <TextBlock TextWrapping="Wrap" Text="• Busy production database? Nothing is ever locked or waited on: slow tables are skipped and can be retried." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- 4b. Nothing found anywhere -->
    <StackPanel Grid.Row="3" IsVisible="{Binding ShowNothingFound}" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="520" Margin="16" Spacing="6">
      <controls:StrokeIcon Data="{x:Static controls:Icons.Search}" Width="32" Height="32" HorizontalAlignment="Left"
                           Foreground="{DynamicResource AppHintForegroundBrush}" Margin="0,0,0,6" />
      <TextBlock Text="{Binding NoMatchesTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Classes="hint" Text="{Binding NoMatchesHint}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 4c. Results -->
    <Grid Grid.Row="3" ColumnDefinitions="190,6,*" IsVisible="{Binding ShowResults}">

      <!-- Tables the value was found in -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Classes="caption" Text="FOUND IN" FontWeight="SemiBold" Margin="4,2,0,6" />
        <Panel>
          <ListBox x:Name="TablesList" Classes="tables" ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}"
                   Background="Transparent" AutomationProperties.Name="Tables the value was found in">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Label}">
                  <controls:StrokeIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0"
                                       Data="{x:Static controls:Icons.Table}" Foreground="{DynamicResource AppObjectTableBrush}"
                                       IsVisible="{Binding !IsAll}" />
                  <controls:StrokeIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0"
                                       Data="{x:Static controls:Icons.Database}" IsVisible="{Binding IsAll}" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Classes="tag">
                    <TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" FontSize="11.5" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="caption" TextWrapping="Wrap" Margin="4,0,8,0" VerticalAlignment="Top"
                     IsVisible="{Binding !Tables.Count}" Text="Tables with a match appear here as they are searched." />
        </Panel>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="Auto,3*,6,2*">
        <!-- Narrow the results, act on them -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
          <TextBox Grid.Column="0" Width="220" Text="{Binding ResultFilter}" Watermark="Filter results…"
                   AutomationProperties.Name="Filter results">
            <TextBox.InnerLeftContent>
              <controls:StrokeIcon Data="{x:Static controls:Icons.Search}" Width="13" Height="13" Margin="8,0,0,0"
                                   Foreground="{DynamicResource AppHintForegroundBrush}" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <TextBlock Grid.Column="1" Classes="caption" Text="{Binding FoundInSummary}" Margin="10,0" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Classes="compact" Command="{Binding ShowRelationsCommand}"
                  ToolTip.Tip="Diagram of the tables the value was found in and how they relate, with their rows joined along foreign keys. Uses the selected results when several are selected, otherwise every result shown.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <controls:StrokeIcon Data="{x:Static controls:Icons.Link}" Width="13" Height="13" />
              <TextBlock Text="Relations &amp; combined data" />
            </StackPanel>
          </Button>
        </Grid>

        <Panel Grid.Row="1">
          <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Matches}"
                    SelectedItem="{Binding SelectedMatch}" SelectionMode="Extended"
                    IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserResizeColumns="True" CanUserSortColumns="True"
                    GridLinesVisibility="Horizontal" AutomationProperties.Name="Search results">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open record" InputGesture="Enter" Command="{Binding OpenRecordCommand}" />
                <MenuItem Header="Open record SQL in Query tab" Command="{Binding OpenRecordSqlCommand}" />
                <MenuItem Header="Go to table" Command="{Binding GoToTableCommand}" />
                <Separator />
                <MenuItem Header="Copy value" Command="{Binding CopyValueCommand}" />
                <MenuItem Header="Copy row key" Command="{Binding CopyRowKeyCommand}" />
                <Separator />
                <MenuItem Header="Relations &amp; combined data" Command="{Binding ShowRelationsCommand}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Table" Binding="{Binding TableLabel}" Width="170" />
              <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="120" />
              <DataGridTemplateColumn Header="Value" Width="*" MinWidth="180" SortMemberPath="Value">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="{Binding Value}">
                      <Run Text="{Binding ValueBefore}" /><Run Text="{Binding ValueHit}" Background="{DynamicResource AppSearchHitBrush}" FontWeight="SemiBold" /><Run Text="{Binding ValueAfter}" />
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Row key" Binding="{Binding RowKey}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>

          <!-- Nothing found -->
          <StackPanel IsVisible="{Binding ShowNoMatches}" HorizontalAlignment="Center" VerticalAlignment="Center"
                      MaxWidth="460" Margin="16" Spacing="6">
            <TextBlock Text="{Binding NoMatchesTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{Binding NoMatchesHint}" TextWrapping="Wrap" />
          </StackPanel>
        </Panel>

        <GridSplitter Grid.Row="2" ResizeDirection="Rows" />

        <!-- The selected result's row, or the skipped tables -->
        <TabControl Grid.Row="3" SelectedIndex="{Binding DetailTabIndex}" Padding="0,4,0,0" MinHeight="150">
          <TabItem Header="Found row" FontSize="13">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="{Binding SelectedTitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Button Classes="compact accent" Content="Open record" Command="{Binding OpenRecordCommand}"
                          ToolTip.Tip="Open the whole row in a data window, where it can be edited (double-click a result)" />
                  <Button Classes="compact" Content="SELECT in Query tab" Command="{Binding OpenRecordSqlCommand}"
                          ToolTip.Tip="Open a SELECT of this row in a new Query tab" />
                  <Button Classes="compact" Content="Go to table" Command="{Binding GoToTableCommand}"
                          ToolTip.Tip="Show the table in the Objects tab (columns, keys, indexes, definition)" />
                  <Button Classes="compact icon" Command="{Binding CopyValueCommand}"
                          ToolTip.Tip="Copy the found value" AutomationProperties.Name="Copy value">
                    <controls:StrokeIcon Data="{x:Static controls:Icons.Copy}" Width="13" Height="13" />
                  </Button>
                </StackPanel>
              </Grid>
              <TextBlock DockPanel.Dock="Top" Classes="caption" Text="{Binding RecordStatus}" TextWrapping="Wrap"
                         IsVisible="{Binding RecordStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,0,0,6" />
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding RecordFields}" AutomationProperties.Name="Columns of the found row">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="field" Classes.match="{Binding IsMatch}">
                        <StackPanel Spacing="1">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="caption" Text="{Binding Column}" />
                            <Border Classes="tag" IsVisible="{Binding IsKey}">
                              <TextBlock Text="PK" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                                     ToolTip.Tip="{Binding Value}"
                                     FontStyle="{Binding IsNull, Converter={x:Static conv:DataSearchConverters.ItalicWhenTrue}}"
                                     Opacity="{Binding IsNull, Converter={x:Static conv:DataSearchConverters.DimWhenTrue}}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </TabItem>
          <TabItem Header="{Binding SkippedHeader}" FontSize="13">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Classes="caption" TextWrapping="Wrap" Margin="0,0,8,0"
                           Text="Tables that timed out, were locked by another session, were too large or failed. They were not waited on." />
                <Button Grid.Column="1" Classes="compact" Content="Retry with longer timeouts" Command="{Binding RetrySkippedCommand}"
                        ToolTip.Tip="Search only these tables again, one at a time, with four times the timeouts and no size limit. Results are added to the list." />
              </Grid>
              <Panel>
                <DataGrid ItemsSource="{Binding Skipped}" IsReadOnly="True" AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal" AutomationProperties.Name="Skipped tables">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Schema" Binding="{Binding Schema}" Width="Auto" />
                    <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="200" />
                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Classes="caption" Text="No table was skipped." IsVisible="{Binding !HasSkipped}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Panel>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
