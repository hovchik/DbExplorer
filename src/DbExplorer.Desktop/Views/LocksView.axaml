<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:DbExplorer.Desktop.Converters"
             xmlns:diag="using:DbExplorer.Application.Diagnostics"
             x:Class="DbExplorer.Desktop.Views.LocksView">
  <Grid Margin="4" RowDefinitions="Auto,Auto,*,6,160">
    <WrapPanel Grid.Row="0" Classes="toolbar">
      <Button Content="Refresh" Classes="accent" Command="{Binding RefreshCommand}" />
      <CheckBox Content="Auto-refresh (5 s)" IsChecked="{Binding AutoRefresh}" Margin="0,0,10,4" />
      <RadioButton GroupName="LockView" Content="Lock list" IsChecked="{Binding !ShowTree}" />
      <RadioButton GroupName="LockView" Content="Blocking tree" IsChecked="{Binding ShowTree}" />
      <CheckBox Content="Hide shared DB / virtual xid locks" IsChecked="{Binding HideNoise}" Margin="0,0,10,4"
                ToolTip.Tip="Hide the shared database locks every session holds (SQL Server) and virtual transaction id locks (PostgreSQL)" />
      <CheckBox Content="Blocking chains only" IsChecked="{Binding BlockingOnly}" Margin="0,0,10,4" />
      <TextBlock Classes="hint" Text="{Binding Status}" TextWrapping="Wrap" />
    </WrapPanel>

    <Grid Grid.Row="2" IsVisible="{Binding ShowTree}" RowDefinitions="*">
      <TreeView ItemsSource="{Binding BlockingTree}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="6">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="diag:BlockingNode" ItemsSource="{Binding Children}">
            <StackPanel Margin="0,3">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBlock Classes="hint" Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <TextBlock Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Text="No blocking right now. Press Refresh (or enable auto-refresh) to check again."
                 IsVisible="{Binding !BlockingTree.Count}" />
    </Grid>

    <DataGrid Grid.Row="2" ItemsSource="{Binding Locks}" IsVisible="{Binding !ShowTree}"
              SelectedItem="{Binding SelectedLock, Mode=TwoWay}"
              IsReadOnly="True" AutoGenerateColumns="False"
              CanUserResizeColumns="True" CanUserSortColumns="True"
              GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="Auto" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
        <DataGridTextColumn Header="Blocked by" Binding="{Binding BlockedBy}" Width="Auto" />
        <DataGridTextColumn Header="Wait ms" Binding="{Binding WaitMs, StringFormat='{}{0:N0}'}" Width="Auto" />
        <DataGridTextColumn Header="Mode" Binding="{Binding LockMode}" Width="Auto" />
        <DataGridTextColumn Header="Resource" Binding="{Binding ResourceType}" Width="Auto" />
        <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="200" />
        <DataGridTextColumn Header="Login" Binding="{Binding LoginName}" Width="Auto" />
        <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="Auto" />
        <DataGridTextColumn Header="Program" Binding="{Binding ProgramName}" Width="160" />
        <DataGridTextColumn Header="Wait type" Binding="{Binding WaitType}" Width="Auto" />
        <DataGridTextColumn Header="SQL" Binding="{Binding SqlText, Converter={x:Static conv:SingleLineConverter.Instance}}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="3" ResizeDirection="Rows" Background="Transparent" />

    <TextBox Grid.Row="4" Classes="code"
             Text="{Binding SelectedSql}"
             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             Watermark="Select a lock or session to see its current or last SQL" />

  </Grid>
</UserControl>
