<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DbExplorer.Desktop.Views"
        x:Class="DbExplorer.Desktop.Views.MainWindow"
        Title="DB Explorer"
        Icon="/Assets/logo.ico"
        Width="1400" Height="860"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10,7" BorderThickness="0,0,0,1" BorderBrush="#22808080">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Image Source="/Assets/logo.png" Width="24" Height="24" Margin="0,0,4,0" VerticalAlignment="Center" />
          <TextBlock Text="DB Explorer" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ComboBox Width="240"
                    ItemsSource="{Binding Profiles}"
                    SelectedItem="{Binding SelectedProfile}"
                    PlaceholderText="Select a connection…"
                    IsEnabled="{Binding !IsConnected}" />
          <Button Classes="icon" Content="＋" ToolTip.Tip="New connection…" Command="{Binding NewConnectionCommand}" />
          <Button Classes="icon" Content="✎" ToolTip.Tip="Edit connection…" Command="{Binding EditConnectionCommand}" />
          <Button Classes="icon" Content="🗑" ToolTip.Tip="Delete connection" Command="{Binding DeleteConnectionCommand}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <ProgressBar Width="100" VerticalAlignment="Center"
                       IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
          <Button Content="Refresh metadata" Command="{Binding RefreshMetadataCommand}"
                  ToolTip.Tip="Re-read the catalog from the server and update the local cache" />
          <Button Content="Disconnect" IsVisible="{Binding IsConnected}" Command="{Binding DisconnectCommand}" />
          <Button Content="Connect" Classes="accent" IsVisible="{Binding !IsConnected}" Command="{Binding ConnectCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="10,5" BorderThickness="0,1,0,0" BorderBrush="#22808080">
      <TextBlock Classes="hint" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Border>

    <TabControl Margin="6" Padding="0" IsEnabled="{Binding IsConnected}">
      <TabItem Header="Objects">
        <views:ObjectsView DataContext="{Binding Objects}" />
      </TabItem>
      <TabItem Header="Search names &amp; code">
        <views:MetadataSearchView DataContext="{Binding Search}" />
      </TabItem>
      <TabItem Header="Search data">
        <views:DataSearchView DataContext="{Binding DataSearch}" />
      </TabItem>
      <TabItem Header="Indexes">
        <views:IndexesView DataContext="{Binding Indexes}" />
      </TabItem>
      <TabItem Header="Locks">
        <views:LocksView DataContext="{Binding Locks}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
