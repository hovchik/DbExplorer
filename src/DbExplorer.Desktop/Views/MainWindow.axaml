<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DbExplorer.Desktop.Views"
        x:Class="DbExplorer.Desktop.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/logo.ico"
        Width="1400" Height="860"
        xmlns:conv="using:DbExplorer.Desktop.Converters"
        xmlns:controls="using:DbExplorer.Desktop.Controls"
        xmlns:models="using:DbExplorer.Core.Models"
        xmlns:vm="using:DbExplorer.Desktop.ViewModels"
        xmlns:services="using:DbExplorer.Desktop.Services"
        WindowStartupLocation="CenterScreen">
  <!-- Ctrl+K, Ctrl+P, Ctrl+Shift+P, Ctrl+B, F1 and Ctrl+, are bound in code from the keymap (they can be changed in the F1 sheet). -->
  <Window.Resources>
    <conv:EnumToIndexConverter x:Key="EnumToIndex" />
  </Window.Resources>
  <Window.Styles>
    <!-- App bar: one height (32 px) for every control, ghost icon buttons with hover and pressed fills -->
    <Style Selector="Border.appbar Border.group">
      <Setter Property="Background" Value="{DynamicResource AppBarGroupBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBarGroupBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="Border.appbar Border.divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource AppBarGroupBorderBrush}" />
    </Style>
    <Style Selector="Border.appbar Ellipse.status">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="Border.appbar Ellipse.status.connected">
      <Setter Property="Fill" Value="{DynamicResource AppStatusConnectedBrush}" />
    </Style>
    <Style Selector="Border.appbar Ellipse.status.busy">
      <Setter Property="Fill" Value="{DynamicResource AppStatusBusyBrush}" />
    </Style>
    <Style Selector="Border.appbar Ellipse.status.idle">
      <Setter Property="Stroke" Value="{DynamicResource AppStatusIdleBrush}" />
      <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <Style Selector="Border.appbar Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.appbar Button.tool.labelled">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="10,0,12,0" />
    </Style>
    <Style Selector="Border.appbar Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}" />
    </Style>
    <Style Selector="Border.appbar Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppToolPressedBrush}" />
    </Style>
    <Style Selector="Border.appbar Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The app-wide TextBlock foreground would keep labels bright on a disabled button -->
    <Style Selector="Border.appbar Button:disabled TextBlock">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Border.appbar Border.count">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.appbar Border.count > TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The connection picker sits inside the group's frame, so it has none of its own -->
    <Style Selector="Border.appbar ComboBox.bare">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="4,0,2,0" />
      <Setter Property="Padding" Value="6,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.appbar ComboBox.bare /template/ Border#Background">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.appbar ComboBox.bare:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.appbar ComboBox.bare:pressed /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource AppToolPressedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.appbar ComboBox.bare:focus-visible /template/ Border#HighlightBackground">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- Locked while connected: keep it readable rather than greyed out, and drop the arrow -->
    <Style Selector="Border.appbar ComboBox.bare:disabled /template/ Border#Background">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.appbar ComboBox.bare:disabled /template/ PathIcon#DropDownGlyph">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.appbar ComboBox.bare TextBlock.folder">
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
    </Style>

    <!-- Go to: a search field look-alike that opens the command palette -->
    <Style Selector="Border.appbar Button.goto">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,0,5,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource AppBarGroupBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBarGroupBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
    </Style>
    <Style Selector="Border.appbar Button.goto:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppBarGroupBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppHintForegroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style Selector="Border.appbar Button.goto:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}" />
    </Style>
    <Style Selector="Border.appbar Button.goto TextBlock.placeholder">
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.appbar Border.keycap">
      <Setter Property="Background" Value="{DynamicResource AppKeycapBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBarGroupBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.appbar Border.keycap > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Connect (accent) and Disconnect: the bar's primary action -->
    <Style Selector="Border.appbar Button.primary">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="108" />
      <Setter Property="Padding" Value="12,0,14,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.appbar Button.primary.accent TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.appbar Button.primary.accent">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.appbar Button.disconnect">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBarGroupBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.appbar Button.disconnect:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppDangerHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    </Style>
    <Style Selector="Border.appbar Button.disconnect:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    </Style>
    <Style Selector="Border.appbar Button.disconnect:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.appbar Button.disconnect:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppDangerHoverBrush}" />
    </Style>

    <!-- Main tabs: always one row. When the headers don't fit (a narrow window, or the navigator open) they first get
         smaller (the compact class, set by the code-behind), then scroll sideways with the wheel, and the ⌄ button at
         the end lists every tab. -->
    <Style Selector="TabControl#MainTabs">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
              <ScrollViewer Name="PART_TabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
              <Button Name="PART_AllTabs" Grid.Column="1" IsVisible="False" Width="30" Height="30" MinHeight="0" Padding="0"
                      Margin="4,0,0,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      ToolTip.Tip="All tabs (some are scrolled out of view; the mouse wheel scrolls the tab row)">
                <controls:StrokeIcon Data="{x:Static controls:Icons.ChevronDown}" />
              </Button>
            </Grid>
            <ContentPresenter Name="PART_SelectedContentHost"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabControl#MainTabs > TabItem">
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="TabControl#MainTabs.compact > TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="7,0" />
    </Style>
    <!-- Status bar: one flat button the width of the window -->
    <Style Selector="Button.statusLine">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.statusLine:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}" />
    </Style>
    <!-- The default flyout stops at 456 px, too narrow for error texts -->
    <Style Selector="FlyoutPresenter.statusHistory">
      <Setter Property="MaxWidth" Value="720" />
    </Style>
    <Style Selector="TextBlock.error, SelectableTextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <!-- App bar: brand, then the connection group (status, picker, its actions, Team), then utilities and the
         primary Connect / Disconnect on the right. The picker gives way first when the window is narrow (1024 px
         laptops): its column shrinks to 130 px before anything on the right is pushed out of view. -->
    <Panel DockPanel.Dock="Top">
      <Border Classes="appbar" Padding="6,4,10,4" BorderThickness="0,0,0,1"
              Background="{DynamicResource AppBarBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,14,0">
            <Button Classes="tool" Command="{Binding ToggleNavigatorCommand}"
                    ToolTip.Tip="Show or hide the database navigator: connections, databases and their objects as a tree (Ctrl+B)">
              <controls:StrokeIcon Data="{x:Static controls:Icons.Sidebar}" />
            </Button>
            <Image Source="/Assets/logo.png" Width="22" Height="22" VerticalAlignment="Center" />
            <TextBlock Text="DB Explorer" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
          </StackPanel>

          <Grid Grid.Column="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" MinWidth="130" MaxWidth="320" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Grid.ColumnSpan="3" Classes="group" />

            <!-- Connection state: green connected, amber connecting / reading the catalog, hollow grey otherwise -->
            <Panel Grid.Column="0" Width="10" Height="10" Margin="12,0,2,0" VerticalAlignment="Center">
              <Ellipse Classes="status idle" ToolTip.Tip="Not connected">
                <Ellipse.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="!IsConnected" />
                    <Binding Path="!IsBusy" />
                  </MultiBinding>
                </Ellipse.IsVisible>
              </Ellipse>
              <Ellipse Classes="status busy" ToolTip.Tip="Working…" IsVisible="{Binding IsBusy}" />
              <Ellipse Classes="status connected" ToolTip.Tip="Connected">
                <Ellipse.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsConnected" />
                    <Binding Path="!IsBusy" />
                  </MultiBinding>
                </Ellipse.IsVisible>
              </Ellipse>
            </Panel>

            <ComboBox Grid.Column="1" Classes="bare" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile}"
                      PlaceholderText="Select a connection…"
                      IsTextSearchEnabled="True"
                      IsEnabled="{Binding !IsConnected}"
                      ToolTip.Tip="Connection (locked while connected; you can still add, edit, duplicate and import connections)">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                    <!-- The name keeps its width and the folder before it trims first when the bar is narrow.
                         TextSearch still uses ToString(). -->
                    <DockPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayName}" FontWeight="Medium"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Classes="folder" Text="{Binding Folder, Converter={x:Static conv:FolderPrefixConverter.Instance}}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <controls:StrokeIcon Grid.Column="1" Data="{x:Static controls:Icons.Lock}" Width="12" Height="12"
                                         Margin="6,0,0,0" IsVisible="{Binding ReadOnly}" ToolTip.Tip="Read-only connection" />
                    <controls:EnvironmentBadge Grid.Column="2" Environment="{Binding Environment}" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,3,0">
              <Border Classes="divider" Margin="2,0,4,0" />
              <Button Classes="tool" ToolTip.Tip="New connection…" Command="{Binding NewConnectionCommand}">
                <controls:StrokeIcon Data="{x:Static controls:Icons.Plus}" />
              </Button>
              <Button Classes="tool" ToolTip.Tip="Edit connection…" Command="{Binding EditConnectionCommand}">
                <controls:StrokeIcon Data="{x:Static controls:Icons.Pencil}" />
              </Button>
              <Button Classes="tool" ToolTip.Tip="Duplicate connection…" Command="{Binding DuplicateConnectionCommand}">
                <controls:StrokeIcon Data="{x:Static controls:Icons.Copy}" />
              </Button>
              <Button Classes="tool" ToolTip.Tip="{Binding DeleteConnectionTip}" Command="{Binding DeleteConnectionCommand}">
                <controls:StrokeIcon Data="{x:Static controls:Icons.Trash}" />
              </Button>
              <Button Classes="tool" ToolTip.Tip="Import or export connections">
                <controls:StrokeIcon Data="{x:Static controls:Icons.ArrowsUpDown}" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="Import connections…" Command="{Binding ImportConnectionsCommand}" />
                    <MenuItem Header="Export connections…" Command="{Binding ExportConnectionsCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>

            <Button Grid.Column="3" Classes="tool labelled" Margin="8,0,0,0" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding Team.ButtonTip}" Command="{Binding OpenTeamCommand}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <controls:StrokeIcon Data="{x:Static controls:Icons.Users}" />
                <TextBlock Text="Team" VerticalAlignment="Center" />
                <Border Classes="count" IsVisible="{Binding Team.HasChanges, FallbackValue=False}">
                  <TextBlock Text="{Binding Team.ChangedCount}" />
                </Border>
              </StackPanel>
            </Button>
          </Grid>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0,0,0">
            <!-- Looks like a search field; opens the command palette -->
            <Button Classes="goto" Width="170" Command="{Binding OpenCommandPaletteCommand}"
                    ToolTip.Tip="Jump to any table, view, procedure, tab or command (Ctrl+K or Ctrl+P; Ctrl+Shift+P lists commands only; F1 shows every keyboard shortcut)">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <controls:StrokeIcon Grid.Column="0" Data="{x:Static controls:Icons.Search}" Width="15" Height="15" />
                <TextBlock Grid.Column="1" Classes="placeholder" Text="Go to…" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="keycap">
                  <TextBlock Text="Ctrl K" />
                </Border>
              </Grid>
            </Button>

            <Button Classes="tool labelled" IsVisible="{Binding IsBusy}" Command="{Binding CancelLoadCommand}"
                    ToolTip.Tip="Stop connecting / reading the catalog">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:StrokeIcon Data="{x:Static controls:Icons.Close}" />
                <TextBlock Text="Cancel" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- Disabled while busy anyway; hiding it keeps the progress bar and Cancel inside a 1024 px window -->
            <Button Classes="tool" Command="{Binding RefreshMetadataCommand}" IsVisible="{Binding !IsBusy}"
                    ToolTip.Tip="Refresh metadata: re-read the catalog from the server and update the local cache">
              <controls:StrokeIcon Data="{x:Static controls:Icons.Refresh}" />
            </Button>
            <Button Classes="tool" ToolTip.Tip="Theme and preferences">
              <controls:StrokeIcon Data="{Binding SelectedTheme, Converter={x:Static conv:ThemeModeToIconConverter.Instance}}" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="System" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppThemeMode.System}">
                    <MenuItem.Icon>
                      <controls:StrokeIcon Data="{x:Static controls:Icons.Check}" Width="14" Height="14"
                                           IsVisible="{Binding SelectedTheme, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=System}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Light" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppThemeMode.Light}">
                    <MenuItem.Icon>
                      <controls:StrokeIcon Data="{x:Static controls:Icons.Check}" Width="14" Height="14"
                                           IsVisible="{Binding SelectedTheme, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Light}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Dark" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppThemeMode.Dark}">
                    <MenuItem.Icon>
                      <controls:StrokeIcon Data="{x:Static controls:Icons.Check}" Width="14" Height="14"
                                           IsVisible="{Binding SelectedTheme, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=Dark}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Preferences…" services:Keymap.Command="app.preferences" Command="{Binding OpenPreferencesCommand}"
                            ToolTip.Tip="Theme, editor, new Query tab defaults, notifications, start-up, rendering, experimental features and the AI key">
                    <MenuItem.Icon>
                      <controls:StrokeIcon Data="{x:Static controls:Icons.Settings}" Width="14" Height="14" />
                    </MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Border Classes="divider" Margin="6,0" />
            <Button Classes="primary disconnect" IsVisible="{Binding IsConnected}" Command="{Binding DisconnectCommand}"
                    ToolTip.Tip="Close the connection">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <controls:StrokeIcon Data="{x:Static controls:Icons.Power}" />
                <TextBlock Text="Disconnect" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="primary accent" IsVisible="{Binding !IsConnected}" Command="{Binding ConnectCommand}"
                    ToolTip.Tip="Connect to the selected database">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <controls:StrokeIcon Data="{x:Static controls:Icons.Plug}" />
                <TextBlock Text="Connect" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <!-- Connecting / reading the catalog: a thin line along the bar's bottom edge, so it costs no toolbar width -->
      <ProgressBar VerticalAlignment="Bottom" Height="2" MinHeight="2" MinWidth="0" CornerRadius="0"
                   Background="Transparent" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
    </Panel>

    <Border DockPanel.Dock="Top" Padding="10,2" IsVisible="{Binding ShowEnvironmentBanner}"
            Background="{Binding ConnectedEnvironment, Converter={x:Static conv:EnvironmentToBrushConverter.Instance}}">
      <TextBlock Text="{Binding EnvironmentBanner}" Foreground="White" FontWeight="Bold" FontSize="13" />
    </Border>

    <!-- A failed connect: what went wrong, one line on what to do, the driver's text, and Edit / Retry -->
    <Border DockPanel.Dock="Top" Classes="connectionFailure" Margin="8,6,8,2" Padding="12,10" CornerRadius="6"
            BorderThickness="1" BorderBrush="{DynamicResource AppDangerBrush}" Background="{DynamicResource AppDangerHoverBrush}"
            IsVisible="{Binding ShowConnectionFailure}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <controls:StrokeIcon Grid.Column="0" Data="{x:Static controls:Icons.Alert}" Foreground="{DynamicResource AppDangerBrush}"
                             Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0" />
        <StackPanel Grid.Column="1" Spacing="3" DataContext="{Binding ConnectionFailure}">
          <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
          <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" IsVisible="{Binding !!Advice.Length}" />
          <SelectableTextBlock Classes="hint" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap"
                               MaxLines="3" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="12,0,0,0">
          <Button Content="Edit connection…" Command="{Binding EditFailedConnectionCommand}"
                  ToolTip.Tip="Open this connection's settings; it connects again when you save" />
          <Button Classes="accent" Content="Retry" Command="{Binding RetryConnectCommand}" />
          <Button Padding="6" Background="Transparent" BorderThickness="0" Command="{Binding DismissConnectionFailureCommand}"
                  ToolTip.Tip="Dismiss">
            <controls:StrokeIcon Data="{x:Static controls:Icons.Close}" Width="14" Height="14" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- A newer release: download it, read what's new, skip that version, or hide the bar until the next check -->
    <Border DockPanel.Dock="Top" Margin="8,6,8,2" Padding="12,8" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" Background="{DynamicResource AppSubtleBackgroundBrush}"
            IsVisible="{Binding ShowUpdateBar}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <controls:StrokeIcon Grid.Column="0" Data="{x:Static controls:Icons.Download}" Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                             Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock FontWeight="SemiBold" Text="{Binding UpdateBarTitle}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="hint" FontSize="12" Text="{Binding UpdateBarDetail}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="Skip this version" Command="{Binding SkipUpdateCommand}"
                  ToolTip.Tip="Don't mention this version again at start-up; a newer one is still shown" />
          <Button Content="What's new" Command="{Binding OpenUpdateNotesCommand}" ToolTip.Tip="Open the release notes on GitHub" />
          <Button Classes="accent" Content="{Binding UpdateDownloadText}" Command="{Binding DownloadUpdateCommand}"
                  ToolTip.Tip="Download the installer in your browser; run it to update" />
          <Button Padding="6" Background="Transparent" BorderThickness="0" Command="{Binding DismissUpdateCommand}"
                  ToolTip.Tip="Hide until the next check">
            <controls:StrokeIcon Data="{x:Static controls:Icons.Close}" Width="14" Height="14" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status bar: the whole line opens the last 50 messages; the full text is in the tooltip; an unseen error
         keeps a red mark until the history is opened -->
    <Border DockPanel.Dock="Bottom" Padding="4,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
      <Button x:Name="StatusButton" Classes="statusLine" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              AutomationProperties.Name="{Binding StatusText}" AutomationProperties.LiveSetting="Polite"
              ToolTip.Tip="{Binding StatusText}" Command="{Binding MarkStatusSeenCommand}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <controls:StrokeIcon Grid.Column="0" Data="{x:Static controls:Icons.Alert}" Foreground="{DynamicResource AppDangerBrush}"
                               Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"
                               IsVisible="{Binding HasUnseenError}" />
          <TextBlock Grid.Column="1" Classes="hint" Classes.error="{Binding StatusIsError}" Text="{Binding StatusText}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="hint" FontSize="11" Text="History" Margin="12,0,2,0" VerticalAlignment="Center"
                     IsVisible="{Binding HasStatusHistory}" />
        </Grid>
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="statusHistory">
            <DockPanel Width="660" MaxHeight="440">
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,2,4,8">
                <TextBlock FontWeight="SemiBold" Text="Recent messages" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Button Content="Copy all" Command="{Binding CopyStatusHistoryCommand}" IsEnabled="{Binding HasStatusHistory}" />
                  <Button Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}"
                          ToolTip.Tip="{Binding Source={x:Static vm:MainWindowViewModel.LogsFolder}}" />
                  <Button Content="Clear" Command="{Binding ClearStatusHistoryCommand}" IsEnabled="{Binding HasStatusHistory}" />
                </StackPanel>
              </Grid>
              <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="4" Text="No messages yet."
                         IsVisible="{Binding !HasStatusHistory}" />
              <ListBox AutomationProperties.Name="Status history" ItemsSource="{Binding StatusHistory}" Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" Classes="hint" FontSize="12" Text="{Binding TimeText}" Margin="0,1,10,0"
                                 VerticalAlignment="Top" />
                      <SelectableTextBlock Grid.Column="1" FontSize="12" Text="{Binding Text}" TextWrapping="Wrap"
                                           Classes.error="{Binding IsError}" />
                      <Button Grid.Column="2" Classes="copyStatus" Margin="8,0,0,0" Padding="4" VerticalAlignment="Top"
                              Background="Transparent" BorderThickness="0" ToolTip.Tip="Copy"
                              Command="{Binding $parent[ListBox].DataContext.CopyStatusEntryCommand}" CommandParameter="{Binding}">
                        <controls:StrokeIcon Data="{x:Static controls:Icons.Copy}" Width="13" Height="13" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Border>

    <!-- Database navigator on the left (Ctrl+B), then the tabs. The navigator column's width is set by the
         code-behind from the saved setting, and saved again when the splitter is dragged. -->
    <Grid x:Name="WorkArea">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="480" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" IsVisible="{Binding ShowNavigator}" BorderThickness="0,0,1,0"
              BorderBrush="{DynamicResource AppBorderBrush}" Background="{DynamicResource AppBarBackgroundBrush}">
        <views:NavigatorView x:Name="Navigator" DataContext="{Binding Navigator}" />
      </Border>
      <GridSplitter x:Name="NavigatorSplitter" Grid.Column="1" Width="4" ResizeDirection="Columns" Background="Transparent"
                    IsVisible="{Binding ShowNavigator}" ToolTip.Tip="Drag to resize the navigator" />
      <TabControl x:Name="MainTabs" Grid.Column="2" Margin="4,0,4,0" Padding="0" SelectedIndex="{Binding SelectedTab, Converter={StaticResource EnumToIndex}}">
        <TabItem Header="Objects" IsEnabled="{Binding IsConnected}">
          <views:ObjectsView DataContext="{Binding Objects}" />
        </TabItem>
        <TabItem Header="Query">
          <views:QueryWorkspaceView DataContext="{Binding Query}" />
        </TabItem>
        <TabItem Header="Query builder" IsEnabled="{Binding IsConnected}" ToolTip.Tip="Build a SELECT by dragging tables and ticking columns">
          <views:QueryBuilderView DataContext="{Binding QueryBuilder}" />
        </TabItem>
        <TabItem Header="Table designer" IsEnabled="{Binding IsConnected}" ToolTip.Tip="Design a new table, with suggestions, and create it">
          <views:TableDesignerView DataContext="{Binding TableDesigner}" />
        </TabItem>
        <TabItem Header="Comparer">
          <views:ComparerView DataContext="{Binding Comparer}" />
        </TabItem>
        <TabItem Header="Diagram" IsEnabled="{Binding IsConnected}">
          <views:DiagramView DataContext="{Binding Diagram}" />
        </TabItem>
        <TabItem Header="Search names &amp; code" IsEnabled="{Binding IsConnected}">
          <views:MetadataSearchView DataContext="{Binding Search}" />
        </TabItem>
        <TabItem Header="Search data" IsEnabled="{Binding IsConnected}">
          <views:DataSearchView DataContext="{Binding DataSearch}" />
        </TabItem>
        <TabItem Header="ER model" ToolTip.Tip="Draw tables and relationships, or read them from a database, and generate the DDL">
          <views:ErModelView DataContext="{Binding ErModel}" />
        </TabItem>
        <TabItem Header="Indexes" IsEnabled="{Binding IsConnected}">
          <views:IndexesView DataContext="{Binding Indexes}" />
        </TabItem>
        <TabItem Header="Locks" IsEnabled="{Binding IsConnected}">
          <views:LocksView DataContext="{Binding Locks}" />
        </TabItem>
        <TabItem Header="Activity" IsEnabled="{Binding IsConnected}">
          <views:ActivityView DataContext="{Binding Activity}" />
        </TabItem>
        <TabItem Header="Lab" IsEnabled="{Binding IsConnected}" ToolTip.Tip="Experimental: change recorder, schema history, inferred relationships">
          <views:LabView DataContext="{Binding Lab}" />
        </TabItem>
        <TabItem Header="Security" IsEnabled="{Binding IsConnected}" ToolTip.Tip="Logins, users and roles: memberships and permissions, edited as a reviewed script">
          <views:SecurityView DataContext="{Binding Security}" />
        </TabItem>
        <TabItem Header="Jobs" IsEnabled="{Binding IsConnected}" ToolTip.Tip="Scheduled jobs: SQL Server Agent, pg_cron or MySQL events, with their runs">
          <views:JobsView DataContext="{Binding Jobs}" />
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
