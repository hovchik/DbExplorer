<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DbExplorer.Desktop.Controls"
             xmlns:vm="using:DbExplorer.Desktop.ViewModels"
             x:Class="DbExplorer.Desktop.Views.NavigatorView"
             x:DataType="vm:NavigatorViewModel">
  <UserControl.Resources>
    <!-- Fluent indents each level by 16 px plus the chevron; nine levels deep (down to a column) that ate half the pane -->
    <x:Double x:Key="TreeViewItemIndent">12</x:Double>
    <Thickness x:Key="TreeViewItemExpandCollapseChevronMargin">4,0,4,0</Thickness>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Dense rows like DBeaver's navigator, but with the app's 14 px text -->
    <Style Selector="TreeView#Tree TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" x:DataType="vm:NavigatorNode" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TreeView#Tree TreeViewItem /template/ Border#PART_LayoutRoot">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Header: filter (Ctrl+Shift+F in the tree focuses it) plus collapse and refresh -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="6,6,4,4">
      <TextBox AutomationProperties.Name="Filter navigator" x:Name="FilterBox" Grid.Column="0" Text="{Binding FilterText}" Watermark="Filter objects…"
               ToolTip.Tip="Show only the tables, views, routines… whose name contains this text, in every database opened so far. Esc clears it."
               KeyDown="OnFilterKeyDown">
        <TextBox.InnerLeftContent>
          <controls:StrokeIcon Data="{x:Static controls:Icons.Search}" Width="14" Height="14" Margin="8,0,0,0"
                               Foreground="{DynamicResource AppHintForegroundBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <Button Grid.Column="1" Classes="tool" Margin="2,0,0,0" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse all">
        <controls:StrokeIcon Data="{x:Static controls:Icons.Collapse}" />
      </Button>
      <Button Grid.Column="2" Classes="tool" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsConnected}"
              ToolTip.Tip="Re-read the catalog (the selected database when it is not the connection's own)">
        <controls:StrokeIcon Data="{x:Static controls:Icons.Refresh}" />
      </Button>
      <Button Grid.Column="3" Classes="tool" Command="{Binding HideCommand}"
              ToolTip.Tip="Hide the navigator (Ctrl+B or the sidebar button at the top left shows it again)">
        <controls:StrokeIcon Data="{x:Static controls:Icons.Close}" />
      </Button>
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="10,0,8,4" Text="{Binding FilterSummary}" TextWrapping="Wrap"
               IsVisible="{Binding FilterSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <TreeView AutomationProperties.Name="Database navigator" x:Name="Tree" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="2,0,4,4"
              KeyDown="OnTreeKeyDown" ContextRequested="OnTreeContextRequested">
      <TreeView.ItemTemplate>
        <TreeDataTemplate DataType="vm:NavigatorNode" ItemsSource="{Binding Children}">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
            <controls:TintedIcon Grid.Column="0" Data="{Binding Icon}" ColorKey="{Binding ColorKey}" Width="16" Height="16"
                                 VerticalAlignment="Center" Margin="0,0,7,0" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       FontWeight="{Binding IsEmphasized, Converter={x:Static controls:NavigatorConverters.Weight}}"
                       Opacity="{Binding IsDimmed, Converter={x:Static controls:NavigatorConverters.Dim}}" />
            <!-- Several connections open: the colour this connection's Query tabs are marked with -->
            <Ellipse Grid.Column="2" Width="7" Height="7" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{Binding MarkBrush}"
                     IsVisible="{Binding MarkBrush, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Grid.Column="3" Classes="detail" Text="{Binding Detail}"
                       IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </Grid>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
      <TreeView.ContextMenu>
        <ContextMenu>
          <!-- Saved connections -->
          <MenuItem Header="Connect" Command="{Binding ConnectCommand}" IsVisible="{Binding SelectedIsClosedConnection}"
                    ToolTip.Tip="Open this connection next to the ones already open; the Objects, Diagram and other tabs move to it" />
          <MenuItem Header="Make active" Command="{Binding ActivateConnectionCommand}" IsVisible="{Binding SelectedIsOpenInactiveConnection}"
                    ToolTip.Tip="Show this open connection in the Objects, Diagram and other tabs. Query tabs keep their own connections." />
          <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding SelectedIsOpenConnection}"
                    ToolTip.Tip="Close this connection; the other open ones stay open" />
          <MenuItem Header="Edit connection…" Command="{Binding EditConnectionCommand}" IsVisible="{Binding SelectedIsConnection}" />
          <MenuItem Header="Duplicate connection…" Command="{Binding DuplicateConnectionCommand}" IsVisible="{Binding SelectedIsConnection}"
                    ToolTip.Tip="A copy of this connection under a new name, opened for editing" />
          <MenuItem Header="Delete connection…" Command="{Binding DeleteConnectionCommand}" IsVisible="{Binding SelectedIsClosedConnection}" />
          <MenuItem Header="Copy connection string" IsVisible="{Binding SelectedIsConnection}"
                    ToolTip.Tip="These settings for other tools, without the password">
            <MenuItem Header="As key=value pairs" Command="{Binding CopyConnectionStringCommand}" CommandParameter="keyvalue" />
            <MenuItem Header="As URL" Command="{Binding CopyConnectionStringCommand}" CommandParameter="url" />
          </MenuItem>

          <!-- Objects -->
          <MenuItem Header="Open" InputGesture="Enter" FontWeight="SemiBold" Command="{Binding OpenCommand}" IsVisible="{Binding SelectedHasCatalogActions}"
                    ToolTip.Tip="Columns, indexes, references and definition in the Objects tab" />
          <MenuItem Header="Select rows" Command="{Binding SelectRowsCommand}" IsVisible="{Binding SelectedIsTableLike}"
                    ToolTip.Tip="A SELECT of the first 200 rows in a new Query tab (it runs when you press Run)" />
          <MenuItem Header="Get data…" Command="{Binding GetDataCommand}" IsVisible="{Binding SelectedHasCatalogActions}"
                    IsEnabled="{Binding SelectedIsTableLike}" />
          <MenuItem Header="Execute…" Command="{Binding ExecuteCommand}" IsVisible="{Binding SelectedIsRoutine}"
                    IsEnabled="{Binding SelectedHasCatalogActions}" />
          <MenuItem Header="Debug…" Command="{Binding DebugCommand}" IsVisible="{Binding SelectedIsRoutine}"
                    IsEnabled="{Binding SelectedHasCatalogActions}" />
          <MenuItem Header="Generate SQL" IsVisible="{Binding SelectedIsTable}">
            <MenuItem Header="SELECT" Command="{Binding SelectRowsCommand}" />
            <MenuItem Header="INSERT" Command="{Binding ScriptInsertCommand}" />
            <MenuItem Header="UPDATE" Command="{Binding ScriptUpdateCommand}" />
            <MenuItem Header="DELETE" Command="{Binding ScriptDeleteCommand}" />
          </MenuItem>
          <MenuItem Header="Show in diagram" Command="{Binding ShowInDiagramCommand}" IsVisible="{Binding SelectedIsTable}"
                    IsEnabled="{Binding SelectedHasCatalogActions}" />
          <MenuItem Header="Find usages" Command="{Binding FindUsagesCommand}" IsVisible="{Binding SelectedHasCatalogActions}"
                    ToolTip.Tip="Views, routines and triggers that use it, and its foreign keys: what a change could break" />
          <Separator IsVisible="{Binding SelectedHasCatalogActions}" />
          <MenuItem Header="Modify…" Command="{Binding ModifyCommand}" IsVisible="{Binding SelectedHasCatalogActions}"
                    ToolTip.Tip="Tables open in the Table designer; other objects open in a Query tab as an editable script that replaces them." />
          <MenuItem Header="Import data…" Command="{Binding ImportDataCommand}" IsVisible="{Binding SelectedIsTable}"
                    IsEnabled="{Binding SelectedHasCatalogActions}" ToolTip.Tip="Add rows from a CSV, TSV or Excel file" />
          <MenuItem Header="Generate test data…" Command="{Binding GenerateTestDataCommand}" IsVisible="{Binding SelectedIsTable}"
                    IsEnabled="{Binding SelectedHasCatalogActions}"
                    ToolTip.Tip="Fill the table with realistic rows that respect its types, keys and foreign keys. Asks before inserting." />
          <MenuItem Header="Drop table…" Command="{Binding DropTableCommand}" IsVisible="{Binding SelectedIsTable}"
                    IsEnabled="{Binding SelectedHasCatalogActions}" ToolTip.Tip="Asks first, then drops the table and all its rows." />

          <!-- Anywhere in a connected tree -->
          <Separator IsVisible="{Binding SelectedHasDatabase}" />
          <MenuItem Header="New query here" Command="{Binding NewQueryCommand}" IsVisible="{Binding SelectedHasDatabase}"
                    ToolTip.Tip="A new Query tab on this row's database" />
          <MenuItem Header="Export documentation…" Command="{Binding ExportDocumentationCommand}" IsVisible="{Binding SelectedCanDocument}"
                    ToolTip.Tip="Tables, columns, keys, comments and the diagram as one HTML or Markdown file" />
          <MenuItem Header="Back up…" Command="{Binding BackupDatabaseCommand}" IsVisible="{Binding SelectedCanBackup}"
                    ToolTip.Tip="The whole database to one file: a .bak on the server (SQL Server) or a pg_dump / mysqldump file here" />
          <MenuItem Header="Restore…" Command="{Binding RestoreDatabaseCommand}" IsVisible="{Binding SelectedCanBackup}"
                    ToolTip.Tip="From a backup file into a new database or this one. Shows what will run and asks first." />
          <MenuItem Header="Copy name" Command="{Binding CopyNameCommand}" IsVisible="{Binding SelectedHasName}" />
          <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" IsVisible="{Binding SelectedHasDatabase}" />
        </ContextMenu>
      </TreeView.ContextMenu>
    </TreeView>
  </DockPanel>
</UserControl>
