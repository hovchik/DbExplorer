<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DbExplorer.Desktop.Views.ObjectsView">
  <Grid Margin="8" ColumnDefinitions="2*,6,3*">
    <DockPanel Grid.Column="0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
        <TextBox Width="240" Text="{Binding FilterText}" Watermark="Filter by schema.name…" />
        <ComboBox Width="150" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter}" />
        <ComboBox Width="150" ItemsSource="{Binding DatabaseFilters}" SelectedItem="{Binding SelectedDatabaseFilter}" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="0,6,0,0" Text="{Binding Summary}" />
      <DataGrid x:Name="ObjectsGrid" ItemsSource="{Binding Objects}"
                SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                IsReadOnly="True" AutoGenerateColumns="False"
                CanUserResizeColumns="True" CanUserSortColumns="True"
                GridLinesVisibility="Horizontal"
                DoubleTapped="OnObjectsDoubleTapped">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Execute…" Command="{Binding ExecuteSelectedCommand}" />
            <MenuItem Header="Get Data…" Command="{Binding GetDataCommand}" />
            <MenuItem Header="Show in diagram" Command="{Binding ShowInDiagramCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="Auto" />
          <DataGridTextColumn Header="Schema" Binding="{Binding Schema}" Width="Auto" />
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
          <DataGridTextColumn Header="Rows (est.)" Binding="{Binding RowCount, StringFormat='{}{0:N0}'}" Width="Auto" />
          <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="Auto" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

    <Grid Grid.Column="2" RowDefinitions="Auto,3*,6,2*">
      <TextBlock Grid.Row="0" Margin="0,0,0,6" FontWeight="SemiBold" Text="{Binding SelectedObject.FullName}" />
      <TabControl Grid.Row="1">
        <TabItem Header="Columns">
          <DataGrid ItemsSource="{Binding Columns}"
                    IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserResizeColumns="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Ordinal}" Width="Auto" />
              <DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="Auto" />
              <DataGridCheckBoxColumn Header="Null" Binding="{Binding IsNullable}" Width="Auto" />
              <DataGridCheckBoxColumn Header="PK" Binding="{Binding IsPrimaryKey}" Width="Auto" />
              <DataGridCheckBoxColumn Header="Computed" Binding="{Binding IsComputed}" Width="Auto" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Indexes">
          <DataGrid ItemsSource="{Binding Indexes}"
                    IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserResizeColumns="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
              <DataGridCheckBoxColumn Header="Unique" Binding="{Binding IsUnique}" Width="Auto" />
              <DataGridCheckBoxColumn Header="PK" Binding="{Binding IsPrimaryKey}" Width="Auto" />
              <DataGridTextColumn Header="Columns" Binding="{Binding Columns}" Width="*" />
              <DataGridTextColumn Header="Included" Binding="{Binding IncludedColumns}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="References">
          <Grid RowDefinitions="Auto,*,6,Auto,*">
            <TextBlock Grid.Row="0" Classes="hint" Text="Foreign keys defined on this table (references out):" />
            <DataGrid Grid.Row="1" ItemsSource="{Binding OutgoingForeignKeys}"
                      IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserResizeColumns="True" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Columns" Binding="{Binding Columns}" Width="*" />
                <DataGridTextColumn Header="References" Binding="{Binding ReferencedSchema}" Width="Auto" />
                <DataGridTextColumn Header="Table" Binding="{Binding ReferencedTable}" Width="*" />
                <DataGridTextColumn Header="Ref. Columns" Binding="{Binding ReferencedColumns}" Width="*" />
                <DataGridCheckBoxColumn Header="Disabled" Binding="{Binding IsDisabled}" Width="Auto" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Classes="hint" Text="Other tables referencing this one (referenced by):" />
            <DataGrid Grid.Row="4" ItemsSource="{Binding IncomingForeignKeys}"
                      IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserResizeColumns="True" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Schema" Binding="{Binding Schema}" Width="Auto" />
                <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="*" />
                <DataGridTextColumn Header="Columns" Binding="{Binding Columns}" Width="*" />
                <DataGridTextColumn Header="Ref. Columns" Binding="{Binding ReferencedColumns}" Width="*" />
                <DataGridCheckBoxColumn Header="Disabled" Binding="{Binding IsDisabled}" Width="Auto" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
        <TabItem Header="Profile">
          <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="3*,6,2*">
            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,4,0,6">
              <Button Content="Profile" Classes="accent" Command="{Binding ProfileCommand}" />
              <TextBlock Text="Sample rows" VerticalAlignment="Center" />
              <NumericUpDown Width="140" Minimum="1" Maximum="10000000" Increment="10000" FormatString="N0"
                             Value="{Binding ProfileSampleRows}" />
              <ProgressBar Width="100" VerticalAlignment="Center" IsIndeterminate="True" IsVisible="{Binding IsProfiling}" />
            </StackPanel>
            <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding ColumnProfiles}"
                      SelectedItem="{Binding SelectedColumnProfile, Mode=TwoWay}"
                      IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="140" />
                <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="Auto" />
                <DataGridTextColumn Header="Null %" Binding="{Binding NullPercent, StringFormat='{}{0:N1}'}" Width="Auto" />
                <DataGridTextColumn Header="Nulls" Binding="{Binding NullCount, StringFormat='{}{0:N0}'}" Width="Auto" />
                <DataGridTextColumn Header="Distinct" Binding="{Binding DistinctCount, StringFormat='{}{0:N0}'}" Width="Auto" />
                <DataGridCheckBoxColumn Header="Unique" Binding="{Binding LooksUnique}" Width="Auto" />
                <DataGridTextColumn Header="Min" Binding="{Binding MinValue}" Width="120" />
                <DataGridTextColumn Header="Max" Binding="{Binding MaxValue}" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
            <DataGrid Grid.Row="1" Grid.Column="2" ItemsSource="{Binding TopValues}"
                      IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserResizeColumns="True" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Most frequent value" Binding="{Binding Value, TargetNullValue='NULL'}" Width="*" />
                <DataGridTextColumn Header="Count" Binding="{Binding Count, StringFormat='{}{0:N0}'}" Width="Auto" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Classes="hint" Margin="0,6,0,0" Text="{Binding ProfileStatus}" TextWrapping="Wrap" />
          </Grid>
        </TabItem>
      </TabControl>
      <GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="Transparent" />
      <TextBox Grid.Row="3" Classes="code"
               Text="{Binding Definition}"
               IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
  </Grid>
</UserControl>
