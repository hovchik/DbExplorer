<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:DbExplorer.Desktop.ViewModels"
			 xmlns:views="using:DbExplorer.Desktop.Views"
			 xmlns:ae="using:AvaloniaEdit"
			 x:Class="DbExplorer.Desktop.Views.QueryView">
  <UserControl.Styles>
	<Style Selector="Button.tool">
	  <Setter Property="MinHeight" Value="28" />
	  <Setter Property="Padding" Value="10,2" />
	</Style>
  </UserControl.Styles>
  <Grid Margin="4" RowDefinitions="Auto,2*,Auto,6,3*,Auto">
	<WrapPanel Grid.Row="0" Classes="toolbar">
	  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,4"
				  ToolTip.Tip="Database the statements run in. The editor suggests only its tables, views, functions and columns. Type to jump to a name.">
		<TextBlock Text="Database" VerticalAlignment="Center" />
		<ComboBox ItemsSource="{Binding AvailableDatabases}" SelectedItem="{Binding CurrentDatabase}"
				  IsEnabled="{Binding CanChangeDatabase}" IsTextSearchEnabled="True"
				  PlaceholderText="(connection default)" MinWidth="180" MaxWidth="320" MaxDropDownHeight="420" />
	  </StackPanel>
	  <Button Content="▶ Run" Classes="accent" Click="OnRun"
			  ToolTip.Tip="Run the selection, or the whole script when nothing is selected (F5 / Ctrl+E)" />
	  <Button Content="▶ Statement" Classes="tool" Click="OnRunStatement"
			  ToolTip.Tip="Run only the statement at the caret (Ctrl+Enter)" />
	  <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
	  <Button Content="Explain ▾" Classes="tool" ToolTip.Tip="Execution plan of the selection / statement at the caret (Ctrl+L)">
		<Button.Flyout>
		  <MenuFlyout Placement="BottomEdgeAlignedLeft">
			<MenuItem Header="Estimated plan (does not run the query)" InputGesture="Ctrl+L" Click="OnExplain" />
			<MenuItem Header="Explain Analyze (runs it in a transaction that is rolled back)" InputGesture="Ctrl+Shift+L" Click="OnExplainAnalyze" />
		  </MenuFlyout>
		</Button.Flyout>
	  </Button>
	  <CheckBox Content="Auto-commit" IsChecked="{Binding AutoCommit}" Margin="4,0,4,4"
				ToolTip.Tip="Off: runs happen inside a transaction that stays open until you Commit or Rollback, so you can check changes first" />
	  <Button Content="✔ Commit" Classes="tool" Command="{Binding CommitCommand}" IsVisible="{Binding HasOpenTransaction}"
			  ToolTip.Tip="Make the changes of the open transaction permanent" />
	  <Button Content="↶ Rollback" Classes="tool" Command="{Binding RollbackCommand}" IsVisible="{Binding HasOpenTransaction}"
			  ToolTip.Tip="Undo everything done since the transaction started" />
	  <TextBlock Text="{Binding TransactionInfo}" IsVisible="{Binding HasOpenTransaction}" Foreground="#E08A00" FontWeight="SemiBold" />
	  <Button Content="Tools ▾" Classes="tool">
		<Button.Flyout>
		  <MenuFlyout Placement="BottomEdgeAlignedLeft">
			<MenuItem Header="Format" InputGesture="Ctrl+Shift+F" Click="OnFormat" />
			<MenuItem Header="Comment / uncomment lines" InputGesture="Ctrl+OemQuestion" Click="OnToggleComment" />
			<MenuItem Header="UPPER CASE selection" InputGesture="Ctrl+Shift+U" Click="OnUpperCase" />
			<MenuItem Header="lower case selection" InputGesture="Ctrl+Alt+U" Click="OnLowerCase" />
			<MenuItem Header="Duplicate line / selection" InputGesture="Ctrl+D" Click="OnDuplicate" />
			<Separator />
			<MenuItem Header="Find" InputGesture="Ctrl+F" Click="OnFind" />
			<MenuItem Header="Replace" InputGesture="Ctrl+H" Click="OnReplace" />
			<MenuItem Header="Go to definition" InputGesture="F12" Click="OnGoToDefinition" />
			<MenuItem Header="Go to line…" InputGesture="Ctrl+G" Click="OnGoToLine" />
		  </MenuFlyout>
		</Button.Flyout>
	  </Button>
	  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,4" ToolTip.Tip="Rows kept per result set (0 = all). Larger results are read to the end but not kept, so the app stays responsive.">
		<TextBlock Text="Max rows" VerticalAlignment="Center" />
		<NumericUpDown Value="{Binding MaxRows}" Minimum="0" Maximum="10000000" Increment="10000" FormatString="N0" Width="160" />
	  </StackPanel>
	  <CheckBox Content="Run on multiple databases" IsChecked="{Binding RunOnMultipleDatabases}" Margin="0,0,8,4"
				ToolTip.Tip="Run the same script on every selected database and stack the results with a Database column" />
	  <Button Content="{Binding TargetSummary, StringFormat='{}{0} ▾'}" IsVisible="{Binding RunOnMultipleDatabases}">
		<Button.Flyout>
		  <Flyout Placement="BottomEdgeAlignedLeft">
			<StackPanel Width="340" Spacing="6">
			  <TextBox Text="{Binding DatabaseFilter}" Watermark="Filter databases…" />
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Select all" Command="{Binding SelectAllDatabasesCommand}" CommandParameter="{x:True}" />
				<Button Content="None" Command="{Binding SelectAllDatabasesCommand}" CommandParameter="{x:False}" />
				<Button Content="Reload" Command="{Binding LoadDatabasesCommand}" />
			  </StackPanel>
			  <ScrollViewer MaxHeight="320">
				<ItemsControl ItemsSource="{Binding VisibleDatabases}">
				  <ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:DatabaseChoice">
					  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,1" />
					</DataTemplate>
				  </ItemsControl.ItemTemplate>
				</ItemsControl>
			  </ScrollViewer>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<TextBlock Text="Parallel" VerticalAlignment="Center" />
				<NumericUpDown Width="110" Minimum="1" Maximum="16" Increment="1" FormatString="0" Value="{Binding Parallelism}" />
			  </StackPanel>
			  <TextBlock Classes="hint" Text="{Binding DatabaseListStatus}" TextWrapping="Wrap" />
			</StackPanel>
		  </Flyout>
		</Button.Flyout>
	  </Button>
	  <ProgressBar Width="100" MinWidth="100" IsIndeterminate="True" IsVisible="{Binding IsRunning}" />
	  <TextBlock Classes="hint" Text="{Binding Status}" TextWrapping="Wrap" />
	</WrapPanel>

	<Popup Grid.Row="1" x:Name="SignaturePopup" IsLightDismissEnabled="False" Placement="TopEdgeAlignedLeft">
	  <Border Background="{DynamicResource AppPopupBackgroundBrush}" BorderBrush="{DynamicResource AppPopupBorderBrush}"
			  BorderThickness="1" CornerRadius="4" Padding="8,4">
		<TextBlock x:Name="SignatureText" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
	  </Border>
	</Popup>
	<Popup Grid.Row="1" x:Name="GoToLinePopup" IsLightDismissEnabled="True" Placement="TopEdgeAlignedRight">
	  <Border Background="{DynamicResource AppPopupBackgroundBrush}" BorderBrush="{DynamicResource AppPopupBorderBrush}"
			  BorderThickness="1" CornerRadius="4" Padding="8">
		<StackPanel Orientation="Horizontal" Spacing="6">
		  <TextBlock Text="Go to line" VerticalAlignment="Center" />
		  <TextBox x:Name="GoToLineBox" Width="90" KeyDown="OnGoToLineKeyDown" />
		</StackPanel>
	  </Border>
	</Popup>
	<Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="6" ClipToBounds="True">
	  <ae:TextEditor x:Name="Editor" ShowLineNumbers="True" WordWrap="False"
					 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="13"
					 Background="{DynamicResource AppCodeBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}"
					 LineNumbersForeground="{DynamicResource AppHintForegroundBrush}"
					 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="4,4,0,0" />
	</Border>
	<Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="2,2,2,0">
	  <TextBlock Grid.Column="0" Classes="hint" FontSize="11"
				 Text="Ctrl+Space suggest · F5 run · Ctrl+Enter statement · Ctrl+L plan · F12/Ctrl+Click definition · Ctrl+Shift+F format · Ctrl+/ comment · Ctrl+D duplicate · Alt+↑↓ move line" />
	  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
		<TextBlock Classes="hint" FontSize="11" Text="{Binding CompletionInfo}" />
		<TextBlock x:Name="CaretInfo" Classes="hint" FontSize="11" />
	  </StackPanel>
	</Grid>

	<GridSplitter Grid.Row="3" ResizeDirection="Rows" Background="Transparent" />

	<TabControl Grid.Row="4" ItemsSource="{Binding ResultSets}">
	  <TabControl.ItemTemplate>
		<DataTemplate x:DataType="vm:ResultSetView">
		  <TextBlock Text="{Binding Title}" />
		</DataTemplate>
	  </TabControl.ItemTemplate>
	  <TabControl.ContentTemplate>
		<DataTemplate x:DataType="vm:ResultSetView">
		  <views:ResultGridView ResultSet="{Binding}" />
		</DataTemplate>
	  </TabControl.ContentTemplate>
	</TabControl>

	<!-- Server messages (PRINT, rows affected, per-database results): collapsed to one line until needed -->
	<Expander Grid.Row="5" HorizontalAlignment="Stretch" Margin="0,2,0,0" Padding="4" MinHeight="0"
			  IsVisible="{Binding !!Messages.Count}"
			  Header="{Binding Messages.Count, StringFormat='Messages ({0})'}">
	  <ScrollViewer MaxHeight="160">
		<ItemsControl ItemsSource="{Binding Messages}">
		  <ItemsControl.ItemTemplate>
			<DataTemplate>
			  <SelectableTextBlock Foreground="{DynamicResource AppHintForegroundBrush}" Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
			</DataTemplate>
		  </ItemsControl.ItemTemplate>
		</ItemsControl>
	  </ScrollViewer>
	</Expander>
  </Grid>
</UserControl>
