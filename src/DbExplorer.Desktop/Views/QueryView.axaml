<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controls="using:DbExplorer.Desktop.Controls"
			 xmlns:vm="using:DbExplorer.Desktop.ViewModels"
			 xmlns:views="using:DbExplorer.Desktop.Views"
			 xmlns:ae="using:AvaloniaEdit"
			 x:Class="DbExplorer.Desktop.Views.QueryView">
  <UserControl.Styles>
	<Style Selector="Button.layout">
	  <Setter Property="MinHeight" Value="18" />
	  <Setter Property="MinWidth" Value="22" />
	  <Setter Property="Padding" Value="4,0" />
	  <Setter Property="FontSize" Value="11" />
	  <Setter Property="Background" Value="Transparent" />
	  <Setter Property="BorderThickness" Value="0" />
	</Style>
	<Style Selector="Button.tool">
	  <Setter Property="MinHeight" Value="28" />
	  <Setter Property="Padding" Value="10,2" />
	</Style>
  </UserControl.Styles>
  <Grid x:Name="LayoutGrid" Margin="4" ColumnDefinitions="*,Auto">
	<Grid.RowDefinitions>
	  <RowDefinition Height="Auto" />
	  <RowDefinition Height="2*" MinHeight="90" />
	  <RowDefinition Height="10" />
	  <RowDefinition Height="3*" MinHeight="90" />
	  <RowDefinition Height="Auto" />
	</Grid.RowDefinitions>
	<WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Classes="toolbar">
	  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,4"
				  ToolTip.Tip="Database the statements run in. The editor suggests only its tables, views, functions and columns. Type to filter the list.">
		<TextBlock Text="Database" VerticalAlignment="Center" />
		<controls:DatabasePicker IsEnabled="{Binding CanChangeDatabase}" MinWidth="180" MaxWidth="320"
								 ItemsSource="{Binding AvailableDatabases}" SelectedItem="{Binding CurrentDatabase}"
								 PlaceholderText="(connection default)" />
		<TextBlock Text="{Binding DatabaseWarning}" Foreground="#FFD08A00" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
				   IsVisible="{Binding DatabaseWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
	  </StackPanel>
	  <Button Content="▶ Run" Classes="accent" Click="OnRun"
			  ToolTip.Tip="Run the selection, or the whole script when nothing is selected (F5 / Ctrl+E)" />
	  <Button Content="▶ Statement" Classes="tool" Click="OnRunStatement"
			  ToolTip.Tip="Run only the statement at the caret (Ctrl+Enter)" />
	  <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
	  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,4"
				  ToolTip.Tip="Re-run the last query at this interval. Only queries that read data are repeated; a tick is skipped while a run is still going, and auto refresh stops when the query fails.">
		<ToggleButton Content="⟳ Auto refresh" IsChecked="{Binding AutoRefresh}" MinHeight="28" Padding="10,2" />
		<ComboBox ItemsSource="{Binding AutoRefreshIntervals}" SelectedItem="{Binding AutoRefreshInterval}" MinWidth="80" />
		<TextBlock Classes="hint" Text="{Binding AutoRefreshInfo}" VerticalAlignment="Center" />
	  </StackPanel>
	  <Button Content="Explain ▾" Classes="tool" ToolTip.Tip="Execution plan of the selection / statement at the caret (Ctrl+L)">
		<Button.Flyout>
		  <MenuFlyout Placement="BottomEdgeAlignedLeft">
			<MenuItem Header="Estimated plan (does not run the query)" InputGesture="Ctrl+L" Click="OnExplain" />
			<MenuItem Header="Explain Analyze (runs it in a transaction that is rolled back)" InputGesture="Ctrl+Shift+L" Click="OnExplainAnalyze" />
		  </MenuFlyout>
		</Button.Flyout>
	  </Button>
	  <Button Content="Lab ▾" Classes="tool" ToolTip.Tip="Experimental: debug a missing row, preview a script's changes or its locks, compare runs, check expectations, and switch the experimental features on or off">
		<Button.Flyout>
		  <MenuFlyout Placement="BottomEdgeAlignedLeft">
			<MenuItem Header="Why isn't my row here? (statement at the caret)…" Click="OnWhyNot" />
			<MenuItem Header="Dry run: execute, show changed rows, roll back" Click="OnDryRun" />
			<MenuItem Header="Lock impact: who would this block? (does not run it)" Click="OnLockImpact" />
			<Separator />
			<MenuItem Header="Pin these results as the baseline (later runs are compared with them)" Command="{Binding PinBaselineCommand}" />
			<MenuItem Header="Clear the baseline" Command="{Binding ClearBaselineCommand}" />
			<MenuItem Header="Add an expectation above this statement (-- expect: rows &gt; 0)" Click="OnInsertExpectation" />
			<Separator />
			<MenuItem Header="Experimental features" IsEnabled="False" />
			<MenuItem x:Name="ResultDiffItem" Header="What changed: compare each run with the previous one" ToggleType="CheckBox" Click="OnToggleExperiment" Tag="ResultDiff" />
			<MenuItem x:Name="ExpectationsItem" Header="Expectations: check -- expect: comments after each run" ToggleType="CheckBox" Click="OnToggleExperiment" Tag="Expectations" />
			<MenuItem x:Name="CostLensItem" Header="Cost lens: planner estimate of the statement at the caret while typing" ToggleType="CheckBox" Click="OnToggleExperiment" Tag="CostLens" />
		  </MenuFlyout>
		</Button.Flyout>
	  </Button>
	  <CheckBox Content="Auto-commit" IsChecked="{Binding AutoCommit}" Margin="4,0,4,4"
				ToolTip.Tip="Off: runs happen inside a transaction that stays open until you Commit or Rollback, so you can check changes first" />
	  <Button Content="✔ Commit" Classes="tool" Command="{Binding CommitCommand}" IsVisible="{Binding HasOpenTransaction}"
			  ToolTip.Tip="Make the changes of the open transaction permanent" />
	  <Button Content="↶ Rollback" Classes="tool" Command="{Binding RollbackCommand}" IsVisible="{Binding HasOpenTransaction}"
			  ToolTip.Tip="Undo everything done since the transaction started" />
	  <TextBlock Text="{Binding TransactionInfo}" IsVisible="{Binding HasOpenTransaction}" Foreground="#E08A00" FontWeight="SemiBold" />
	  <Button Content="✨ AI ▾" Classes="tool" IsVisible="{Binding IsAssistantAvailable}"
			  ToolTip.Tip="AI assistant (Claude) that knows this database's tables and columns. Only names, types and the query text are sent, never row data; nothing it writes is run automatically.">
		<Button.Flyout>
		  <MenuFlyout Placement="BottomEdgeAlignedLeft">
			<MenuItem Header="Write SQL from a sentence…" Click="OnAssistantWrite" />
			<MenuItem Header="Explain this query (selection, statement at the caret, or script)" Click="OnAssistantExplain" />
			<MenuItem Header="Fix the last error" Command="{Binding FixWithAssistantCommand}" />
			<Separator />
			<MenuItem Header="Show / hide the assistant panel" Command="{Binding ToggleAssistantCommand}" />
			<MenuItem Header="Settings (API key, what is sent)…" Command="{Binding OpenAssistantSettingsCommand}" />
		  </MenuFlyout>
		</Button.Flyout>
	  </Button>
	  <Button x:Name="SnippetsButton" Content="Snippets ▾" Classes="tool" Click="OnSnippets"
			  ToolTip.Tip="Insert one of your saved snippets, or save the selection as a new one. Saved snippets are also offered by Ctrl+Space at the start of a statement." />
	  <Button Content="Tools ▾" Classes="tool">
		<Button.Flyout>
		  <MenuFlyout Placement="BottomEdgeAlignedLeft">
			<MenuItem Header="Format" InputGesture="Ctrl+Shift+F" Click="OnFormat" />
			<MenuItem Header="Comment / uncomment lines" InputGesture="Ctrl+OemQuestion" Click="OnToggleComment" />
			<MenuItem Header="UPPER CASE selection" InputGesture="Ctrl+Shift+U" Click="OnUpperCase" />
			<MenuItem Header="lower case selection" InputGesture="Ctrl+Alt+U" Click="OnLowerCase" />
			<MenuItem Header="Duplicate line / selection" InputGesture="Ctrl+D" Click="OnDuplicate" />
			<MenuItem Header="Add next occurrence" InputGesture="Alt+J" Click="OnAddNextOccurrence" />
			<MenuItem Header="Select all occurrences" InputGesture="Ctrl+Alt+Shift+J" Click="OnSelectAllOccurrences" />
			<Separator />
			<MenuItem Header="Find" InputGesture="Ctrl+F" Click="OnFind" />
			<MenuItem Header="Replace" InputGesture="Ctrl+H" Click="OnReplace" />
			<MenuItem Header="Go to definition" InputGesture="F12" Click="OnGoToDefinition" />
			<MenuItem Header="Go to line…" InputGesture="Ctrl+G" Click="OnGoToLine" />
			<Separator IsVisible="{Binding IsAssistantSetupNeeded}" />
			<MenuItem Header="Set up the AI assistant…" IsVisible="{Binding IsAssistantSetupNeeded}" Command="{Binding OpenAssistantSettingsCommand}" />
			<Separator />
			<MenuItem x:Name="WordWrapItem" Header="Word wrap" InputGesture="Alt+Z" ToggleType="CheckBox" Click="OnToggleWordWrap" />
			<MenuItem Header="Zoom in (Ctrl+= or Ctrl+wheel)" Click="OnZoomIn" />
			<MenuItem Header="Zoom out (Ctrl+-)" Click="OnZoomOut" />
			<MenuItem Header="Reset zoom (Ctrl+0)" Click="OnZoomReset" />
		  </MenuFlyout>
		</Button.Flyout>
	  </Button>
	  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,4" ToolTip.Tip="Rows kept per result set (0 = all). Larger results are read to the end but not kept, so the app stays responsive.">
		<TextBlock Text="Max rows" VerticalAlignment="Center" />
		<NumericUpDown Value="{Binding MaxRows}" Minimum="0" Maximum="10000000" Increment="10000" FormatString="N0" Width="160" />
	  </StackPanel>
	  <CheckBox Content="Run on multiple databases" IsChecked="{Binding RunOnMultipleDatabases}" Margin="0,0,8,4"
				ToolTip.Tip="Run the same script on every selected database and stack the results with a Database column" />
	  <Button Content="{Binding TargetSummary, StringFormat='{}{0} ▾'}" IsVisible="{Binding RunOnMultipleDatabases}">
		<Button.Flyout>
		  <Flyout Placement="BottomEdgeAlignedLeft">
			<StackPanel Width="340" Spacing="6">
			  <TextBox Text="{Binding DatabaseFilter}" Watermark="Filter databases…" />
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Select all" Command="{Binding SelectAllDatabasesCommand}" CommandParameter="{x:True}" />
				<Button Content="None" Command="{Binding SelectAllDatabasesCommand}" CommandParameter="{x:False}" />
				<Button Content="Reload" Command="{Binding LoadDatabasesCommand}" />
			  </StackPanel>
			  <ScrollViewer MaxHeight="320">
				<ItemsControl ItemsSource="{Binding VisibleDatabases}">
				  <ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:DatabaseChoice">
					  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,1" />
					</DataTemplate>
				  </ItemsControl.ItemTemplate>
				</ItemsControl>
			  </ScrollViewer>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<TextBlock Text="Parallel" VerticalAlignment="Center" />
				<NumericUpDown Width="110" Minimum="1" Maximum="16" Increment="1" FormatString="0" Value="{Binding Parallelism}" />
			  </StackPanel>
			  <TextBlock Classes="hint" Text="{Binding DatabaseListStatus}" TextWrapping="Wrap" />
			</StackPanel>
		  </Flyout>
		</Button.Flyout>
	  </Button>
	  <ProgressBar Width="100" MinWidth="100" IsIndeterminate="True" IsVisible="{Binding IsRunning}" />
	  <TextBlock Text="{Binding RunningElapsed}" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" Margin="0,0,8,4"
				 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" ToolTip.Tip="Time since the run started" />
	  <TextBlock Classes="hint" Text="{Binding Status}" TextWrapping="Wrap" />
	</WrapPanel>

	<Popup Grid.Row="1" x:Name="SignaturePopup" IsLightDismissEnabled="False" Placement="TopEdgeAlignedLeft">
	  <Border Background="{DynamicResource AppPopupBackgroundBrush}" BorderBrush="{DynamicResource AppPopupBorderBrush}"
			  BorderThickness="1" CornerRadius="4" Padding="8,4">
		<TextBlock x:Name="SignatureText" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
	  </Border>
	</Popup>
	<Popup Grid.Row="1" x:Name="GoToLinePopup" IsLightDismissEnabled="True" Placement="TopEdgeAlignedRight">
	  <Border Background="{DynamicResource AppPopupBackgroundBrush}" BorderBrush="{DynamicResource AppPopupBorderBrush}"
			  BorderThickness="1" CornerRadius="4" Padding="8">
		<StackPanel Orientation="Horizontal" Spacing="6">
		  <TextBlock Text="Go to line" VerticalAlignment="Center" />
		  <TextBox x:Name="GoToLineBox" Width="90" KeyDown="OnGoToLineKeyDown" />
		</StackPanel>
	  </Border>
	</Popup>
	<!-- Editor and its hint bar share one row so the splitter below sits directly between editor and results -->
	<DockPanel Grid.Row="1">
	<Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="2,2,2,0">
	  <TextBlock Grid.Column="0" Classes="hint" FontSize="11" TextTrimming="CharacterEllipsis"
				 Text="Ctrl+Space suggest · F5 run · Ctrl+Enter statement · Ctrl+L plan · F12/Ctrl+Click definition · Ctrl+Shift+F format · Ctrl+/ comment · Ctrl+D duplicate · Alt+↑↓ move line · Alt+Z wrap · Ctrl+wheel zoom" />
	  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
		<TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding CostLensText}" Foreground="{Binding CostLensBrush}" VerticalAlignment="Center"
				   ToolTip.Tip="{Binding CostLensDetail}" MaxWidth="460" TextTrimming="CharacterEllipsis"
				   IsVisible="{Binding CostLensText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		<TextBlock Classes="hint" FontSize="11" Text="{Binding BaselineInfo}" VerticalAlignment="Center"
				   ToolTip.Tip="Runs of the same query are compared with these pinned results (Lab ▾ › Clear the baseline)"
				   IsVisible="{Binding BaselineInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		<TextBlock Classes="hint" FontSize="11" Text="{Binding CompletionInfo}" VerticalAlignment="Center" />
		<TextBlock x:Name="CaretInfo" Classes="hint" FontSize="11" VerticalAlignment="Center" />
		<Button x:Name="ZoomInfo" Classes="layout" IsVisible="False" Click="OnZoomReset" ToolTip.Tip="Editor zoom · click to reset (Ctrl+0)" />
		<StackPanel Orientation="Horizontal" Spacing="2">
		  <Button Classes="layout" Content="⬆" Click="OnMaximizeResults" ToolTip.Tip="Give the results most of the space (Ctrl+Shift+↑)" />
		  <Button Classes="layout" Content="⇕" Click="OnResetLayout" ToolTip.Tip="Reset the editor / results split (or double-click the divider)" />
		  <Button Classes="layout" Content="⬇" Click="OnMaximizeEditor" ToolTip.Tip="Give the editor most of the space (Ctrl+Shift+↓)" />
		</StackPanel>
	  </StackPanel>
	</Grid>
	<Border BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="6" ClipToBounds="True">
	  <ae:TextEditor x:Name="Editor" ShowLineNumbers="True" WordWrap="False"
					 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="13"
					 Background="{DynamicResource AppCodeBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}"
					 LineNumbersForeground="{DynamicResource AppHintForegroundBrush}"
					 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="4,4,0,0" />
	</Border>
	</DockPanel>

	<!-- Drag to resize editor vs results; the grip is drawn underneath and ignores the pointer -->
	<Border Grid.Row="2" Width="40" Height="4" CornerRadius="2" IsHitTestVisible="False"
			HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AppBorderBrush}" />
	<GridSplitter x:Name="ResultsSplitter" Grid.Row="2" ResizeDirection="Rows" Background="Transparent"
				  ToolTip.Tip="Drag to resize the editor and results · double-click to reset" />

	<TabControl Grid.Row="3" ItemsSource="{Binding ResultSets}">
	  <TabControl.ItemTemplate>
		<DataTemplate x:DataType="vm:ResultSetView">
		  <TextBlock Text="{Binding Title}" />
		</DataTemplate>
	  </TabControl.ItemTemplate>
	  <TabControl.ContentTemplate>
		<DataTemplate x:DataType="vm:ResultSetView">
		  <views:ResultGridView ResultSet="{Binding}" />
		</DataTemplate>
	  </TabControl.ContentTemplate>
	</TabControl>

	<!-- Server messages (PRINT, rows affected, per-database results): collapsed to one line until needed -->
	<Expander Grid.Row="4" HorizontalAlignment="Stretch" Margin="0,2,0,0" Padding="4" MinHeight="0"
			  IsVisible="{Binding !!Messages.Count}"
			  Header="{Binding Messages.Count, StringFormat='Messages ({0})'}">
	  <ScrollViewer MaxHeight="160">
		<ItemsControl ItemsSource="{Binding Messages}">
		  <ItemsControl.ItemTemplate>
			<DataTemplate>
			  <SelectableTextBlock Foreground="{DynamicResource AppHintForegroundBrush}" Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
			</DataTemplate>
		  </ItemsControl.ItemTemplate>
		</ItemsControl>
	  </ScrollViewer>
	</Expander>

	<!-- AI assistant, beside the editor and results: asks Claude with the catalog's names and types; its SQL is inserted only on request -->
	<Border Grid.Row="1" Grid.RowSpan="4" Grid.Column="1" Width="400" Margin="6,0,0,0" Padding="8" IsVisible="{Binding IsAssistantOpen}"
			BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="6">
	  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
		<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
		  <TextBlock Text="✨ AI assistant" FontWeight="SemiBold" VerticalAlignment="Center" />
		  <Button Grid.Column="1" Classes="layout" Content="✕" Command="{Binding ToggleAssistantCommand}" ToolTip.Tip="Hide the assistant" />
		</Grid>
		<TextBox Grid.Row="1" x:Name="AssistantRequestBox" Text="{Binding AssistantRequest}" AcceptsReturn="True" TextWrapping="Wrap"
				 MinHeight="56" MaxHeight="140" KeyDown="OnAssistantRequestKeyDown"
				 Watermark="Describe the query, e.g. top 10 customers by order total this year" />
		<WrapPanel Grid.Row="2" Margin="0,6,0,0">
		  <Button Content="Write SQL" Classes="accent" Margin="0,0,6,4" Command="{Binding AskAssistantCommand}"
				  ToolTip.Tip="Write SQL for the request above (Ctrl+Enter)" />
		  <Button Content="Explain" Classes="tool" Margin="0,0,6,4" Click="OnAssistantExplain"
				  ToolTip.Tip="Explain the selection, the statement at the caret, or the whole script" />
		  <Button Content="Fix error" Classes="tool" Margin="0,0,6,4" Command="{Binding FixWithAssistantCommand}"
				  ToolTip.Tip="Explain why the last run failed and propose a corrected query" />
		  <Button Content="Cancel" Margin="0,0,6,4" Command="{Binding CancelAssistantCommand}" IsVisible="{Binding IsAssistantBusy}" />
		</WrapPanel>
		<StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,6">
		  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsAssistantBusy}" />
		  <TextBlock Classes="hint" Text="{Binding AssistantStatus}" TextWrapping="Wrap"
					 IsVisible="{Binding AssistantStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		  <ScrollViewer MaxHeight="220" IsVisible="{Binding AssistantAnswer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
			<SelectableTextBlock Text="{Binding AssistantAnswer}" TextWrapping="Wrap" />
		  </ScrollViewer>
		</StackPanel>
		<TextBox Grid.Row="4" Text="{Binding AssistantSql}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
				 VerticalContentAlignment="Top" IsVisible="{Binding HasAssistantSql}"
				 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
				 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12"
				 Background="{DynamicResource AppCodeBackgroundBrush}" />
		<StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" IsVisible="{Binding HasAssistantSql}">
		  <Button Content="Insert" Classes="accent" Click="OnAssistantInsert"
				  ToolTip.Tip="Put the SQL in the editor: it replaces the selection, or goes in below the caret's line. It is not run." />
		  <Button Content="Copy" Classes="tool" Command="{Binding CopyAssistantSqlCommand}" />
		</StackPanel>
		<TextBlock Grid.Row="6" Classes="hint" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
				   Text="Sends table, column and key names and types plus the query text to Anthropic. Never row data. Nothing is run automatically." />
	  </Grid>
	</Border>
  </Grid>
</UserControl>
