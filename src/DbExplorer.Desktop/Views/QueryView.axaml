<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:DbExplorer.Desktop.ViewModels"
			 xmlns:views="using:DbExplorer.Desktop.Views"
			 x:Class="DbExplorer.Desktop.Views.QueryView">
  <Grid Margin="8" RowDefinitions="Auto,2*,6,3*,Auto">
	<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
	  <Button Content="Execute (F5)" Classes="accent" Command="{Binding ExecuteCommand}" />
	  <ProgressBar Width="100" VerticalAlignment="Center" IsIndeterminate="True" IsVisible="{Binding IsRunning}" />
	</StackPanel>

	<TextBox Grid.Row="1" x:Name="Editor" Classes="code" Text="{Binding Sql}"
			 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
			 VerticalAlignment="Stretch" VerticalContentAlignment="Top"
			 Watermark="Write a SQL query or script and click Execute…"
			 ScrollViewer.HorizontalScrollBarVisibility="Auto"
			 ScrollViewer.VerticalScrollBarVisibility="Auto" />

	<Popup Grid.Row="1" x:Name="SuggestionsPopup" PlacementTarget="{Binding #Editor}"
		   Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True" IsOpen="False">
	  <Border Background="#1E1E1E" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="2" MaxHeight="180" MinWidth="180">
		<ListBox x:Name="SuggestionsList" ItemsSource="{Binding Suggestions}"
				 SelectedIndex="0" Background="Transparent" BorderThickness="0" />
	  </Border>
	</Popup>

	<GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="Transparent" />

	<TabControl Grid.Row="3" ItemsSource="{Binding ResultSets}">
	  <TabControl.ItemTemplate>
		<DataTemplate x:DataType="vm:ResultSetView">
		  <TextBlock Text="{Binding Title}" />
		</DataTemplate>
	  </TabControl.ItemTemplate>
	  <TabControl.ContentTemplate>
		<DataTemplate x:DataType="vm:ResultSetView">
		  <views:ResultGridView ResultSet="{Binding}" />
		</DataTemplate>
	  </TabControl.ContentTemplate>
	</TabControl>

	<Grid Grid.Row="4" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
	  <TextBlock Grid.Row="0" Classes="hint" Text="{Binding Status}" TextWrapping="Wrap" />
	  <ItemsControl Grid.Row="1" ItemsSource="{Binding Messages}" Margin="0,2,0,0">
		<ItemsControl.ItemTemplate>
		  <DataTemplate>
			<TextBlock Classes="hint" Text="{Binding}" TextWrapping="Wrap" />
		  </DataTemplate>
		</ItemsControl.ItemTemplate>
	  </ItemsControl>
	</Grid>
  </Grid>
</UserControl>
