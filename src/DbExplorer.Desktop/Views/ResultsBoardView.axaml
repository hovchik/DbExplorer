<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DbExplorer.Desktop.Controls"
             xmlns:vm="using:DbExplorer.Desktop.ViewModels"
             x:Class="DbExplorer.Desktop.Views.ResultsBoardView"
             x:DataType="vm:ResultsBoardViewModel">
  <UserControl.Styles>
    <!-- Layout switch: two buttons that read as one segmented control -->
    <Style Selector="Button.segment">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.segment.selected">
      <Setter Property="Background" Value="{DynamicResource AppBarGroupBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.segment.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppBarGroupBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBarGroupBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- One result: a card with its source above the grid -->
    <Style Selector="Border.pane">
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.paneHeader">
      <Setter Property="Background" Value="{DynamicResource AppBarBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="8,5,4,5" />
    </Style>
    <Style Selector="Border.number">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.number TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.paneTool">
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.paneTool:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style Selector="Button.paneTool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}" />
    </Style>
    <Style Selector="Button.paneTool:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="0,6,0,0">
    <!-- What is on the board, and how it is laid out -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <controls:StrokeIcon Data="{x:Static controls:Icons.SideBySide}" Width="16" Height="16" VerticalAlignment="Center" />
        <TextBlock Text="Side by side" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
        <TextBlock Classes="hint" Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding HasItems}">
        <Border CornerRadius="7" Padding="2" Background="{DynamicResource AppSubtleBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="ColumnsButton" Classes="segment" Classes.selected="{Binding IsColumns}"
                    ToolTip.Tip="Results next to each other, left to right" AutomationProperties.Name="Columns layout">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <controls:StrokeIcon Data="{x:Static controls:Icons.SideBySide}" Width="13" Height="13" VerticalAlignment="Center" />
                <TextBlock Text="Columns" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="RowsButton" Classes="segment" Classes.selected="{Binding IsRows}"
                    ToolTip.Tip="Results one above the other: more room for wide results" AutomationProperties.Name="Rows layout">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <controls:StrokeIcon Data="{x:Static controls:Icons.Rows}" Width="13" Height="13" VerticalAlignment="Center" />
                <TextBlock Text="Rows" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <CheckBox Content="Scroll together" IsChecked="{Binding SyncScroll}" Margin="0" FontSize="12"
                  ToolTip.Tip="Scrolling one result scrolls the others to the same row number (and the same distance sideways)" />
        <Button Classes="compact" Content="Clear all" Command="{Binding ClearCommand}"
                ToolTip.Tip="Remove every result from the board. Your Query tabs keep their own results." />
      </StackPanel>
    </Grid>

    <Panel>
      <!-- The results, laid out by the code-behind as columns or rows with splitters between them -->
      <Grid x:Name="Board" IsVisible="{Binding HasItems}" />

      <!-- Nothing on the board yet: how to put something here -->
      <Border IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Padding="24">
        <StackPanel Spacing="12">
          <controls:StrokeIcon Data="{x:Static controls:Icons.SideBySide}" Width="40" Height="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppHintForegroundBrush}" />
          <TextBlock Text="Compare results by eye" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                     Text="Run a query in one Query tab and another query in a second tab, on any connection or database. Then press Side by side above each result grid (or right-click the result, or Ctrl+Alt+B) and they show up here next to each other." />
          <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                     Text="Each result is a snapshot: nothing here runs a query, and nothing is merged. Running the query again in its tab leaves the board as it is." />
        </StackPanel>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
