<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DbExplorer.Desktop.Controls"
             xmlns:vm="using:DbExplorer.Desktop.ViewModels"
             x:Class="DbExplorer.Desktop.Views.SecurityView">
  <UserControl.Styles>
    <Style Selector="Border.badge">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource AppObjectOtherBrush}" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge.login">
      <Setter Property="Background" Value="{DynamicResource AppObjectProcedureBrush}" />
    </Style>
    <Style Selector="Border.badge.user">
      <Setter Property="Background" Value="{DynamicResource AppObjectViewBrush}" />
    </Style>
    <Style Selector="Border.badge.role">
      <Setter Property="Background" Value="{DynamicResource AppObjectFunctionBrush}" />
    </Style>
    <Style Selector="Border.badge.serverrole">
      <Setter Property="Background" Value="{DynamicResource AppObjectTriggerBrush}" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.row.adding">
      <Setter Property="Background" Value="{DynamicResource AppCellNewBrush}" />
    </Style>
    <Style Selector="Border.row.removing">
      <Setter Property="Background" Value="{DynamicResource AppCellDeletedBrush}" />
    </Style>
    <Style Selector="Border.row.removing TextBlock.name">
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="TextBlock.dropped">
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="TextBlock.deny">
      <Setter Property="Foreground" Value="{DynamicResource AppPlanHotBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Grid.header TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="4">
    <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
      <TextBlock Text="Database" />
      <controls:DatabasePicker Width="180" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}"
                               ToolTip.Tip="Database whose users, roles and permissions are shown. Type to filter the list." />
      <Button Content="Refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="Read logins, users, roles and permissions again" />
      <TextBox Width="180" Text="{Binding Filter}" Watermark="Filter by name" />
      <ComboBox Width="140" ItemsSource="{Binding KindFilters}" SelectedItem="{Binding KindFilter}" />
      <CheckBox Content="Show built-in" IsChecked="{Binding ShowSystem}"
                ToolTip.Tip="Also list built-in principals such as sa, dbo, public, fixed roles and pg_* roles" />
      <Button Content="＋ New login…" Command="{Binding NewLoginCommand}" ToolTip.Tip="A login with a password (PostgreSQL: a role WITH LOGIN)" />
      <Button Content="＋ New role…" Command="{Binding NewRoleCommand}" ToolTip.Tip="A role to group permissions and members" />
      <ProgressBar Width="80" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      <TextBlock Classes="hint" Text="{Binding Status}" TextWrapping="Wrap" />
    </WrapPanel>

    <Border DockPanel.Dock="Top" IsVisible="{Binding HasWarnings}" Padding="8,4" Margin="0,0,0,4" CornerRadius="6"
            Background="{DynamicResource AppCellEditedBrush}">
      <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" />
    </Border>

    <Grid ColumnDefinitions="300,6,*,6,400" MinHeight="0">
      <!-- Principals -->
      <ListBox Grid.Column="0" ItemsSource="{Binding Principals}" SelectedItem="{Binding SelectedPrincipal}"
               BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="6">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PrincipalItem">
            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
              <Border Grid.Column="0" Classes="badge" Classes.login="{Binding IsLoginKind}" Classes.user="{Binding IsUserKind}"
                      Classes.role="{Binding IsRoleKind}" Classes.serverrole="{Binding IsServerRoleKind}" Margin="0,0,8,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Badge}" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Classes.dropped="{Binding IsPendingDrop}" />
                <TextBlock Classes="hint" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />

      <!-- Details of the selected principal -->
      <Grid Grid.Column="2">
        <TextBlock Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                   IsVisible="{Binding !HasSelection}"
                   Text="Pick a login, user or role to see its roles, members and permissions. Changes you make here wait in the list on the right until you apply them." />
        <ScrollViewer IsVisible="{Binding HasSelection}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="4,0,8,8">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding DetailTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="hint" Text="{Binding DetailType}" TextWrapping="Wrap" />
              <TextBlock Classes="hint" Text="{Binding DetailFacts}" TextWrapping="Wrap" />
              <WrapPanel Margin="0,6,0,0">
                <Button Content="Change password…" Command="{Binding SetPasswordCommand}" IsVisible="{Binding CanSetPassword}" Margin="0,0,6,4" />
                <Button Content="{Binding ToggleLoginLabel}" Command="{Binding ToggleLoginCommand}" IsVisible="{Binding CanToggleLogin}" Margin="0,0,6,4" />
                <Button Content="Create user in this database" Command="{Binding CreateUserForLoginCommand}" IsVisible="{Binding CanCreateUserForLogin}" Margin="0,0,6,4"
                        ToolTip.Tip="CREATE USER … FOR LOGIN, so the login can use the selected database" />
                <Button Content="Drop…" Command="{Binding DropCommand}" IsVisible="{Binding CanDrop}" Margin="0,0,6,4"
                        ToolTip.Tip="Adds a DROP to the pending changes (with what must go first: PostgreSQL privileges here, SQL Server role members)" />
              </WrapPanel>
            </StackPanel>

            <!-- Member of -->
            <StackPanel Spacing="4" IsVisible="{Binding SelectedTakesRoles}">
              <TextBlock Classes="section" Text="Member of" />
              <TextBlock Classes="hint" Text="Not a member of any role." IsVisible="{Binding !MemberOf.Count}" />
              <ItemsControl ItemsSource="{Binding MemberOf}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MembershipItem">
                    <Border Classes="row" Classes.adding="{Binding IsAdding}" Classes.removing="{Binding IsRemoving}">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Classes="name" Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Note}" VerticalAlignment="Center" Margin="8,0" />
                        <Button Grid.Column="2" Classes="icon" Content="{Binding ActionGlyph}" ToolTip.Tip="{Binding ActionTip}" CommandParameter="{Binding}"
                                Command="{Binding $parent[UserControl].DataContext.RemoveMembershipCommand}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="hint" Text="{Binding InheritedRoles}" TextWrapping="Wrap"
                         IsVisible="{Binding InheritedRoles, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <AutoCompleteBox Width="240" ItemsSource="{Binding RoleChoices}" Text="{Binding RoleToAdd, Mode=TwoWay}"
                                 FilterMode="Contains" MinimumPrefixLength="0" Watermark="Role" GotFocus="OnPickerFocus" />
                <Button Classes="compact" Content="＋ Add to role" Command="{Binding AddToRoleCommand}" />
              </StackPanel>
            </StackPanel>

            <!-- Members -->
            <StackPanel Spacing="4" IsVisible="{Binding SelectedAcceptsMembers}">
              <TextBlock Classes="section" Text="Members" />
              <TextBlock Classes="hint" Text="No members." IsVisible="{Binding !Members.Count}" />
              <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MembershipItem">
                    <Border Classes="row" Classes.adding="{Binding IsAdding}" Classes.removing="{Binding IsRemoving}">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Classes="name" Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Note}" VerticalAlignment="Center" Margin="8,0" />
                        <Button Grid.Column="2" Classes="icon" Content="{Binding ActionGlyph}" ToolTip.Tip="{Binding ActionTip}" CommandParameter="{Binding}"
                                Command="{Binding $parent[UserControl].DataContext.RemoveMembershipCommand}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <AutoCompleteBox Width="240" ItemsSource="{Binding MemberChoices}" Text="{Binding MemberToAdd, Mode=TwoWay}"
                                 FilterMode="Contains" MinimumPrefixLength="0" Watermark="Login, user or role" GotFocus="OnPickerFocus" />
                <Button Classes="compact" Content="＋ Add member" Command="{Binding AddMemberCommand}" />
              </StackPanel>
            </StackPanel>

            <!-- Permissions -->
            <StackPanel Spacing="4" IsVisible="{Binding SelectedTakesGrants}">
              <TextBlock Classes="section" Text="Permissions" />
              <TextBlock Classes="hint" TextWrapping="Wrap"
                         Text="Given to this principal directly. Permissions that come through its roles are on those roles." />
              <Grid Classes="header" ColumnDefinitions="170,*,190,120,30" Margin="6,0" IsVisible="{Binding !!Grants.Count}">
                <TextBlock Grid.Column="0" Text="Permission" />
                <TextBlock Grid.Column="1" Text="On" />
                <TextBlock Grid.Column="2" Text="State" />
                <TextBlock Grid.Column="3" Text="Granted by" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Grants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GrantItem">
                    <Border Classes="row" Classes.adding="{Binding IsAdding}" Classes.removing="{Binding IsRemoving}">
                      <Grid ColumnDefinitions="170,*,190,120,30">
                        <TextBlock Grid.Column="0" Classes="name" Text="{Binding Permission}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Classes="name" Text="{Binding On}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Kind}" />
                        <TextBlock Grid.Column="2" Text="{Binding State}" Classes.deny="{Binding IsDeny}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Classes="hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Note}" ToolTip.Tip="{Binding Note}" />
                        <Button Grid.Column="4" Classes="icon" Content="{Binding ActionGlyph}" ToolTip.Tip="{Binding ActionTip}" CommandParameter="{Binding}"
                                Command="{Binding $parent[UserControl].DataContext.RevokeCommand}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel Margin="0,4,0,0">
                <AutoCompleteBox Width="170" ItemsSource="{Binding PermissionChoices}" Text="{Binding GrantPermission, Mode=TwoWay}"
                                 FilterMode="StartsWith" MinimumPrefixLength="0" Watermark="Permission" GotFocus="OnPickerFocus" Margin="0,0,6,4" />
                <AutoCompleteBox Width="280" ItemsSource="{Binding GrantTargets}" Text="{Binding GrantTarget, Mode=TwoWay}"
                                 FilterMode="Contains" MinimumPrefixLength="0" Watermark="DATABASE, SCHEMA name or schema.object" GotFocus="OnPickerFocus" Margin="0,0,6,4" />
                <CheckBox Content="With grant option" IsChecked="{Binding WithGrantOption}" Margin="0,0,6,4"
                          ToolTip.Tip="Lets the grantee pass the permission on" />
                <Button Classes="compact" Content="＋ Grant" Command="{Binding GrantCommand}" Margin="0,0,6,4" />
                <Button Classes="compact" Content="Deny" Command="{Binding DenyCommand}" IsVisible="{Binding CanDeny}" Margin="0,0,6,4"
                        ToolTip.Tip="Refuse the permission even when a role grants it" />
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <GridSplitter Grid.Column="3" Width="6" Background="Transparent" ResizeDirection="Columns" />

      <!-- Pending changes and script -->
      <Border Grid.Column="4" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="6">
        <DockPanel Margin="8">
          <TextBlock DockPanel.Dock="Top" Text="Pending changes" FontWeight="SemiBold" FontSize="14" />
          <TextBlock DockPanel.Dock="Top" Classes="hint" TextWrapping="Wrap" Margin="0,2,0,6" IsVisible="{Binding !HasPending}"
                     Text="Nothing yet. Edits wait here, and Apply shows the script and runs it in one transaction." />
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Classes="accent" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" IsEnabled="{Binding HasPending}" Margin="0,0,6,4"
                    ToolTip.Tip="Show the script, confirm, then run it in one transaction" />
            <Button Content="Copy script" Command="{Binding CopyScriptCommand}" IsEnabled="{Binding HasPending}" Margin="0,0,6,4"
                    ToolTip.Tip="Copies the script with passwords masked" />
            <Button Content="Open in Query tab" Command="{Binding OpenInQueryCommand}" IsEnabled="{Binding HasPending}" Margin="0,0,6,4" />
            <Button Content="Discard all" Command="{Binding DiscardAllCommand}" IsEnabled="{Binding HasPending}" Margin="0,0,6,4" />
          </WrapPanel>
          <Grid RowDefinitions="Auto,*">
            <ItemsControl Grid.Row="0" ItemsSource="{Binding Pending}" MaxHeight="220">
              <ItemsControl.Template>
                <ControlTemplate>
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter />
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PendingItem">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="icon" Content="✕" ToolTip.Tip="Remove this change" CommandParameter="{Binding}"
                            Command="{Binding $parent[UserControl].DataContext.RemovePendingCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox Grid.Row="1" Classes="code" Text="{Binding Script}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     Margin="0,8,0,0" IsVisible="{Binding HasPending}" VerticalContentAlignment="Top" />
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
