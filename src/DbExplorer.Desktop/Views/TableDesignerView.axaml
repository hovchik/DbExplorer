<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DbExplorer.Desktop.Controls"
             xmlns:vm="using:DbExplorer.Desktop.ViewModels"
             x:Class="DbExplorer.Desktop.Views.TableDesignerView">
  <UserControl.Styles>
    <Style Selector="ItemsControl.rows CheckBox">
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="ItemsControl.rows TextBox, ItemsControl.rows AutoCompleteBox, ItemsControl.rows ComboBox">
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="Grid.header TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="4">
    <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
      <TextBlock Text="Database" />
      <controls:DatabasePicker Width="180" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}"
                               ToolTip.Tip="Database the table is created in. Type to filter the list." />
      <TextBlock Text="Schema" />
      <AutoCompleteBox Width="130" ItemsSource="{Binding Schemas}" Text="{Binding Schema, Mode=TwoWay}"
                       FilterMode="StartsWith" MinimumPrefixLength="0" GotFocus="OnPickerFocus"
                       ToolTip.Tip="An existing schema, or a new one (the script creates it)" />
      <TextBlock Text="Table" />
      <TextBox Width="240" Text="{Binding TableName}" Watermark="Table name" />
      <Button Content="New table" Command="{Binding NewTableCommand}" ToolTip.Tip="Start over with an empty design" />
      <AutoCompleteBox Width="220" ItemsSource="{Binding TableNames}" Text="{Binding OpenTableName, Mode=TwoWay}"
                       FilterMode="Contains" MinimumPrefixLength="0" GotFocus="OnPickerFocus" Watermark="schema.table"
                       ToolTip.Tip="An existing table of this database to change" />
      <Button Content="Open table" Command="{Binding OpenExistingTableCommand}"
              ToolTip.Tip="Open an existing table: edit it and the designer writes the ALTER script" />
      <Button Content="Revert" Command="{Binding RevertChangesCommand}" IsVisible="{Binding IsAltering}"
              ToolTip.Tip="Undo every edit: back to the table as it is on the server" />
      <Button Content="Open created table" Command="{Binding OpenCreatedCommand}" IsVisible="{Binding LastCreated, Converter={x:Static ObjectConverters.IsNotNull}}"
              ToolTip.Tip="Show the table you just created in the Objects tab" />
      <TextBlock Classes="hint" Text="{Binding Status}" TextWrapping="Wrap" />
    </WrapPanel>

    <Grid MinHeight="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" />
        <ColumnDefinition Width="6" />
        <!-- About 400 px at 1400 px; shrinks with the window so the editor keeps its room -->
        <ColumnDefinition Width="2*" MinWidth="240" MaxWidth="440" />
      </Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Margin="0,4,8,8">

          <!-- Columns -->
          <StackPanel Spacing="4">
            <TextBlock Classes="section" Text="{Binding ModeText}" />
            <TextBlock Classes="hint" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left" IsVisible="{Binding IsAltering}"
                       Text="Edit columns, keys and indexes; the script below holds only the ALTER statements for what changed. New columns are added at the end." />
            <Grid Classes="header" ColumnDefinitions="200,170,80,52,52,64,170,Auto" Margin="0,0,0,2">
              <TextBlock Grid.Column="0" Text="Name" />
              <TextBlock Grid.Column="1" Text="Type" />
              <TextBlock Grid.Column="2" Text="Size" ToolTip.Tip="Length (100, max) or precision,scale (18,2)" />
              <TextBlock Grid.Column="3" Text="Null" HorizontalAlignment="Center" ToolTip.Tip="Allows NULL" />
              <TextBlock Grid.Column="4" Text="Key" HorizontalAlignment="Center" ToolTip.Tip="Part of the primary key" />
              <TextBlock Grid.Column="5" Text="Identity" HorizontalAlignment="Center" ToolTip.Tip="Values generated by the server" />
              <TextBlock Grid.Column="6" Text="Default" ToolTip.Tip="SQL expression, e.g. 0, N'new', SYSUTCDATETIME(), now()" />
            </Grid>
            <ItemsControl Classes="rows" ItemsSource="{Binding Columns}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ColumnRow">
                  <Grid ColumnDefinitions="200,170,80,52,52,64,170,Auto" Margin="0,0,0,4">
                    <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="Column name" ToolTip.Tip="{Binding Origin}" />
                    <AutoCompleteBox Grid.Column="1" Text="{Binding Type, Mode=TwoWay}" Watermark="Type"
                                     ItemsSource="{Binding $parent[UserControl].DataContext.TypeNames}"
                                     FilterMode="StartsWith" MinimumPrefixLength="0" GotFocus="OnPickerFocus" />
                    <TextBox Grid.Column="2" Text="{Binding Size}" Watermark="size" />
                    <CheckBox Grid.Column="3" IsChecked="{Binding IsNullable}" IsEnabled="{Binding !IsPrimaryKey}" />
                    <CheckBox Grid.Column="4" IsChecked="{Binding IsPrimaryKey}" />
                    <CheckBox Grid.Column="5" IsChecked="{Binding IsIdentity}" />
                    <TextBox Grid.Column="6" Text="{Binding Default}" Watermark="default" />
                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2">
                      <Button Classes="icon" Content="↑" ToolTip.Tip="Move up" CommandParameter="{Binding}"
                              Command="{Binding $parent[UserControl].DataContext.MoveColumnUpCommand}" />
                      <Button Classes="icon" Content="↓" ToolTip.Tip="Move down" CommandParameter="{Binding}"
                              Command="{Binding $parent[UserControl].DataContext.MoveColumnDownCommand}" />
                      <Button Classes="icon" Content="✕" ToolTip.Tip="Remove column" CommandParameter="{Binding}"
                              Command="{Binding $parent[UserControl].DataContext.RemoveColumnCommand}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="compact" Content="＋ Add column" Command="{Binding AddColumnCommand}" HorizontalAlignment="Left" />
          </StackPanel>

          <!-- Foreign keys -->
          <StackPanel Spacing="4">
            <TextBlock Classes="section" Text="Foreign keys" />
            <TextBlock Classes="hint" Text="A column of this table that must match a key of an existing table." IsVisible="{Binding !HasForeignKeys}" />
            <Grid Classes="header" ColumnDefinitions="200,260,180,200,Auto" IsVisible="{Binding HasForeignKeys}">
              <TextBlock Grid.Column="0" Text="Column" />
              <TextBlock Grid.Column="1" Text="References table" />
              <TextBlock Grid.Column="2" Text="Column" />
              <TextBlock Grid.Column="3" Text="Name (optional)" />
            </Grid>
            <ItemsControl Classes="rows" ItemsSource="{Binding ForeignKeys}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ForeignKeyRow">
                  <Grid ColumnDefinitions="200,260,180,200,Auto" Margin="0,0,0,4">
                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding ColumnChoices}" SelectedItem="{Binding Column}"
                              PlaceholderText="Column" />
                    <AutoCompleteBox Grid.Column="1" ItemsSource="{Binding TableChoices}" Text="{Binding ReferencedTable, Mode=TwoWay}"
                                     FilterMode="Contains" MinimumPrefixLength="0" Watermark="schema.table" GotFocus="OnPickerFocus" />
                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding ReferencedColumnChoices}"
                              SelectedItem="{Binding ReferencedColumn}" PlaceholderText="Key column" />
                    <TextBox Grid.Column="3" Text="{Binding Name}" Watermark="FK_… (automatic)" />
                    <Button Grid.Column="4" Classes="icon" Content="✕" ToolTip.Tip="Remove foreign key" CommandParameter="{Binding}"
                            Command="{Binding $parent[UserControl].DataContext.RemoveForeignKeyCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="compact" Content="＋ Add foreign key" Command="{Binding AddForeignKeyCommand}" HorizontalAlignment="Left" />
          </StackPanel>

          <!-- Indexes -->
          <StackPanel Spacing="4">
            <TextBlock Classes="section" Text="Indexes" />
            <TextBlock Classes="hint" Text="The primary key is indexed already. Add indexes for columns you search or join on." IsVisible="{Binding !HasIndexes}" />
            <Grid Classes="header" ColumnDefinitions="380,64,200,Auto" IsVisible="{Binding HasIndexes}">
              <TextBlock Grid.Column="0" Text="Columns (comma-separated, in order)" />
              <TextBlock Grid.Column="1" Text="Unique" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="Name (optional)" />
            </Grid>
            <ItemsControl Classes="rows" ItemsSource="{Binding Indexes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IndexRow">
                  <Grid ColumnDefinitions="380,64,200,Auto" Margin="0,0,0,4">
                    <TextBox Grid.Column="0" Text="{Binding Columns}" Watermark="CustomerId, CreatedAt" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsUnique}" />
                    <TextBox Grid.Column="2" Text="{Binding Name}" Watermark="IX_… (automatic)" />
                    <Button Grid.Column="3" Classes="icon" Content="✕" ToolTip.Tip="Remove index" CommandParameter="{Binding}"
                            Command="{Binding $parent[UserControl].DataContext.RemoveIndexCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="compact" Content="＋ Add index" Command="{Binding AddIndexCommand}" HorizontalAlignment="Left" />
          </StackPanel>

          <!-- Script -->
          <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="Script" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Updated as you edit. Nothing runs until you press Execute (Apply changes for an open table), which shows this script and asks first." />
            <TextBox Classes="code" Text="{Binding Script}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="180" />
            <WrapPanel>
              <Button Classes="accent" Content="{Binding ExecuteLabel}" Command="{Binding ExecuteCommand}" Margin="0,0,8,0"
                      ToolTip.Tip="Show the script, confirm, then run it in one transaction" />
              <Button Content="Open in Query tab" Command="{Binding OpenInQueryTabCommand}" Margin="0,0,8,0"
                      ToolTip.Tip="Open the script in a new query tab to edit or run it there" />
              <Button Content="Copy script" Command="{Binding CopyScriptCommand}" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />

      <!-- Suggestions -->
      <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="6">
        <DockPanel Margin="8">
          <TextBlock DockPanel.Dock="Top" Text="Suggestions" FontWeight="SemiBold" FontSize="14" />
          <TextBlock DockPanel.Dock="Top" Classes="hint" TextWrapping="Wrap" Margin="0,2,0,6" Text="{Binding SuggestionSummary}" />
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Apply all" Command="{Binding ApplyAllSuggestionsCommand}" IsVisible="{Binding HasFixable}" Margin="0,0,6,4"
                    ToolTip.Tip="Apply every suggestion that has a fix, one after the other" />
            <Button Content="Show dismissed" Command="{Binding ShowDismissedCommand}" IsVisible="{Binding HasDismissed}" Margin="0,0,6,4" />
          </WrapPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Suggestions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DesignSuggestionItem">
                  <Border Padding="8" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                    <StackPanel Spacing="4">
                      <TextBlock TextWrapping="Wrap" FontWeight="SemiBold">
                        <Run Text="{Binding SeverityText}" Foreground="{Binding SeverityColor}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Title}" />
                      </TextBlock>
                      <TextBlock Classes="hint" Text="{Binding Detail}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                        <Button Classes="compact" Content="{Binding FixLabel}" IsVisible="{Binding CanFix}" CommandParameter="{Binding}"
                                Command="{Binding $parent[UserControl].DataContext.ApplySuggestionCommand}" />
                        <Button Classes="compact" Content="Dismiss" IsVisible="{Binding CanDismiss}" CommandParameter="{Binding}"
                                Command="{Binding $parent[UserControl].DataContext.DismissSuggestionCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
