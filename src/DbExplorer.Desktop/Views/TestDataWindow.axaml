<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbExplorer.Desktop.ViewModels"
        x:Class="DbExplorer.Desktop.Views.TestDataWindow"
        x:DataType="vm:TestDataViewModel"
        Title="{Binding Title}"
        Width="1180" Height="760" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.script">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource AppCodeBackgroundBrush}" />
    </Style>
    <Style Selector="TextBlock.head">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppHintForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.flag">
      <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="12">
    <!-- What and how many -->
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <Border Background="{DynamicResource AppDangerBrush}" CornerRadius="4" Padding="10,5" IsVisible="{Binding IsProduction}">
        <TextBlock Text="{Binding ProductionBanner}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
      </Border>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="hint" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Rows" VerticalAlignment="Center" />
            <NumericUpDown Width="150" Minimum="1" Maximum="{Binding MaxRows}" Increment="100" FormatString="N0"
                           Value="{Binding RowCount}" ToolTip.Tip="How many rows to generate (up to 100,000)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="NULLs %" VerticalAlignment="Center" />
            <NumericUpDown Width="120" Minimum="0" Maximum="100" Increment="5" FormatString="0"
                           Value="{Binding NullPercent}" ToolTip.Tip="How often a nullable column (not a key) is left NULL" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Seed" VerticalAlignment="Center" />
            <NumericUpDown Width="150" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0"
                           Value="{Binding Seed}" ToolTip.Tip="The same seed and choices give the same rows" />
          </StackPanel>
          <Button Content="Shuffle" Command="{Binding ShuffleCommand}" ToolTip.Tip="A new seed: different rows with the same choices" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <!-- Actions -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock Classes="hint" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel insert" Command="{Binding CancelInsertCommand}" IsVisible="{Binding IsInserting}"
                ToolTip.Tip="Stop and roll back: no rows are kept" />
        <Button Content="Open in Query tab" Command="{Binding OpenInQueryTabCommand}"
                ToolTip.Tip="The whole INSERT script in a new Query tab, to read or change before you run it. Nothing is inserted." />
        <Button Classes="accent" Content="{Binding InsertText}" Command="{Binding InsertCommand}" IsEnabled="{Binding !IsReadOnly}"
                ToolTip.Tip="Asks first, then inserts every row in one transaction" />
        <Button Content="Close" Click="OnClose" IsCancel="True" />
      </StackPanel>
    </Grid>

    <Grid RowDefinitions="*,6,Auto,Auto">
      <Grid ColumnDefinitions="3*,6,2*">
        <!-- Columns -->
        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="1.5*,1.3*,2.5*,2.5*" Margin="10,6">
              <TextBlock Classes="head" Text="Column" />
              <TextBlock Grid.Column="1" Classes="head" Text="Type" />
              <TextBlock Grid.Column="2" Classes="head" Text="Filled with" />
              <TextBlock Grid.Column="3" Classes="head" Text="Sample" Margin="10,0,0,0" />
            </Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TestColumnRow">
                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
                      <Grid ColumnDefinitions="1.5*,1.3*,2.5*,2.5*" RowDefinitions="Auto,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                          <TextBlock Classes="mono" Text="{Binding Type}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="hint" FontSize="11" Text="{Binding Flags}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                          <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" HorizontalAlignment="Stretch" />
                          <TextBox Text="{Binding FixedValue}" Watermark="Value for every row" IsVisible="{Binding IsFixed}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Sample}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Sample}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="hint" FontSize="11" Margin="2,3,0,0"
                                   Text="{Binding Note}" TextWrapping="Wrap"
                                   IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

        <!-- Preview -->
        <DockPanel Grid.Column="2">
          <TextBlock DockPanel.Dock="Top" Classes="head" Text="Preview: the first rows as they will be inserted" Margin="2,0,0,6" />
          <TextBox Classes="script" Text="{Binding Preview}" IsReadOnly="True" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="NoWrap"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </DockPanel>
      </Grid>

      <Border Grid.Row="2" BorderBrush="{DynamicResource AppPlanWarningBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6"
              IsVisible="{Binding Warnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <ScrollViewer MaxHeight="90">
          <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
